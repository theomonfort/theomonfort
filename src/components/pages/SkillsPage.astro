---
import { getCollection } from 'astro:content';
import Layout from '../layout/Layout.astro';
import SkillGallery, { type SkillEntry } from '../interactive/SkillGallery.tsx';
import McpGallery, { type McpEntry } from '../interactive/McpGallery.tsx';
import { localizedPath, siteCopy, type Locale } from '../../lib/i18n';

interface Props {
  locale?: Locale;
}
const { locale = 'ja' } = Astro.props;
const t = siteCopy[locale];

const all = (await getCollection('equipment'))
  .sort((a, b) => a.data.order - b.data.order);

const pickDesc = (e: (typeof all)[number]) =>
  locale === 'en' ? (e.data.descriptionEn || e.data.description) : e.data.description;

const bySection = (id: string) => all.filter((e) => e.data.section === id);

const skillEntries: SkillEntry[] = bySection('skills').map((e) => ({
  slug: e.id.split('--')[1] ?? e.id,
  name: e.data.name,
  icon: e.data.icon,
  group: e.data.group,
  description: pickDesc(e),
  url: e.data.url ?? '',
}));

const mcpEntries: McpEntry[] = bySection('mcp-servers')
  .filter((e) => Boolean(e.data.install))
  .map((e) => ({
    slug: e.id.split('--')[1] ?? e.id,
    name: e.data.name,
    icon: e.data.icon,
    description: pickDesc(e),
    install: e.data.install!,
    url: e.data.url,
  }));
---

<Layout locale={locale} currentPath="/skills" title={t.skills.title}>
  <section class="max-w-5xl mx-auto px-4 py-12">
    <header class="skills-hero mb-10 p-6 md:p-8 rounded-[var(--radius-card)] border border-neon-cyan/20 bg-deep-purple/85 backdrop-blur-md">
      <div class="skills-eyebrow inline-flex items-center gap-2 px-2.5 py-1 mb-4 rounded-[var(--radius-ui)] border border-neon-cyan/30 bg-neon-cyan/10 font-mono text-[11px] font-semibold tracking-[0.14em] uppercase text-neon-cyan">
        <span class="h-1.5 w-1.5 rounded-full bg-gb-green"></span>
        <span>EQUIPMENT // LOADOUT</span>
      </div>
      <h1 class="font-display text-2xl md:text-4xl font-bold tracking-wide text-phosphor mb-2.5">{t.skills.heading}</h1>
      <p class="skills-subtitle font-body text-base md:text-lg font-medium text-neon-cyan">{t.skills.subtitle}</p>
      <p class="skills-intro font-body text-sm md:text-[15px] text-phosphor-body leading-relaxed mt-3 max-w-2xl">
        {t.skills.intro}
      </p>
      <nav class="mt-6 pt-4 border-t border-neon-cyan/15 flex flex-wrap items-center gap-2.5" aria-label="Equipment categories">
        <a
          href="#skills"
          class="skills-jump-link inline-flex items-center gap-2 px-3 py-1.5 rounded-[var(--radius-ui)] border border-neon-cyan/30 bg-shadow-ink/80 font-mono text-xs font-semibold text-neon-cyan hover:border-neon-cyan hover:bg-neon-cyan/10 transition-colors"
        >
          <span>⚡ {t.skills.sections.skills.heading}</span>
          <span class="px-1.5 py-0.5 rounded-[var(--radius-ui)] bg-neon-cyan/15 text-[10px]">{skillEntries.length}</span>
        </a>
        <a
          href="#mcp"
          class="skills-jump-link inline-flex items-center gap-2 px-3 py-1.5 rounded-[var(--radius-ui)] border border-gb-green/30 bg-shadow-ink/80 font-mono text-xs font-semibold text-gb-green hover:border-gb-green hover:bg-gb-green/10 transition-colors"
        >
          <span>🔌 {t.skills.sections.mcp.heading}</span>
          <span class="px-1.5 py-0.5 rounded-[var(--radius-ui)] bg-gb-green/15 text-[10px]">{mcpEntries.length}</span>
        </a>
      </nav>
    </header>

    <section id="skills" class="scroll-mt-32 mb-16">
      <div class="skills-sec-head flex items-center gap-3 mb-4 pb-3 border-b border-neon-cyan/25">
        <h2 class="font-display text-xl md:text-2xl font-bold tracking-wide text-neon-cyan">{t.skills.sections.skills.heading}</h2>
        <span class="skills-count-badge font-mono text-[11px] font-semibold px-2.5 py-0.5 rounded-[var(--radius-ui)] border border-neon-cyan/25 bg-neon-cyan/10 text-neon-cyan ml-auto">
          {skillEntries.length}{t.skills.sections.skills.count}
        </span>
      </div>
      <p class="skills-sec-body font-body text-sm md:text-[15px] text-phosphor-body leading-relaxed mb-6">
        {t.skills.sections.skills.body}
      </p>
      <SkillGallery client:load skills={skillEntries} copy={t.skillGallery} locale={locale} />
    </section>

    <section id="mcp" class="scroll-mt-32 mb-16">
      <div class="skills-sec-head flex items-center gap-3 mb-4 pb-3 border-b border-gb-green/25">
        <h2 class="font-display text-xl md:text-2xl font-bold tracking-wide text-gb-green">{t.skills.sections.mcp.heading}</h2>
        <span class="skills-count-badge font-mono text-[11px] font-semibold px-2.5 py-0.5 rounded-[var(--radius-ui)] border border-gb-green/25 bg-gb-green/10 text-gb-green ml-auto">
          {mcpEntries.length}{t.skills.sections.mcp.count}
        </span>
      </div>
      <p class="skills-sec-body font-body text-sm md:text-[15px] text-phosphor-body leading-relaxed mb-6">{t.skills.sections.mcp.body}</p>
      <McpGallery client:load servers={mcpEntries} copy={t.mcpGallery} locale={locale} />
    </section>

    <div class="mt-16 text-center">
      <a
        href={localizedPath(locale, '/')}
        class="skills-back-link inline-block px-4 py-2 rounded-[var(--radius-ui)] border border-neon-cyan/20 bg-deep-purple/85 font-mono text-xs text-phosphor-muted hover:text-neon-cyan hover:border-neon-cyan/45 transition-colors"
      >
        {t.common.backHome}
      </a>
    </div>
  </section>
</Layout>

<style>
  .skills-hero {
    background-image: linear-gradient(
      90deg,
      var(--c-neon-cyan) 0%,
      color-mix(in srgb, var(--c-neon-cyan) 30%, transparent) 55%,
      transparent 100%
    );
    background-size: 100% 2px;
    background-position: top left;
    background-repeat: no-repeat;
    box-shadow: 0 12px 32px rgb(var(--rgb-shadow-ink) / 0.42);
  }

  :global(html[data-theme='retro']) .skills-hero {
    background-image: none;
    background-color: rgb(var(--rgb-shadow-ink) / 0.85);
    border: 2px solid var(--c-neon-cyan);
    border-radius: 0;
    backdrop-filter: none;
    box-shadow: 4px 4px 0 var(--c-shadow-ink), var(--shadow-neon-cyan);
  }
  :global(html[data-theme='retro']) .skills-eyebrow {
    font-family: 'Press Start 2P', monospace;
    font-size: 9px;
    border-width: 2px;
    border-radius: 0;
  }
  :global(html[data-theme='retro']) .skills-hero h1 {
    font-family: 'Press Start 2P', monospace;
    color: var(--c-neon-magenta);
  }
  :global(html[data-theme='retro']) .skills-subtitle,
  :global(html[data-theme='retro']) .skills-intro,
  :global(html[data-theme='retro']) .skills-sec-body {
    font-family: 'DotGothic16', sans-serif;
  }
  :global(html[data-theme='retro']) .skills-sec-head {
    border-bottom-width: 2px;
    border-bottom-color: currentColor;
  }
  :global(html[data-theme='retro']) .skills-sec-head h2 {
    font-family: 'DotGothic16', sans-serif;
  }
  :global(html[data-theme='retro']) .skills-jump-link,
  :global(html[data-theme='retro']) .skills-count-badge,
  :global(html[data-theme='retro']) .skills-back-link {
    font-family: 'DotGothic16', monospace;
    border-width: 2px;
    border-radius: 0;
    box-shadow: 4px 4px 0 var(--c-shadow-ink);
  }
  :global(html[data-theme='retro']) .skills-back-link {
    font-family: 'Press Start 2P', monospace;
    font-size: 10px;
  }
</style>
