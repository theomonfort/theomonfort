---
import { getCollection, render } from 'astro:content';
import Layout from '../layout/Layout.astro';
import { type Locale } from '../../lib/i18n';

interface Props {
  locale?: Locale;
}
const { locale = 'ja' } = Astro.props;
const copy = locale === 'ja'
  ? {
      title: 'Changelog | AI 駆動開発 QUEST',
      description: '気になった GitHub の更新をピックアップ。押さえておきたいポイントと、現場で役立つ補足を日本語で。',
      eyebrow: '気になる更新、覚えておきたいこと。',
      order: '新しい順',
      count: '件のピックアップ',
      allCategories: 'すべて',
      filterByCategory: 'カテゴリで絞り込む',
      source: '公式の更新情報を読む',
      demo: 'デモで試すこと',
      openDemo: 'デモを開く',
      select: '発表用',
      selected: '件を発表用に選択',
      selectedOnly: '選択した項目のみ',
      emptySelection: '発表用の項目が未選択です。フィルターをオフにして、紹介したい更新にチェックを入れてください。',
      storageError: '選択をブラウザーに保存できないか、保存済みの選択を読み込めません。再読み込みすると選択が失われる場合があります。',
      enlargeImage: '画像を拡大',
      imageViewer: '拡大画像',
      closeImage: '閉じる',
      categories: { review: 'コードレビュー', security: 'セキュリティ', copilot: 'Copilot', actions: 'Actions', administration: '管理', issues: 'Issues' },
    }
  : {
      title: 'Changelog | AI-Driven Development Quest',
      description: 'A handpicked shortlist of GitHub updates, with key takeaways and practical context.',
      eyebrow: 'Not every update. Just the ones worth remembering.',
      order: 'Newest first',
      count: 'curated updates',
      allCategories: 'All',
      filterByCategory: 'Filter by category',
      source: 'Read the official announcement',
      demo: 'Things to try in a demo',
      openDemo: 'Open demo',
      select: 'Present',
      selected: 'selected for presentation',
      selectedOnly: 'Selected only',
      emptySelection: 'No updates selected. Turn off the filter and check the updates you want to present.',
      storageError: 'Your selection could not be saved to or loaded from this browser. It may be lost when you reload the page.',
      enlargeImage: 'Enlarge image',
      imageViewer: 'Enlarged image',
      closeImage: 'Close',
      categories: { review: 'Code review', security: 'Security', copilot: 'Copilot', actions: 'Actions', administration: 'Administration', issues: 'Issues' },
    };

const entries = (await getCollection('changelog', ({ id }) => id.startsWith(`${locale}/`)))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime() || a.id.localeCompare(b.id));
const updates = await Promise.all(entries.map(async (entry) => ({
  ...entry,
  slug: entry.id.slice(locale.length + 1),
  Content: (await render(entry)).Content,
})));

type CategoryKey = keyof typeof copy.categories;
const categoryOrder = Object.keys(copy.categories) as CategoryKey[];
const categoryCounts = updates.reduce<Record<string, number>>((acc, u) => {
  acc[u.data.category] = (acc[u.data.category] ?? 0) + 1;
  return acc;
}, {});
const availableCategories = categoryOrder.filter((cat) => (categoryCounts[cat] ?? 0) > 0);
---

<Layout locale={locale} currentPath="/changelog" title={copy.title} description={copy.description}>
  <div class="changelog max-w-5xl mx-auto px-4 md:px-8 pt-12 md:pt-16 pb-16 font-body">
    <header class="changelog-header">
      <div class="changelog-eyebrow-row">
        <span class="telemetry-pill">
          <span class="telemetry-dot" aria-hidden="true"></span>
          <span>TELEMETRY // CHANGELOG</span>
        </span>
        <p class="eyebrow-copy">{copy.eyebrow}</p>
      </div>
      <h1 class="changelog-title font-display">CHANGELOG</h1>
      <p class="intro">{copy.description}</p>

      <div class="hud-control-deck">
        <div class="index-line">
          <span class="index-stat">
            <strong>{String(entries.length).padStart(2, '0')}</strong> {copy.count}
          </span>
          <span class="index-order">↓ {copy.order}</span>
        </div>

        <div class="category-filters" role="group" aria-label={copy.filterByCategory}>
          <button
            type="button"
            class="category-chip is-active"
            data-category-chip="all"
            aria-pressed="true"
          >
            <span>{copy.allCategories}</span>
            <span class="chip-count">{entries.length}</span>
          </button>
          {availableCategories.map((cat) => (
            <button
              type="button"
              class:list={['category-chip', `cat-${cat}`]}
              data-category-chip={cat}
              aria-pressed="false"
            >
              <span>{copy.categories[cat]}</span>
              <span class="chip-count">{categoryCounts[cat]}</span>
            </button>
          ))}
        </div>

        <div class="selection-toolbar" hidden>
          <p class="selection-count" role="status">
            <span data-selection-count>0</span> / {entries.length} {copy.selected}
          </p>
          <button type="button" class="selection-filter" aria-pressed="false" aria-controls="changelog-updates">
            {copy.selectedOnly}
          </button>
        </div>
      </div>

      <p class="selection-error" role="status" hidden>{copy.storageError}</p>
    </header>

    <p class="selection-empty" role="status" hidden>{copy.emptySelection}</p>
    <ol class="update-list" id="changelog-updates">
      {updates.map(({ data, slug, Content }) => {
        const date = data.date.toISOString().slice(0, 10);
        return (
          <li
            class:list={['update', { universe: data.event === 'universe-2026' }]}
            id={slug}
            data-category={data.category}
          >
            <div class="date-rail">
              <time datetime={date}>
                <span class="year">{date.slice(0, 4)}</span>
                <span class="day">{date.slice(5).replace('-', '.')}</span>
              </time>
              <label class="entry-selection" hidden>
                <input type="checkbox" value={slug} aria-labelledby={`${slug}-select-label ${slug}-title`} />
                <span id={`${slug}-select-label`}>{copy.select}</span>
              </label>
            </div>
            <article class:list={['entry', data.category]} aria-labelledby={`${slug}-title`}>
              <details class="entry-disclosure">
                <summary class="entry-toggle">
                  <h2>
                    <span class="entry-meta">
                      {data.event === 'universe-2026' && (
                        <span class="event-badge"><span aria-hidden="true">✦</span> UNIVERSE 2026</span>
                      )}
                      <span class="category">{copy.categories[data.category]}</span>
                      {data.status && <span class="status">{data.status}</span>}
                    </span>
                    <span class="entry-title" id={`${slug}-title`}>{data.title}</span>
                    <span class="toggle-marker" aria-hidden="true"></span>
                  </h2>
                </summary>
                <div class="entry-content">
                  <p class="summary">{data.summary}</p>
                  <div class="entry-body"><Content /></div>
                  {(data.demo.length > 0 || data.demoUrl || data.demoLinks.length > 0) && (
                    <details class="demo">
                      <summary>
                        <span class="demo-summary-label">▶ {copy.demo}</span>
                      </summary>
                      <div class="demo-body">
                        {(data.demoUrl || data.demoLinks.length > 0) && (
                          <div class="demo-actions">
                            {data.demoUrl && (
                              <a class="demo-cta" href={data.demoUrl} target="_blank" rel="noopener noreferrer">
                                {copy.openDemo} <span aria-hidden="true">↗</span>
                              </a>
                            )}
                            {data.demoLinks.map((link) => (
                              <a class="demo-link-pill" href={link.url} target="_blank" rel="noopener noreferrer">
                                {link.label} <span aria-hidden="true">↗</span>
                              </a>
                            ))}
                          </div>
                        )}
                        {data.demo.length > 0 && <ol>{data.demo.map((step) => <li>{step}</li>)}</ol>}
                      </div>
                    </details>
                  )}
                  <a class="source" href={data.source} target="_blank" rel="noopener noreferrer">
                    {copy.source} <span aria-hidden="true">↗</span>
                  </a>
                </div>
              </details>
            </article>
          </li>
        );
      })}
    </ol>
    <dialog class="image-viewer" aria-label={copy.imageViewer} data-enlarge-label={copy.enlargeImage}>
      <button type="button" class="image-viewer-close" aria-label={copy.closeImage}>×</button>
      <img alt="" />
    </dialog>
  </div>
</Layout>

<script>
  const SELECTION_KEY = 'akq:changelog:selection:v1';
  let selected = new Set<string>();
  let selectedOnly = false;
  let selectionEvents: AbortController | undefined;

  function initChangelogSelection() {
    selectionEvents?.abort();
    const root = document.querySelector<HTMLElement>('.changelog');
    if (!root) return;

    const toolbar = root.querySelector<HTMLElement>('.selection-toolbar');
    const filter = root.querySelector<HTMLButtonElement>('.selection-filter');
    const count = root.querySelector<HTMLElement>('[data-selection-count]');
    const empty = root.querySelector<HTMLElement>('.selection-empty');
    const storageError = root.querySelector<HTMLElement>('.selection-error');
    if (!toolbar || !filter || !count || !empty || !storageError) {
      throw new Error('Changelog selection controls are missing.');
    }

    const items = Array.from(root.querySelectorAll<HTMLElement>('.update')).map((row) => {
      const checkbox = row.querySelector<HTMLInputElement>('.entry-selection input');
      if (!checkbox) throw new Error(`Changelog selection checkbox is missing: ${row.id}`);
      return { row, checkbox };
    });
    const categoryChips = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-category-chip]'));
    let activeCategory = 'all';

    const syncCategoryChips = () => {
      categoryChips.forEach((chip) => {
        const isActive = (chip.dataset.categoryChip ?? 'all') === activeCategory;
        chip.classList.toggle('is-active', isActive);
        chip.setAttribute('aria-pressed', String(isActive));
      });
    };

    const reportStorageError = (error: unknown) => {
      console.warn('Changelog selection storage failed.', error);
      storageError.hidden = false;
    };

    try {
      const stored = localStorage.getItem(SELECTION_KEY);
      if (stored === null) {
        selected = new Set();
        selectedOnly = false;
      } else {
        const state: unknown = JSON.parse(stored);
        if (
          typeof state !== 'object' || state === null ||
          !('selected' in state) || !Array.isArray(state.selected) ||
          !state.selected.every((slug: unknown): slug is string => typeof slug === 'string') ||
          !('selectedOnly' in state) || typeof state.selectedOnly !== 'boolean'
        ) {
          throw new Error('Invalid saved changelog selection.');
        }
        selected = new Set(state.selected);
        selectedOnly = state.selectedOnly;
      }
      storageError.hidden = true;
    } catch (error) {
      reportStorageError(error);
    }

    const save = () => {
      try {
        localStorage.setItem(SELECTION_KEY, JSON.stringify({ selected: [...selected], selectedOnly }));
        storageError.hidden = true;
      } catch (error) {
        reportStorageError(error);
      }
    };

    if (selected.delete('2026-09-10-pull-requests-page')) {
      selected.add('2026-09-21-pull-requests-page');
      save();
    }

    const refresh = () => {
      let total = 0;
      let visible = 0;
      items.forEach(({ row, checkbox }) => {
        checkbox.checked = selected.has(checkbox.value);
        if (checkbox.checked) total++;
        const matchesSelection = !selectedOnly || checkbox.checked;
        const matchesCategory = activeCategory === 'all' || row.dataset.category === activeCategory;
        row.hidden = !(matchesSelection && matchesCategory);
        if (!row.hidden) visible++;
      });
      count.textContent = String(total);
      filter.setAttribute('aria-pressed', String(selectedOnly));
      empty.hidden = !selectedOnly || visible > 0;
    };

    const revealLinkedEntry = () => {
      const linked = items.find(({ row }) => `#${row.id}` === location.hash);
      if (linked) {
        if (selectedOnly && !selected.has(linked.checkbox.value)) {
          selectedOnly = false;
          save();
        }
        if (activeCategory !== 'all' && linked.row.dataset.category !== activeCategory) {
          activeCategory = 'all';
          syncCategoryChips();
        }
      }
      refresh();
    };

    selectionEvents = new AbortController();
    const { signal } = selectionEvents;
    items.forEach(({ row, checkbox }) => {
      checkbox.addEventListener('change', () => {
        if (checkbox.checked) selected.add(checkbox.value);
        else selected.delete(checkbox.value);
        save();
        refresh();
        if (row.hidden) filter.focus();
      }, { signal });
    });
    categoryChips.forEach((chip) => {
      chip.addEventListener('click', () => {
        activeCategory = chip.dataset.categoryChip ?? 'all';
        syncCategoryChips();
        refresh();
      }, { signal });
    });
    filter.addEventListener('click', () => {
      selectedOnly = !selectedOnly;
      save();
      refresh();
    }, { signal });
    window.addEventListener('hashchange', revealLinkedEntry, { signal });

    revealLinkedEntry();
    toolbar.hidden = false;
    root.querySelectorAll<HTMLElement>('.entry-selection').forEach((label) => { label.hidden = false; });
  }

  initChangelogSelection();
  document.addEventListener('astro:page-load', initChangelogSelection);

  let imageViewerEvents: AbortController | undefined;

  function initImageViewer() {
    imageViewerEvents?.abort();
    const viewer = document.querySelector<HTMLDialogElement>('.changelog .image-viewer');
    const viewerImage = viewer?.querySelector('img');
    if (!viewer || !viewerImage) return;

    imageViewerEvents = new AbortController();
    const { signal } = imageViewerEvents;
    const enlargeLabel = viewer.dataset.enlargeLabel ?? '';

    document.querySelectorAll<HTMLImageElement>('.changelog .entry-body img').forEach((image) => {
      const parentLink = image.closest('a');
      if (parentLink && !parentLink.classList.contains('image-zoom')) return;

      let link = parentLink;
      if (!link) {
        link = document.createElement('a');
        link.className = 'image-zoom';
        link.href = image.src;
        link.setAttribute('aria-label', image.alt ? `${enlargeLabel}: ${image.alt}` : enlargeLabel);
        image.replaceWith(link);
        link.append(image);
      }

      link.addEventListener('click', (event) => {
        // Keep modifier-clicks as a regular "open image in new tab".
        if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
        event.preventDefault();
        viewerImage.src = image.currentSrc || image.src;
        viewerImage.alt = image.alt;
        viewer.showModal();
      }, { signal });
    });

    viewer.addEventListener('click', () => viewer.close(), { signal });
  }

  initImageViewer();
  document.addEventListener('astro:page-load', initImageViewer);
</script>

<style>
  .changelog { letter-spacing: 0.01em; color: var(--c-fg-body); }
  .changelog [hidden] { display: none; }
  .changelog-header { margin-bottom: 2.5rem; }
  .changelog-eyebrow-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 1rem;
  }
  .telemetry-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.25rem 0.65rem;
    border-radius: var(--radius-ui);
    border: 1px solid rgb(var(--rgb-neon-cyan) / 0.28);
    background: rgb(var(--rgb-neon-cyan) / 0.10);
    color: var(--c-neon-cyan);
    font-family: var(--font-mono-hud);
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
  .telemetry-dot {
    width: 6px;
    height: 6px;
    border-radius: 999px;
    background: var(--c-gb-green);
    box-shadow: 0 0 8px rgb(var(--rgb-gb-green) / 0.65);
  }
  .eyebrow-copy {
    margin: 0;
    color: var(--c-crt-amber);
    font-size: 0.875rem;
    font-weight: 500;
  }
  .changelog-title {
    margin: 0;
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    font-weight: 700;
    letter-spacing: 0.06em;
    color: var(--c-phosphor);
  }
  .intro {
    max-width: 44rem;
    margin-top: 0.9rem;
    line-height: 1.85;
    color: var(--c-fg-body);
    font-size: 0.95rem;
  }

  .hud-control-deck {
    margin-top: 1.75rem;
    padding: 1rem 1.25rem;
    border-radius: var(--radius-card);
    border: 1px solid rgb(var(--rgb-neon-cyan) / 0.18);
    background-color: var(--c-bg-elevated);
    background-image: linear-gradient(
      90deg,
      var(--c-neon-cyan) 0%,
      color-mix(in srgb, var(--c-neon-cyan) 30%, transparent) 55%,
      transparent 100%
    );
    background-size: 100% 2px;
    background-position: top left;
    background-repeat: no-repeat;
    backdrop-filter: blur(10px);
    box-shadow: 0 10px 28px rgb(var(--rgb-shadow-ink) / 0.36);
  }
  .index-line {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    padding-bottom: 0.85rem;
    border-bottom: 1px solid rgb(var(--rgb-neon-cyan) / 0.14);
    color: var(--c-fg-muted);
    font-family: var(--font-mono-hud);
    font-size: 0.78rem;
  }
  .index-stat strong {
    color: var(--c-neon-cyan);
    font-weight: 700;
  }
  .index-order {
    color: var(--c-neon-cyan);
  }

  .category-filters {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.45rem;
    padding-top: 0.85rem;
  }
  .category-chip {
    --chip-accent: var(--c-neon-cyan);
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.35rem 0.65rem;
    border-radius: var(--radius-ui);
    border: 1px solid rgb(var(--rgb-neon-cyan) / 0.18);
    background: var(--c-shadow-ink);
    color: var(--c-fg-body);
    font-family: var(--font-mono-hud);
    font-size: 0.74rem;
    font-weight: 500;
    cursor: pointer;
    transition: border-color 0.15s ease, background-color 0.15s ease, color 0.15s ease;
  }
  .category-chip.cat-security { --chip-accent: var(--c-neon-cyan); }
  .category-chip.cat-copilot { --chip-accent: var(--c-neon-magenta); }
  .category-chip.cat-actions { --chip-accent: var(--c-gb-green); }
  .category-chip.cat-review,
  .category-chip.cat-administration,
  .category-chip.cat-issues { --chip-accent: var(--c-crt-amber); }
  .category-chip:hover {
    border-color: color-mix(in srgb, var(--chip-accent) 55%, rgb(var(--rgb-neon-cyan) / 0.2));
    color: var(--c-phosphor);
  }
  .category-chip .chip-count {
    font-size: 0.66rem;
    opacity: 0.75;
  }
  .category-chip.is-active {
    background: var(--chip-accent);
    border-color: var(--chip-accent);
    color: var(--c-shadow-ink);
    font-weight: 600;
  }
  .category-chip.is-active .chip-count {
    opacity: 0.9;
  }

  .selection-toolbar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem 1.5rem;
    margin-top: 0.85rem;
    padding-top: 0.85rem;
    border-top: 1px solid rgb(var(--rgb-neon-cyan) / 0.14);
    font-family: var(--font-mono-hud);
    font-size: 0.8rem;
  }
  .selection-count { margin: 0; color: var(--c-fg-body); }
  .selection-count [data-selection-count] { color: var(--c-neon-cyan); font-weight: 700; }
  .selection-filter {
    min-height: 36px;
    padding: 0.4rem 0.85rem;
    border-radius: var(--radius-ui);
    border: 1px solid var(--c-border-strong);
    color: var(--c-neon-cyan);
    background: var(--c-shadow-ink);
    font-family: var(--font-mono-hud);
    font-size: 0.76rem;
    font-weight: 600;
    cursor: pointer;
    transition: background-color 0.15s ease, border-color 0.15s ease, color 0.15s ease;
  }
  .selection-filter:hover {
    border-color: var(--c-neon-cyan);
    background: rgb(var(--rgb-neon-cyan) / 0.10);
  }
  .selection-filter[aria-pressed="true"] {
    background: var(--c-neon-cyan);
    color: var(--c-shadow-ink);
    border-color: var(--c-neon-cyan);
    font-weight: 600;
  }
  .selection-error {
    margin-top: 1rem;
    padding: 0.65rem 0.9rem;
    border-radius: var(--radius-card);
    border: 1px solid rgb(var(--rgb-crt-amber) / 0.35);
    background: rgb(var(--rgb-crt-amber) / 0.08);
    color: var(--c-crt-amber);
    font-size: 0.85rem;
  }
  .selection-empty {
    padding: 1.35rem 1.5rem;
    border-radius: var(--radius-card);
    border: 1px solid rgb(var(--rgb-neon-cyan) / 0.22);
    background: var(--c-bg-elevated);
    color: var(--c-fg-body);
    line-height: 1.85;
  }

  .update-list { list-style: none; padding: 0; margin: 0; }
  .update { display: grid; grid-template-columns: 6.5rem minmax(0, 1fr); scroll-margin-top: 9rem; }
  .date-rail {
    border-right: 1px solid rgb(var(--rgb-neon-cyan) / 0.20);
    padding-top: 1.5rem;
    padding-right: 0.75rem;
    position: relative;
  }
  .date-rail::after {
    content: '';
    position: absolute;
    top: 1.9rem;
    right: -4.5px;
    width: 8px;
    height: 8px;
    border-radius: var(--radius-ui);
    background: var(--c-neon-cyan);
    box-shadow: 0 0 10px rgb(var(--rgb-neon-cyan) / 0.6);
  }
  time {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    font-family: var(--font-mono-hud);
    font-variant-numeric: tabular-nums;
  }
  .year { font-size: 0.72rem; color: var(--c-fg-muted); letter-spacing: 0.06em; }
  .day { font-size: 1.2rem; font-weight: 700; color: var(--c-neon-cyan); line-height: 1.15; letter-spacing: 0.02em; }
  .entry-selection {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    min-height: 36px;
    width: fit-content;
    margin-top: 0.5rem;
    cursor: pointer;
    font-family: var(--font-mono-hud);
    font-size: 0.7rem;
    color: var(--c-fg-muted);
    transition: color 0.15s ease;
  }
  .entry-selection:hover { color: var(--c-phosphor); }
  .entry-selection input {
    width: 0.95rem;
    height: 0.95rem;
    flex: none;
    accent-color: var(--c-neon-cyan);
    color-scheme: dark;
    cursor: pointer;
  }
  .entry-selection:has(input:checked) { color: var(--c-neon-cyan); font-weight: 600; }

  .entry {
    --entry-accent: var(--c-crt-amber);
    min-width: 0;
    margin: 0 0 1.5rem 1.75rem;
    padding: 1.5rem 1.75rem;
    border-radius: var(--radius-card);
    background-color: var(--c-bg-elevated);
    background-image: linear-gradient(
      90deg,
      var(--entry-accent) 0%,
      color-mix(in srgb, var(--entry-accent) 30%, transparent) 55%,
