---
import Layout from '../layout/Layout.astro';
import PixelRoom from '../room/PixelRoom.astro';
import MenuArrow from '../retro/MenuArrow.astro';
import { siteCopy, type Locale } from '../../lib/i18n';

interface Props {
  locale?: Locale;
}
const { locale = 'ja' } = Astro.props;
const t = siteCopy[locale];
---

<Layout locale={locale} currentPath="/" title={t.home.title}>
  <section class="hero-room relative min-h-[calc(100vh-72px)] overflow-hidden">
    <div class="absolute inset-0 flex items-center justify-center">
      <PixelRoom immersive={true} locale={locale} src="/theomonfort/room/equipment-room.png" />
    </div>

    <div class="relative z-10 flex flex-col items-center justify-between min-h-[calc(100vh-72px)] pt-3 md:pt-5 pb-8 md:pb-12 px-4 pointer-events-none">
      <div class="text-center max-w-2xl">
        <p class="inline-flex items-center gap-2 px-2.5 py-1 rounded-[3px] border border-crt-amber/30 bg-shadow-ink/80 backdrop-blur-sm font-mono text-[11px] font-semibold text-crt-amber mb-2.5 tracking-[0.22em] uppercase shadow-[0_4px_16px_rgba(4,8,14,0.45)]">{t.home.insertCoin}</p>
        <h1 class="font-display font-bold text-3xl md:text-5xl text-phosphor tracking-[0.06em] drop-shadow-[0_2px_18px_rgba(94,234,212,0.25)] leading-tight flex items-center justify-center gap-2.5 md:gap-4 flex-wrap">
          <span class="text-neon-cyan">AI</span>
          <span class="font-body font-bold text-[0.94em] tracking-tight leading-none">{t.brandMiddle}</span>
          <span class="text-neon-cyan">QUEST</span>
        </h1>
        <p class="font-mono text-xs md:text-sm font-medium tracking-[0.12em] text-phosphor-body mt-2 drop-shadow-[0_2px_8px_rgba(4,8,14,0.9)]">{t.home.subtitle}</p>
      </div>

      <div class="hero-hud-hint text-center px-5 py-3 rounded-[3px] max-w-xl mx-auto">
        <p class="font-body text-sm md:text-base text-phosphor-body leading-relaxed">
          <span class="inline-flex items-center justify-center gap-2 font-mono text-xs md:text-sm font-semibold tracking-[0.04em] text-crt-amber">
            <MenuArrow color="text-crt-amber" /> <span>{t.home.hint[0]}</span>
          </span><br />
          <span class="text-xs md:text-sm text-phosphor-body">{t.home.hint[1]}</span>
        </p>
      </div>
    </div>
  </section>
</Layout>

<style>
  .hero-room::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    background:
      radial-gradient(ellipse at 50% 50%,
        transparent 0%,
        transparent 55%,
        rgba(6, 11, 18, 0.48) 90%,
        rgba(6, 11, 18, 0.88) 100%),
      linear-gradient(to bottom,
        rgba(6, 11, 18, 0.58) 0%,
        transparent 18%,
        transparent 82%,
        rgba(6, 11, 18, 0.62) 100%);
  }

  .hero-hud-hint {
    background-color: rgba(9, 18, 28, 0.86);
    background-image: linear-gradient(
      90deg,
      #5eead4 0%,
      rgba(94, 234, 212, 0.30) 55%,
      transparent 100%
    );
    background-size: 100% 2px;
    background-position: top left;
    background-repeat: no-repeat;
    border: 1px solid rgba(94, 234, 212, 0.24);
    backdrop-filter: blur(10px);
    box-shadow: 0 8px 24px rgba(4, 8, 14, 0.5);
  }
</style>
