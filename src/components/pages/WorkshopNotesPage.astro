---
import Layout from '../layout/Layout.astro';
import { type Locale } from '../../lib/i18n';

interface Props {
  locale?: Locale;
}
const { locale = 'ja' } = Astro.props;

const objectivesText =
  locale === 'en'
    ? 'Give participants a feel for AI-driven development across the full SDLC, and the various tools available to do it. By the end of the workshop, participants will have a clearer idea of the tools available to code with Copilot and can start applying them to their own work.'
    : 'このワークショップの狙いは、計画 → 実装 → レビュー → テスト・セキュリティ → 運用という SDLC 全体を通して、AI 駆動開発の感覚と、それを支えるさまざまなツールを体験してもらうこと。終わったあとには、Copilot でコーディングするために使えるツールの全体像がつかめ、自分の仕事に取り入れ始められる状態を目指す。';

const ucIcon = '/theomonfort/icons/under-construction.png';
const timeText = locale === 'en' ? '~3 hours' : '約3時間';
const ucTitle = locale === 'en' ? 'UNDER CONSTRUCTION' : '準備中';
const ucBody =
  locale === 'en'
    ? 'This workshop is coming soon.'
    : 'このワークショップは現在準備中です。';

type SectionColor = 'magenta' | 'cyan' | 'amber' | 'green';

interface TeamsLink {
  label: string;
  url: string;
}
interface Item {
  label: string;
  checklistIndex?: number;
  checklistKey?: string;
  teams?: TeamsLink[];
}
interface Section {
  title: string;
  subtitle?: string;
  color: SectionColor;
  duration?: string;
  items: Item[];
}

// Section colors mirror the playbook category logic:
// cyan = Introduction / Test & Secure, green = Plan / Operate,
// magenta = Develop (Code), amber = Review (and the yellow bookends).
const COLORS: Record<SectionColor, { text: string; accent: string; cssVar: string }> = {
  magenta: { text: 'text-neon-magenta', accent: 'accent-neon-magenta', cssVar: 'var(--c-neon-magenta)' },
  cyan: { text: 'text-neon-cyan', accent: 'accent-neon-cyan', cssVar: 'var(--c-neon-cyan)' },
  amber: { text: 'text-crt-amber', accent: 'accent-crt-amber', cssVar: 'var(--c-crt-amber)' },
  green: { text: 'text-gb-green', accent: 'accent-gb-green', cssVar: 'var(--c-gb-green)' },
};

const sections: Section[] = [
  {
    title: 'PREPARATION',
    subtitle: '登壇準備',
    color: 'amber',
    items: [
      { label: 'Duplicate the workshop repo in your Organization (main only; leave ‘Include all branches’ unchecked).' },
      { label: 'START THE CODESPACE in advance and ZOOM IN' },
      { label: 'Send a message in Copilot Chat to be able to choose a model' },
      { label: 'Open a new terminal in CODESPACES' },
      { label: 'Check that Code scanning, Secret Scanning, Code Review ruleset are activated' },
      { label: 'Activate Code Quality, Dependabot Security Update' },
      { label: 'Have the AGENDA (This one) / PLAYBOOK / REPOSITORY / CODESPACES open in the browser' },
      { label: 'Have the HANDS-ON tab open on ANOTHER SCREEN' },
      { label: 'TEAM : HIDE the presenter bar, open the chat on ANOTHER SCREEN' },
      { label: 'Open theomonfort repo in VS Code and GitHub' },
      { label: 'Open GHAS repository' },
    ],
  },
  {
    title: 'INTRODUCTION',
    subtitle: 'GitHub と Copilot',
    color: 'cyan',
    items: [
      { label: 'Self-introduction' },
      {
        label: 'Send following message in Teams',
        teams: [
          { label: '本日扱う技術用語と、使用するスライド資料', url: 'https://theomonfort.github.io/theomonfort/playbook/' },
          { label: 'ハンズオン資料', url: 'https://theomonfort.github.io/theomonfort/handson/intro/' },
          { label: 'アンケート', url: 'https://forms.office.com/Pages/ResponsePage.aspx?id=v4j5cvGGr0GRqy180BHbRxfrxixxnh1AkgHlZ0RLul1UNUNIN0tHWlhCSTkxUlJLVVdGM1lPNFJCVi4u' },
        ],
      },
      { label: 'Explain GITHUB (SLIDE)' },
      { label: 'Explain COPILOT (SLIDE)' },
      { label: 'Explain HANDS-ON (SLIDE)' },
    ],
  },
  {
    title: 'PLAN',
    subtitle: 'Copilotにハーネスを着せる',
    color: 'green',
    items: [
      { label: 'Explain HARNESS ENGINEERING (SLIDE)' },
      { label: 'Explain MCP, INSTRUCTIONS, SKILLS, CUSTOM AGENT (SLIDES)' },
      { label: 'Demo CODESPACES : Pre-set, Share environment, Secure (cloud)' },
      { label: 'Demo REPO: Markdown file + assets only' },
      { label: 'Demo MCP, INSTRUCTIONS, SKILLS (CODESPACES)' },
    ],
  },
  {
    title: 'CODE',
    subtitle: 'Copilot と同期でコーディング',
    color: 'magenta',
    items: [
      { label: 'Show Customization windows', checklistIndex: 22 },
      { label: 'Demo Agent Mode (Plan), Permission (Allow-all), Models (Fusion)', checklistKey: 'code-agent-configuration' },
      { label: 'Send prompt and validate until switching to Autopilot', checklistKey: 'code-prompt-autopilot' },
      { label: 'Demo inline request', checklistIndex: 25 },
      { label: 'Candidate explanations: Context windows, Token optimization, CLI (Subagents), Copilot (App)', checklistKey: 'code-explanation-candidates' },
    ],
  },
  {
    title: 'CODE REVIEW',
    subtitle: '自動レビューを設定',
    color: 'amber',
    items: [
      // Preserve following progress IDs without reusing retired CODE items.
      { label: 'Explain Code Review', checklistIndex: 29 },
      { label: 'Demo Rulesets Setting' },
      { label: 'Demo Implementation Result' },
      { label: 'Demo Code Review Result' },
    ],
  },
  {
    title: 'CODE',
    subtitle: 'Copilot と非同期でコーディング',
    color: 'magenta',
    items: [
      { label: 'Explain CLOUD AGENT (SLIDES)' },
      { label: 'Demo MCP server for CCA' },
      { label: 'Demo Assign [playbook:presentation-core] first; merge before TEST & SECURE, then finish the presentation-content / mermaid-rendering / responsive-navigation tasks' },
      { label: 'Demo Setting' },
      { label: 'Demo CCA Session (OTHER REPO)' },
      { label: 'Demo Conflict Resolution' },
      { label: 'Demo CCA implementation Result' },
      { label: 'SUMMARIZE' },
    ],
  },
  {
    title: 'TEST & SECURE',
    subtitle: '脆弱性チェックを設定',
    color: 'cyan',
    items: [
      { label: 'Demo CodeQL on PR' },
      { label: 'Explain GHAS (SLIDES)' },
      { label: 'Explain TESTS: open /playbook, enter presentation from a card, then test keyboard navigation' },
    ],
  },
  {
    title: 'CLI',
    subtitle: 'CLI と Copilot アプリ',
    color: 'amber',
    items: [
      { label: 'Explain CLI' },
      { label: 'Demo CLI Versus Visual Studio Code' },
      { label: 'Inspect checkpoint3 3D or build [playbook:playbook-3d] manually, then galaxy-audio after merging; audio/reporting are not prebuilt; fleet only independent ready tasks' },
    ],
  },
  {
    title: 'OPERATE',
    subtitle: '保守をエージェントワークフローに委任',
    color: 'green',
    items: [
      { label: 'Explain AGENTIC WORKFLOW' },
      { label: 'Demo Send Prompt' },
      { label: 'Demo results in theomonfort repo' },
    ],
  },
];

const githubSections: Section[] = [
  {
    title: 'PREPARATION',
    subtitle: '登壇準備',
    color: 'amber',
    items: [
      { label: 'Duplicate the workshop repo in your Organization' },
      { label: 'Check Code Scanning, Secret Scanning, Dependabot, Code Review ruleset are activated' },
      { label: 'Have the AGENDA (This one) / PLAYBOOK / REPOSITORY open in the browser' },
      { label: 'Open the workshop repo in VS Code and GitHub' },
    ],
  },
  {
    title: 'INTRODUCTION',
    subtitle: 'GitHub',
    color: 'cyan',
    duration: '10分',
    items: [
      { label: 'Self-introduction' },
      { label: 'Explain GITHUB (SLIDE)' },
    ],
  },
  {
    title: 'ADMINISTRATION',
    subtitle: 'ガバナンス',
    color: 'magenta',
    duration: '30分',
    items: [
      { label: 'Explain Repository Permissions' },
      { label: 'Explain Policies' },
      { label: 'Explain Copilot managed settings' },
      { label: 'Demo : Role + Policies' },
      { label: 'Explain Ricoh usecase' },
    ],
  },
  {
    title: 'REVIEW TOOL',
    subtitle: 'PR とブランチ戦略とRuleset',
    color: 'amber',
    duration: '15分',
    items: [
      { label: 'Explain PR' },
      { label: 'Explain Branching strategies' },
    ],
  },
  {
    title: 'COLLABORATION TOOLS',
    subtitle: 'Issues・Projects・Discussions',
    color: 'green',
    duration: '15分',
    items: [
      { label: 'Explain Collaboration tools' },
    ],
  },
  {
    title: 'TEST & SECURE',
    subtitle: 'GitHub Actions と GHAS',
    color: 'cyan',
    duration: '15分',
    items: [
      { label: 'Explain GitHub Actions' },
      { label: 'Explain Dependabot' },
      { label: 'Explain Code Scanning' },
      { label: 'Explain Secret Protection' },
    ],
  },
  {
    title: 'Q&A',
    subtitle: '質疑応答',
    color: 'amber',
    duration: '1時間30分',
    items: [
      { label: 'Open Q&A' },
    ],
  },
];

const objectivesGithub =
  locale === 'en'
    ? 'This GitHub workshop tours the GitHub platform basics — collaboration tools, pull requests and branching, GitHub Actions, and GHAS (Dependabot, Code Scanning, Secret Protection) — to build a solid foundation for team development and security.'
    : 'この GitHub ワークショップでは、GitHub プラットフォームの基本 ── コラボレーションツール、Pull Request とブランチ戦略、GitHub Actions、そして GHAS（Dependabot・Code Scanning・Secret Protection）── を一巡りして、チーム開発とセキュリティの土台を固める。';

const workshops: { id: string; sections: Section[]; objectives: string }[] = [
  { id: 'copilot', sections, objectives: objectivesText },
  { id: 'github', sections: githubSections, objectives: objectivesGithub },
];

const totalItems = sections.reduce((n, s) => n + s.items.length, 0);
---

<Layout locale={locale} currentPath="/ws" title="Workshop Presenter Notes">
  <section class="max-w-3xl mx-auto px-4 py-12 md:py-16">
    <section class="ws-quest">
      <span class="ws-quest-time font-mono">⏱ {timeText}</span>
      <div class="ws-quest-grid">
        <div class="ws-quest-copy">
          <div class="ws-switch flex items-center gap-2 mb-3" role="tablist" aria-label="Workshop">
            <button type="button" role="tab" class="ws-tab" data-ws="github" aria-selected="false" aria-controls="ws-notes-github">GITHUB</button>
            <button type="button" role="tab" class="ws-tab is-active" data-ws="copilot" aria-selected="true" aria-controls="ws-notes">COPILOT</button>
            <button type="button" role="tab" class="ws-tab" data-ws="ghas" aria-selected="false" aria-controls="ws-construction">GHAS</button>
          </div>
          <h1 id="ws-title" class="ws-quest-title font-display">COPILOT WORKSHOP</h1>
          <div id="ws-quest-body">
            <p id="ws-objectives" class="ws-quest-sum font-body">{objectivesText}</p>
            <div id="ws-progress" class="ws-quest-progress">
              <div class="ws-exp">
                <span class="ws-exp-tag">EXP</span>
                <div class="ws-track">
                  <div id="ws-bar" class="ws-bar-fill" style="width:0%"></div>
                  <div class="ws-exp-ticks" aria-hidden="true">
                    {Array.from({ length: 12 }).map(() => <span></span>)}
                  </div>
                </div>
                <span id="ws-count" class="ws-exp-count">0 / {totalItems}</span>
              </div>
              <div class="ws-exp-ctrls">
                <button id="ws-expand" type="button" class="ws-exp-btn">EXPAND</button>
                <button id="ws-collapse" type="button" class="ws-exp-btn">COLLAPSE</button>
                <button id="ws-reset" type="button" class="ws-exp-btn reset">RESET</button>
              </div>
            </div>
          </div>
        </div>
        <div class="ws-quest-mascot" aria-hidden="true">
          <img src="/theomonfort/favicon.svg" alt="" width="160" height="160" />
        </div>
      </div>
    </section>

    <div id="ws-construction" class="ws-construction" role="tabpanel" hidden>
      <img src={ucIcon} alt="" width="160" height="160" class="ws-uc-icon" />
      <p class="ws-uc-title font-display">{ucTitle}</p>
      <p class="ws-uc-body font-body">{ucBody}</p>
    </div>

    {workshops.map((w) => {
      let counter = 0;
      const wTotal = w.sections.reduce((n, s) => n + s.items.length, 0);
      const panelId = w.id === 'copilot' ? 'ws-notes' : `ws-notes-${w.id}`;
      return (
      <div id={panelId} class="ws-panel" role="tabpanel" data-workshop={w.id} data-objectives={w.objectives} hidden={w.id !== 'copilot'}>

    <div class="ws-secs" data-total={wTotal} data-workshop={w.id}>
      {w.sections.map((section, si) => {
        const c = COLORS[section.color];
        return (
          <details class="ws-section" data-section={`${w.id}-${si}`} style={`--c:${c.cssVar}`} open>
            <summary class={`ws-summary flex items-center gap-3 cursor-pointer select-none px-2.5 py-2.5 rounded-[var(--radius-card)] ${c.text}`}>
              <span class="ws-node shrink-0" aria-hidden="true"></span>
              <span class="ws-chevron font-mono text-xs transition-transform duration-200">▶</span>
              <h2 class="font-display text-sm md:text-base font-bold tracking-[0.08em] leading-tight flex-1">
                {section.duration && <span class="ws-duration font-mono text-xs font-medium normal-case opacity-90 mr-1.5">（~{section.duration}）</span>}
                <span class="uppercase">{section.title}</span>
                {section.subtitle && <span class="ws-subtitle font-body"> : {section.subtitle}</span>}
              </h2>
              <button type="button" class="ws-check-all font-mono" aria-label="Toggle all items in this section">✓ ALL</button>
              <span class="ws-section-count font-mono text-xs font-semibold opacity-90">0 / {section.items.length}</span>
            </summary>
            <ul class="ws-list ml-[6px] pl-5 py-1 space-y-0.5">
              {section.items.map((item) => {
                counter = item.checklistIndex ?? counter;
                const id = `ws-${w.id}-${item.checklistKey ?? counter++}`;
                const teamsText = item.teams
                  ? item.teams.map((t) => `${t.label}\n${t.url}`).join('\n\n')
                  : '';
                const stepKind =
                  section.title === 'PREPARATION'
                    ? 'prep'
                    : /^(explain|summarize|candidate explanations)\b/i.test(item.label)
                      ? 'explain'
                      : /^(demo|show|send prompt)\b/i.test(item.label)
                        ? 'demo'
                        : section.title === 'INTRODUCTION'
                          ? 'explain'
                          : '';
                return (
                  <li>
                    <label
                      class="ws-row group flex items-start gap-3 cursor-pointer px-2.5 py-2 rounded-[var(--radius-card)] border border-transparent hover:border-neon-cyan/25 hover:bg-deep-purple/65 transition-colors"
                      for={id}
                    >
                      <input type="checkbox" id={id} class={`ws-check mt-0.5 h-4 w-4 shrink-0 ${c.accent} cursor-pointer`} />
                      <span class="ws-label font-body text-sm md:text-[15px] text-phosphor leading-snug">
                        {stepKind === 'explain' && <span class="ws-step-ico" aria-hidden="true">💬</span>}
                        {stepKind === 'prep' && <span class="ws-step-ico" aria-hidden="true">🛠️</span>}
                        {stepKind === 'demo' && <img class="ws-step-ico ws-step-demo" src="/theomonfort/icons/arcade-machine.png" alt="" />}
                        {item.label}
                      </span>
                      {item.teams && (
                        <button type="button" class="ws-copy shrink-0" data-clip={teamsText} aria-label="Copy Teams message">
                          <span class="ws-copy-icon" aria-hidden="true">📋</span>
                          <span class="ws-copy-text">Copy</span>
                        </button>
                      )}
                    </label>
                  </li>
                );
              })}
            </ul>
          </details>
        );
      })}
    </div>
    </div>
      );
    })}
  </section>
</Layout>

<style>
  /* EXP progress bar (inside the Phosphor HUD / Retro QUEST frame) */
  .ws-exp { display: flex; align-items: center; gap: 0.7rem; }
  .ws-exp-tag {
    font-family: var(--font-mono-hud);
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.14em;
    color: var(--c-neon-cyan);
  }
  .ws-track {
    flex: 1;
    height: 14px;
    background: var(--c-shadow-ink);
    border: 1px solid rgb(var(--rgb-neon-cyan) / 0.34);
    border-radius: var(--radius-card);
    padding: 2px;
    position: relative;
    overflow: hidden;
  }
  .ws-bar-fill {
    height: 100%;
    width: 0;
    border-radius: var(--radius-ui);
    background: linear-gradient(90deg, var(--c-neon-cyan), var(--c-neon-magenta));
    box-shadow: 0 0 10px rgb(var(--rgb-neon-cyan) / 0.4);
    transition: width 0.3s ease;
  }
  .ws-exp-ticks { position: absolute; inset: 2px; display: flex; pointer-events: none; }
  .ws-exp-ticks span { flex: 1; border-right: 1px solid rgb(var(--rgb-neon-cyan) / 0.16); }
  .ws-exp-ticks span:last-child { border-right: none; }
  .ws-exp-count {
    font-family: var(--font-mono-hud);
    font-size: 0.85rem;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    color: var(--c-neon-cyan);
    white-space: nowrap;
  }
  .ws-exp-ctrls { display: flex; justify-content: flex-start; gap: 0.45rem; margin-top: 0.9rem; }
  .ws-exp-btn {
    font-family: var(--font-mono-hud);
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.1em;
    color: var(--c-neon-cyan);
    background: var(--c-shadow-ink);
    border: 1px solid var(--c-border-strong);
    border-radius: var(--radius-ui);
    padding: 0.45em 0.75em;
    cursor: pointer;
    transition: background 0.15s ease, color 0.15s ease, border-color 0.15s ease;
  }
  .ws-exp-btn:hover { background: var(--c-neon-cyan); border-color: var(--c-neon-cyan); color: var(--c-shadow-ink); }
  .ws-exp-btn.reset { color: var(--c-crt-amber); border-color: rgb(var(--rgb-crt-amber) / 0.38); }
  .ws-exp-btn.reset:hover { background: var(--c-crt-amber); border-color: var(--c-crt-amber); color: var(--c-shadow-ink); }

  .ws-summary::-webkit-details-marker { display: none; }
  .ws-summary {
    list-style: none;
    transition: background-color 0.15s ease;
  }
  .ws-summary:hover {
    background-color: rgb(var(--rgb-deep-purple) / 0.75);
  }

  /* HUD LOG frame for the /ws top */
  .ws-quest {
    position: relative;
    overflow: visible;
    border: 1px solid rgb(var(--rgb-neon-cyan) / 0.24);
    border-radius: var(--radius-card);
    padding: clamp(1.15rem, 3vw, 1.75rem);
    margin-bottom: 2rem;
    background-color: var(--c-bg-elevated);
    background-image:
      linear-gradient(90deg, var(--c-neon-cyan) 0%, color-mix(in srgb, var(--c-neon-cyan) 30%, transparent) 55%, transparent 100%),
      repeating-linear-gradient(90deg, rgb(var(--rgb-neon-cyan) / 0.03) 0 1px, transparent 1px 36px);
    background-size: 100% 2px, auto;
    background-position: top left, 0 0;
    background-repeat: no-repeat, repeat;
    backdrop-filter: blur(10px);
    box-shadow: 0 14px 36px rgb(var(--rgb-shadow-ink) / 0.48);
  }
  .ws-quest::after {
    content: 'WORKSHOP LOG';
    position: absolute;
    left: 1rem;
    top: -0.65rem;
    padding: 0.1rem 0.55rem;
    border-radius: var(--radius-ui);
    border: 1px solid rgb(var(--rgb-crt-amber) / 0.35);
    color: var(--c-crt-amber);
    background: var(--c-shadow-ink);
    font-family: var(--font-mono-hud);
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.14em;
    z-index: 2;
  }
  .ws-quest-time {
    position: absolute;
    right: 1rem;
    top: -0.65rem;
    padding: 0.1rem 0.55rem;
    border-radius: var(--radius-ui);
    border: 1px solid var(--c-border-strong);
    color: var(--c-neon-cyan);
    background: var(--c-shadow-ink);
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.12em;
    z-index: 2;
  }
  .ws-quest-grid {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(7rem, 10rem);
    gap: clamp(1rem, 3vw, 2rem);
    align-items: center;
  }
  .ws-quest-title {
    color: var(--c-phosphor);
    font-size: clamp(1.1rem, 3vw, 1.65rem);
    font-weight: 700;
    letter-spacing: 0.06em;
    line-height: 1.2;
    white-space: nowrap;
    margin: 0.35rem 0 0;
  }
  .ws-quest-sum {
    max-width: 46rem;
    margin-top: 0.9rem;
    color: var(--c-fg-body);
    font-size: 0.94rem;
    line-height: 1.75;
  }
  .ws-quest-progress { margin-top: 1.35rem; }
  #ws-quest-body[hidden] { display: none; }
  .ws-quest-mascot { position: relative; display: flex; align-items: center; justify-content: center; min-height: 8rem; }
  .ws-quest-mascot::before {
    content: '';
    position: absolute;
    left: 50%;
    top: 104%;
    width: 11rem;
    height: 4rem;
    border: 1px solid rgb(var(--rgb-neon-cyan) / 0.38);
    border-radius: 50%;
    transform: translate(-50%, -50%) rotate(-14deg);
    box-shadow: 0 0 12px rgb(var(--rgb-neon-cyan) / 0.18);
    pointer-events: none;
  }
  .ws-quest-mascot img {
    position: relative;
    z-index: 1;
    width: min(9rem, 100%);
    height: auto;
    filter: drop-shadow(0 12px 18px rgb(var(--rgb-shadow-ink) / 0.65)) drop-shadow(0 0 22px rgb(var(--rgb-neon-cyan) / 0.32));
    animation: ws-mascot-drift 7s ease-in-out infinite;
  }
  @keyframes ws-mascot-drift { 50% { transform: translateY(-10px); } }
  @media (prefers-reduced-motion: reduce) { .ws-quest-mascot img { animation: none; } }
  @media (max-width: 640px) {
    .ws-quest-grid { grid-template-columns: 1fr; }
    .ws-quest-mascot { display: none; }
  }

  /* Workshop selector tabs */
  .ws-tab {
    font-family: var(--font-mono-hud);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.12em;
    padding: 0.4rem 0.75rem;
    border-radius: var(--radius-ui);
    color: var(--c-fg-muted);
    background: var(--c-shadow-ink);
    border: 1px solid rgb(var(--rgb-neon-cyan) / 0.22);
    cursor: pointer;
    transition: color 0.15s ease, border-color 0.15s ease, background-color 0.15s ease;
  }
  .ws-tab:hover {
    color: var(--c-phosphor);
    border-color: rgb(var(--rgb-neon-cyan) / 0.48);
  }
  .ws-tab.is-active {
    color: var(--c-shadow-ink);
    border-color: var(--c-neon-cyan);
    background: var(--c-neon-cyan);
  }

  /* Under-construction panel for unbuilt workshops */
  .ws-construction[hidden] { display: none; }
  .ws-construction {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    gap: 1rem;
    padding: 4rem 1rem 5rem;
    border-radius: var(--radius-card);
    border: 1px solid var(--c-border);
    background: var(--c-bg-elevated);
  }
  .ws-uc-icon {
    width: 160px;
    height: 160px;
    filter: drop-shadow(0 0 16px rgb(var(--rgb-crt-amber) / 0.35));
    animation: ws-uc-float 2.4s ease-in-out infinite;
  }
  @keyframes ws-uc-float {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-10px); }
  }
  @media (prefers-reduced-motion: reduce) {
    .ws-uc-icon { animation: none; }
  }
  .ws-uc-title {
    font-size: 1rem;
    font-weight: 700;
    letter-spacing: 0.22em;
    color: var(--c-crt-amber);
  }
  .ws-uc-body {
    font-size: 0.92rem;
    color: var(--c-fg-body);
  }
  .ws-subtitle {
    font-weight: 500;
    text-transform: none;
    letter-spacing: 0.02em;
    opacity: 0.92;
  }

  /* Copy-to-clipboard button (Teams message) */
  .ws-copy {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    padding: 0.15rem 0.5rem;
    border-radius: var(--radius-ui);
    font-family: var(--font-mono-hud);
    font-size: 11px;
    font-weight: 600;
    line-height: 1.4;
    color: var(--c);
    background: var(--c-shadow-ink);
    border: 1px solid color-mix(in srgb, var(--c) 55%, transparent);
    cursor: pointer;
    transition: background 0.15s ease, color 0.15s ease, border-color 0.15s ease;
  }
  .ws-copy:hover {
    background: var(--c);
    border-color: var(--c);
    color: var(--c-shadow-ink);
  }
  .ws-copy.is-copied {
    background: var(--c);
    border-color: var(--c);
    color: var(--c-shadow-ink);
  }
  .ws-copy-icon { font-size: 11px; line-height: 1; }
  details[open] > .ws-summary .ws-chevron { transform: rotate(90deg); }

  /* Telemetry blinking cursor on the open (current) section */
  details[open] > .ws-summary h2::after {
    content: '_';
    margin-left: 0.25rem;
    color: var(--c);
    font-weight: 700;
    animation: ws-blink 1s steps(1) infinite;
  }
  @keyframes ws-blink {
    50% { opacity: 0; }
  }
  @media (prefers-reduced-motion: reduce) {
    details[open] > .ws-summary h2::after { animation: none; }
  }

  /* Roadmap Spine */
  .ws-secs {
    position: relative;
    padding-left: 1.5rem;
  }
  .ws-secs::before {
    content: '';
    position: absolute;
    left: 0.55rem;
    top: 0.7rem;
    bottom: 0.7rem;
    width: 2px;
    background: linear-gradient(var(--c-neon-cyan), var(--c-neon-magenta));
    opacity: 0.45;
  }
  .ws-section {
    position: relative;
    margin-bottom: 0.45rem;
  }
  .ws-node {
    position: absolute;
    left: -1.3rem;
    top: 0.95rem;
    width: 13px;
    height: 13px;
    border-radius: var(--radius-ui);
    background: var(--c);
    box-shadow: 0 0 8px color-mix(in srgb, var(--c) 55%, transparent);
    border: 2px solid var(--c-shadow-ink);
  }
  .ws-list {
    border-left: 1px solid color-mix(in srgb, var(--c) 32%, transparent);
  }
  .ws-list .ws-label::before {
    content: '– ';
    color: var(--c);
    opacity: 0.7;
  }
  .ws-step-ico {
    display: inline-block;
    margin-right: 0.35em;
    vertical-align: -0.18em;
    line-height: 1;
  }
  .ws-step-ico.ws-step-demo {
    width: 1.3em;
    height: 1.3em;
    object-fit: contain;
  }

  /* Custom checkbox: fills with the section color when checked */
  .ws-check {
    appearance: none;
    -webkit-appearance: none;
    width: 16px;
    height: 16px;
    border-radius: var(--radius-ui);
    border: 1.5px solid var(--c);
    background: var(--c-shadow-ink);
    position: relative;
    cursor: pointer;
  }
  .ws-check:checked {
    background: var(--c);
    box-shadow: 0 0 8px color-mix(in srgb, var(--c) 50%, transparent);
  }
  .ws-check:checked::after {
    content: '✓';
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-mono-hud);
    font-size: 11px;
    font-weight: 700;
    line-height: 1;
    color: var(--c-shadow-ink);
  }

  /* Checked label dims to muted slate with a strike-through */
  .ws-check:checked + .ws-label {
    color: var(--c-fg-muted);
    text-decoration: line-through;
    text-decoration-color: rgb(var(--rgb-phosphor-muted) / 0.55);
  }
  .ws-check:checked + .ws-label::before {
    color: inherit;
    opacity: 1;
  }

  /* Completed section: all items checked -> dim it */
  .ws-section.is-complete > .ws-summary {
    opacity: 0.45;
    filter: grayscale(0.85);
    transition: opacity 0.3s ease, filter 0.3s ease;
  }
  .ws-section.is-complete > .ws-summary:hover {
    opacity: 0.75;
  }
  .ws-section.is-complete > .ws-summary .ws-node {
    background: var(--c-fg-muted);
    box-shadow: none;
  }
  .ws-section.is-complete > .ws-summary h2::after {
    display: none;
  }

  /* Per-section "check all / clear" button */
  .ws-check-all {
    font-family: var(--font-mono-hud);
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.08em;
    color: var(--c);
    background: var(--c-shadow-ink);
    border: 1px solid color-mix(in srgb, var(--c) 45%, transparent);
    border-radius: var(--radius-ui);
    padding: 0.3em 0.6em;
    cursor: pointer;
    opacity: 0.55;
    white-space: nowrap;
    transition: opacity 0.15s ease, background 0.15s ease, color 0.15s ease, border-color 0.15s ease;
  }
  .ws-summary:hover .ws-check-all,
  .ws-check-all:focus-visible {
    opacity: 1;
  }
  .ws-check-all:hover {
    background: var(--c);
    border-color: var(--c);
    color: var(--c-shadow-ink);
  }
  .ws-check-all.is-all {
    opacity: 1;
    background: var(--c);
    border-color: var(--c);
    color: var(--c-shadow-ink);
  }

  /* Retro JRPG overrides */
  :global(html[data-theme='retro']) .ws-quest {
    border: 2px solid rgb(var(--rgb-neon-cyan) / 0.66);
    border-radius: 0;
    background:
      linear-gradient(130deg, rgb(var(--rgb-shadow-ink) / 0.94), rgb(var(--rgb-midnight) / 0.82)),
      repeating-linear-gradient(90deg, rgb(var(--rgb-neon-cyan) / 0.05) 0 1px, transparent 1px 36px);
    backdrop-filter: none;
    box-shadow: 7px 7px 0 rgb(var(--rgb-shadow-ink) / 0.88), inset 0 0 28px rgb(var(--rgb-neon-cyan) / 0.1);
  }
  :global(html[data-theme='retro']) .ws-quest::before {
    content: '';
    position: absolute;
    inset: 0.85rem;
    border: 1px dashed rgb(var(--rgb-neon-cyan) / 0.34);
    pointer-events: none;
  }
  :global(html[data-theme='retro']) .ws-quest::after {
    border: 0;
    border-radius: 0;
    padding: 0 0.6rem;
    font-family: 'Press Start 2P', monospace;
    font-size: 9px;
    letter-spacing: 0.18em;
  }
  :global(html[data-theme='retro']) .ws-quest-time {
    border: 0;
    border-radius: 0;
    padding: 0 0.6rem;
    font-family: 'Press Start 2P', monospace;
    font-size: 9px;
    letter-spacing: 0.14em;
  }
  :global(html[data-theme='retro']) .ws-quest-title {
    font-family: 'Press Start 2P', monospace;
    color: var(--c-neon-cyan);
    font-size: clamp(0.85rem, 3vw, 1.5rem);
    text-shadow: 0 0 20px rgb(var(--rgb-neon-cyan) / 0.5);
  }
  :global(html[data-theme='retro']) .ws-quest-sum,
  :global(html[data-theme='retro']) .ws-label,
  :global(html[data-theme='retro']) .ws-uc-body {
    font-family: 'DotGothic16', sans-serif;
  }
  :global(html[data-theme='retro']) .ws-tab {
    font-family: 'Press Start 2P', monospace;
    font-size: 9px;
    border-radius: 0;
    border-width: 2px;
    background: transparent;
  }
  :global(html[data-theme='retro']) .ws-tab.is-active {
    background: var(--c-neon-cyan);
    color: var(--c-shadow-ink);
    box-shadow: 0 0 10px rgb(var(--rgb-neon-cyan) / 0.45);
  }
  :global(html[data-theme='retro']) .ws-exp-tag {
    font-family: 'Press Start 2P', monospace;
    font-size: 9px;
  }
  :global(html[data-theme='retro']) .ws-track {
    height: 16px;
    border: 2px solid rgb(var(--rgb-neon-cyan) / 0.7);
    border-radius: 0;
  }
  :global(html[data-theme='retro']) .ws-bar-fill {
    border-radius: 0;
  }
  :global(html[data-theme='retro']) .ws-exp-count {
    font-family: 'VT323', monospace;
    font-size: 1.3rem;
  }
  :global(html[data-theme='retro']) .ws-exp-btn {
    font-family: 'Press Start 2P', monospace;
    font-size: 8px;
    border-radius: 0;
    background: transparent;
  }
  :global(html[data-theme='retro']) .ws-construction {
    border: 2px dashed rgb(var(--rgb-crt-amber) / 0.5);
    border-radius: 0;
    background: rgb(var(--rgb-shadow-ink) / 0.85);
  }
  :global(html[data-theme='retro']) .ws-uc-title {
    font-family: 'Press Start 2P', monospace;
  }
  :global(html[data-theme='retro']) .ws-summary {
    border-radius: 0;
  }
  :global(html[data-theme='retro']) .ws-summary h2 {
    font-family: 'DotGothic16', sans-serif;
    font-size: 1.05rem;
    letter-spacing: 0.12em;
  }
  :global(html[data-theme='retro']) .ws-duration,
  :global(html[data-theme='retro']) .ws-section-count {
    font-family: 'VT323', monospace;
    font-size: 1.05rem;
  }
  :global(html[data-theme='retro']) .ws-node {
    border-radius: 0;
    width: 14px;
    height: 14px;
    box-shadow: 0 0 8px var(--c);
  }
  :global(html[data-theme='retro']) .ws-list {
    border-left: 1px dashed color-mix(in srgb, var(--c) 40%, transparent);
  }
  :global(html[data-theme='retro']) .ws-check {
    border-radius: 0;
    border-width: 2px;
    background: transparent;
  }
  :global(html[data-theme='retro']) .ws-check-all,
  :global(html[data-theme='retro']) .ws-copy {
    font-family: 'Press Start 2P', monospace;
    font-size: 8px;
    border-radius: 0;
    background: transparent;
  }
  :global(html[data-theme='retro']) .ws-check-all:hover,
  :global(html[data-theme='retro']) .ws-check-all.is-all,
  :global(html[data-theme='retro']) .ws-copy:hover,
  :global(html[data-theme='retro']) .ws-copy.is-copied {
    background: var(--c);
    color: var(--c-shadow-ink);
    box-shadow: 0 0 8px var(--c);
  }
</style>

<script>
  const CHECK_KEY = 'ws-presenter-notes-v1';
  const OPEN_KEY = 'ws-presenter-open-v1';

  function readJSON(key: string): Record<string, boolean> {
    try {
      return JSON.parse(localStorage.getItem(key) || '{}');
    } catch {
      return {};
    }
  }

  function initWorkshopChecklist() {
    const containers = Array.from(document.querySelectorAll<HTMLElement>('.ws-secs'));
    if (!containers.length) return;
    const root = document.querySelector<HTMLElement>('.ws-quest');
    if (!root || root.dataset.wsInit === '1') return;
    root.dataset.wsInit = '1';

    const checks = Array.from(document.querySelectorAll<HTMLInputElement>('.ws-check'));
    const sectionEls = Array.from(document.querySelectorAll<HTMLDetailsElement>('.ws-section'));
    let activeWs = 'copilot';
    const activeContainer = () =>
      document.querySelector<HTMLElement>(`.ws-secs[data-workshop="${activeWs}"]`);
    const countEl = document.getElementById('ws-count');
    const barEl = document.getElementById('ws-bar');
    const resetBtn = document.getElementById('ws-reset');
    const expandBtn = document.getElementById('ws-expand');
    const collapseBtn = document.getElementById('ws-collapse');

    let checkState = readJSON(CHECK_KEY);
    let openState = readJSON(OPEN_KEY);

    const saveChecks = () => localStorage.setItem(CHECK_KEY, JSON.stringify(checkState));
    const saveOpen = () => localStorage.setItem(OPEN_KEY, JSON.stringify(openState));

    const refreshSection = (section: HTMLDetailsElement) => {
      const boxes = Array.from(section.querySelectorAll<HTMLInputElement>('.ws-check'));
      const done = boxes.filter((b) => b.checked).length;
      const label = section.querySelector('.ws-section-count');
      if (label) label.textContent = `${done} / ${boxes.length}`;
      const allDone = boxes.length > 0 && done === boxes.length;
      section.classList.toggle('is-complete', allDone);
      const allBtn = section.querySelector<HTMLButtonElement>('.ws-check-all');
      if (allBtn) {
        allBtn.classList.toggle('is-all', allDone);
        allBtn.textContent = allDone ? '✓ CLEAR' : '✓ ALL';
      }
    };

    const refreshGlobal = () => {
      const cont = activeContainer();
      const boxes = cont ? Array.from(cont.querySelectorAll<HTMLInputElement>('.ws-check')) : [];
      const done = boxes.filter((c) => c.checked).length;
      const total = boxes.length;
      if (countEl) countEl.textContent = `${done} / ${total}`;
      if (barEl) barEl.style.width = total ? `${(done / total) * 100}%` : '0%';
    };

    checks.forEach((c) => {
      c.checked = !!checkState[c.id];
      c.addEventListener('change', () => {
        checkState[c.id] = c.checked;
        saveChecks();
        const section = c.closest<HTMLDetailsElement>('.ws-section');
        if (section) refreshSection(section);
        refreshGlobal();
      });
    });

    sectionEls.forEach((section) => {
      const key = section.dataset.section || '';
      if (key in openState) section.open = !!openState[key];
      section.addEventListener('toggle', () => {
        openState[key] = section.open;
        saveOpen();
      });
      const allBtn = section.querySelector<HTMLButtonElement>('.ws-check-all');
      allBtn?.addEventListener('click', (e) => {
        e.preventDefault();
        e.stopPropagation();
        const boxes = Array.from(section.querySelectorAll<HTMLInputElement>('.ws-check'));
        const target = boxes.some((b) => !b.checked);
        boxes.forEach((b) => {
          b.checked = target;
          checkState[b.id] = target;
        });
        saveChecks();
        refreshSection(section);
        refreshGlobal();
      });
      refreshSection(section);
    });

    resetBtn?.addEventListener('click', () => {
      const cont = activeContainer();
      if (!cont) return;
      const boxes = Array.from(cont.querySelectorAll<HTMLInputElement>('.ws-check'));
      boxes.forEach((c) => {
        c.checked = false;
        checkState[c.id] = false;
      });
      saveChecks();
      Array.from(cont.querySelectorAll<HTMLDetailsElement>('.ws-section')).forEach(refreshSection);
      refreshGlobal();
    });

    const setAll = (open: boolean) => {
      const cont = activeContainer();
      if (!cont) return;
      Array.from(cont.querySelectorAll<HTMLDetailsElement>('.ws-section')).forEach((section) => {
        section.open = open;
        openState[section.dataset.section || ''] = open;
      });
      saveOpen();
    };
    expandBtn?.addEventListener('click', () => setAll(true));
    collapseBtn?.addEventListener('click', () => setAll(false));

    const copyBtns = Array.from(document.querySelectorAll<HTMLButtonElement>('.ws-copy'));
    copyBtns.forEach((btn) => {
      const original = btn.querySelector('.ws-copy-text')?.textContent || '';
      btn.addEventListener('click', async (e) => {
        e.preventDefault();
        e.stopPropagation();
        const text = btn.dataset.clip || '';
        try {
          await navigator.clipboard.writeText(text);
        } catch {
          const ta = document.createElement('textarea');
          ta.value = text;
          ta.style.position = 'fixed';
          ta.style.opacity = '0';
          document.body.appendChild(ta);
          ta.select();
          try { document.execCommand('copy'); } catch {}
          document.body.removeChild(ta);
        }
        const labelEl = btn.querySelector('.ws-copy-text');
        btn.classList.add('is-copied');
        if (labelEl) labelEl.textContent = 'Copied ✓';
        window.setTimeout(() => {
          btn.classList.remove('is-copied');
          if (labelEl) labelEl.textContent = original;
        }, 1500);
      });
    });

    const WS_NAMES: Record<string, string> = {
      copilot: 'COPILOT WORKSHOP',
      github: 'GITHUB WORKSHOP',
      ghas: 'GHAS WORKSHOP',
    };
    const WS_KEY = 'ws-active-workshop-v1';
    const REAL = new Set(['copilot', 'github']);
    const tabs = Array.from(document.querySelectorAll<HTMLButtonElement>('.ws-tab'));
    const titleEl = document.getElementById('ws-title');
    const panels = Array.from(document.querySelectorAll<HTMLElement>('.ws-panel'));
    const constructionEl = document.getElementById('ws-construction');
    const questBody = document.getElementById('ws-quest-body');
    const objectivesEl = document.getElementById('ws-objectives');

    const selectWorkshop = (id: string) => {
      const active = WS_NAMES[id] ? id : 'copilot';
      const isReal = REAL.has(active);
      if (titleEl) titleEl.textContent = WS_NAMES[active];
      panels.forEach((p) => { p.hidden = p.dataset.workshop !== active; });
      if (questBody) questBody.hidden = !isReal;
      if (constructionEl) constructionEl.hidden = isReal;
      if (isReal) {
        activeWs = active;
        const panel = panels.find((p) => p.dataset.workshop === active);
        if (objectivesEl && panel?.dataset.objectives) {
          objectivesEl.textContent = panel.dataset.objectives;
        }
        refreshGlobal();
      }
      tabs.forEach((t) => {
        const on = t.dataset.ws === active;
        t.classList.toggle('is-active', on);
        t.setAttribute('aria-selected', String(on));
      });
      try { localStorage.setItem(WS_KEY, active); } catch {}
    };

    tabs.forEach((t) => {
      t.addEventListener('click', () => selectWorkshop(t.dataset.ws || 'copilot'));
    });
    let savedWs = 'copilot';
    try { savedWs = localStorage.getItem(WS_KEY) || 'copilot'; } catch {}
    selectWorkshop(savedWs);
  }

  initWorkshopChecklist();
  document.addEventListener('astro:page-load', initWorkshopChecklist);
</script>
