---
import Layout from '../layout/Layout.astro';
import { type Locale, localizedPath } from '../../lib/i18n';

type WorkshopId = 'copilot' | 'github' | 'ghas';

interface Props {
  locale?: Locale;
  workshop?: WorkshopId;
  currentPath?: string;
}
const { locale = 'ja', workshop = 'copilot', currentPath = '/ws' } = Astro.props;

const objectivesText =
  locale === 'en'
    ? 'Give participants a feel for AI-driven development across the full SDLC, and the various tools available to do it. By the end of the workshop, participants will have a clearer idea of the tools available to code with Copilot and can start applying them to their own work.'
    : 'このワークショップの狙いは、計画 → 実装 → レビュー → テスト・セキュリティ → 運用という SDLC 全体を通して、AI 駆動開発の感覚と、それを支えるさまざまなツールを体験してもらうこと。終わったあとには、Copilot でコーディングするために使えるツールの全体像がつかめ、自分の仕事に取り入れ始められる状態を目指す。';

type SectionColor = 'magenta' | 'cyan' | 'amber' | 'green';

interface TeamsLink {
  label: string;
  url: string;
}
interface Item {
  label: string;
  stepKind?: 'prep' | 'explain' | 'demo';
  checklistIndex?: number;
  checklistKey?: string;
  command?: string;
  commandCopyOnly?: boolean;
  note?: string;
  teams?: TeamsLink[];
}
interface Section {
  title: string;
  subtitle?: string;
  sectionIndex?: number;
  note?: string;
  color: SectionColor;
  duration?: string;
  items: Item[];
}

// Section colors mirror the playbook category logic:
// cyan = Introduction / Test & Secure, green = Plan / Operate,
// magenta = Develop (Code), amber = Review (and the yellow bookends).
const COLORS: Record<SectionColor, { text: string; accent: string; cssVar: string }> = {
  magenta: { text: 'text-neon-magenta', accent: 'accent-neon-magenta', cssVar: 'var(--c-neon-magenta)' },
  cyan: { text: 'text-neon-cyan', accent: 'accent-neon-cyan', cssVar: 'var(--c-neon-cyan)' },
  amber: { text: 'text-crt-amber', accent: 'accent-crt-amber', cssVar: 'var(--c-crt-amber)' },
  green: { text: 'text-gb-green', accent: 'accent-gb-green', cssVar: 'var(--c-gb-green)' },
};

const sections: Section[] = [
  {
    title: 'PREPARATION',
    subtitle: '登壇準備',
    color: 'amber',
    items: [
      { label: 'Duplicate the workshop repo in your Organization (main only; leave ‘Include all branches’ unchecked).' },
      { label: 'START THE CODESPACE in advance and ZOOM IN' },
      { label: 'Send a message in Copilot Chat to be able to choose a model' },
      { label: 'Open a new terminal in CODESPACES' },
      { label: 'Check that Code scanning, Secret Scanning, Code Review ruleset are activated' },
      { label: 'Activate Code Quality, Dependabot Security Update' },
      { label: 'Have the AGENDA (This one) / PLAYBOOK / REPOSITORY / CODESPACES open in the browser' },
      { label: 'Have the HANDS-ON tab open on ANOTHER SCREEN' },
      { label: 'TEAM : HIDE the presenter bar, open the chat on ANOTHER SCREEN' },
      { label: 'Open theomonfort repo in VS Code and GitHub' },
      { label: 'Open GHAS repository' },
    ],
  },
  {
    title: 'INTRODUCTION',
    subtitle: 'GitHub と Copilot',
    color: 'cyan',
    items: [
      { label: 'Self-introduction' },
      {
        label: 'Send following message in Teams',
        teams: [
          { label: '本日扱う技術用語と、使用するスライド資料', url: 'https://theomonfort.github.io/theomonfort/playbook/' },
          { label: 'ハンズオン資料', url: 'https://theomonfort.github.io/theomonfort/handson/intro/' },
          { label: 'アンケート', url: 'https://forms.office.com/Pages/ResponsePage.aspx?id=v4j5cvGGr0GRqy180BHbRxfrxixxnh1AkgHlZ0RLul1UNUNIN0tHWlhCSTkxUlJLVVdGM1lPNFJCVi4u' },
        ],
      },
      { label: 'Explain GITHUB (SLIDE)' },
      { label: 'Explain COPILOT (SLIDE)' },
      { label: 'Explain HANDS-ON (SLIDE)' },
    ],
  },
  {
    title: 'PLAN',
    subtitle: 'Copilotにハーネスを着せる',
    color: 'green',
    items: [
      { label: 'Explain HARNESS ENGINEERING (SLIDE)' },
      { label: 'Explain MCP, INSTRUCTIONS, SKILLS, CUSTOM AGENT (SLIDES)' },
      { label: 'Demo CODESPACES : Pre-set, Share environment, Secure (cloud)' },
      { label: 'Demo REPO: Markdown file + assets only' },
      { label: 'Demo MCP, INSTRUCTIONS, SKILLS (Start session runtime or MCP start fails)' },
    ],
  },
  {
    title: 'DEVELOP',
    subtitle: 'Copilot と同期でコーディング',
    color: 'magenta',
    items: [
      { label: 'Show Customization windows', checklistIndex: 22 },
      { label: 'Demo Agent Mode (Plan), Permission (Allow-all), Models (Fusion), Sandbox (/sandbox policy)', checklistKey: 'code-agent-configuration' },
      { label: 'Send prompt and validate until switching to Autopilot', checklistKey: 'code-prompt-autopilot' },
      { label: 'Demo inline request (Cmd + I)', checklistIndex: 25 },
      { label: 'Candidate explanations: Context windows, Token optimization, CLI (Subagents, credit, session), Copilot (App)', checklistKey: 'code-explanation-candidates' },
    ],
  },
  {
    title: 'CODE REVIEW',
    subtitle: '自動レビューを設定',
    note: 'Optional: save your work, then run ./checkpoint1 if you need the base-site checkpoint.',
    color: 'amber',
    items: [
      // Preserve following progress IDs without reusing retired CODE items.
      { label: 'Explain Code Review', checklistIndex: 29 },
      { label: 'Demo Rulesets Setting' },
      { label: 'Demo Implementation Result' },
      { label: 'Demo Code Review Result' },
    ],
  },
  {
    title: 'DEVELOP',
    subtitle: 'Copilot Coding Agent と非同期でコーディング',
    sectionIndex: 5,
    note: 'Build presentation and its TOC from the base site, then finish presentation-content / mermaid-rendering / responsive-navigation. If this milestone is not ready, use checkpoint2 as the fallback and review/merge its PR before testing.',
    color: 'magenta',
    items: [
      { label: 'Explain Copilot coding agent (Cloud Agent)', checklistIndex: 33 },
      { label: 'Demo assign [playbook:presentation-core] to build presentation mode and its TOC', checklistIndex: 35 },
      { label: 'Demo inspect coding-agent implementation and PR', checklistIndex: 39 },
      { label: 'Demo review and merge before TEST & SECURE', checklistKey: 'coding-agent-review-merge' },
    ],
  },
  {
    title: 'TEST & SECURE',
    subtitle: 'テスト作成からセキュリティへ',
    sectionIndex: 6,
    note: 'Start from reviewed, merged presentation (checkpoint2 milestone).',
    color: 'cyan',
    items: [
      { label: 'Run the local server (test agents need it)', stepKind: 'prep', checklistKey: 'tests-run-server' },
      { label: 'Show how to install and check Playwright agents / MCP', checklistKey: 'tests-prepare-agents' },
      { label: 'Demo planner (SWITCH AGENT + COPY LOCAL SERVER LINK)', checklistKey: 'tests-plan-selection' },
      { label: 'Demo test generator', checklistKey: 'tests-generate-assertion' },
      { label: 'Demo workflow generator (SWITCH TO AGENT first)', checklistKey: 'tests-generate-workflow' },
      { label: 'Explain tool choice', checklistKey: 'tests-tool-choice' },
      { label: 'Run checkpoint3 (separate demo checkout)', stepKind: 'demo', checklistKey: 'tests-prepare-demo-checkpoint3' },
      {
        label: 'Run demo if necessary',
        stepKind: 'demo',
        checklistKey: 'tests-checkpoint-demo',
        command: './e2e',
        commandCopyOnly: true,
      },
      { label: 'Demo GHAS and Code Quality on PR', checklistIndex: 41 },
      { label: 'Explain GHAS' },
    ],
  },
  {
    title: 'DEVELOP',
    subtitle: 'Copilot App / Projects（任意の発展編）',
    sectionIndex: 9,
    color: 'magenta',
    items: [
      { label: 'If need explain worktree / subsession / Canvas / Automation', stepKind: 'demo', checklistKey: 'app-project-concepts' },
      { label: 'Add the three remote repos (hands-on remote main: checkpoint2)', stepKind: 'demo', checklistKey: 'app-project-context' },
      { label: 'Add the Word brief to Library', stepKind: 'demo', checklistKey: 'app-project-word-brief' },
      { label: 'Send the prompt (USE MY HANDS-ON REPO NAME + ITS REVIEWED REMOTE MAIN SHA)', stepKind: 'demo', checklistKey: 'app-project-prompt' },
      { label: 'Show Library and Overview', checklistKey: 'app-project-overview' },
      { label: 'Explain Memory/dreaming', checklistKey: 'app-project-memory' },
    ],
  },
  {
    title: 'OPERATE',
    subtitle: '保守をエージェントワークフローに委任',
    sectionIndex: 8,
    color: 'green',
    items: [
      { label: 'Explain AGENTIC WORKFLOW', checklistIndex: 47 },
      { label: 'Demo Send Prompt' },
      { label: 'Demo results in theomonfort repo' },
    ],
  },
];

const githubSections: Section[] = [
  {
    title: 'PREPARATION',
    subtitle: '登壇準備',
    color: 'amber',
    items: [
      { label: 'Duplicate the workshop repo in your Organization' },
      { label: 'Check Code Scanning, Secret Scanning, Dependabot, Code Review ruleset are activated' },
      { label: 'Have the AGENDA (This one) / PLAYBOOK / REPOSITORY open in the browser' },
      { label: 'Open the workshop repo in VS Code and GitHub' },
    ],
  },
  {
    title: 'INTRODUCTION',
    subtitle: 'GitHub',
    color: 'cyan',
    duration: '10分',
    items: [
      { label: 'Self-introduction' },
      { label: 'Explain GITHUB (SLIDE)' },
    ],
  },
  {
    title: 'ADMINISTRATION',
    subtitle: 'ガバナンス',
    color: 'magenta',
    duration: '30分',
    items: [
      { label: 'Explain Repository Permissions' },
      { label: 'Explain Policies' },
      { label: 'Explain Copilot managed settings' },
      { label: 'Demo : Role + Policies' },
      { label: 'Explain Ricoh usecase' },
    ],
  },
  {
    title: 'REVIEW TOOL',
    subtitle: 'PR とブランチ戦略とRuleset',
    color: 'amber',
    duration: '15分',
    items: [
      { label: 'Explain PR' },
      { label: 'Explain Branching strategies' },
    ],
  },
  {
    title: 'COLLABORATION TOOLS',
    subtitle: 'Issues・Projects・Discussions',
    color: 'green',
    duration: '15分',
    items: [
      { label: 'Explain Collaboration tools' },
    ],
  },
  {
    title: 'TEST & SECURE',
    subtitle: 'GitHub Actions と GHAS',
    color: 'cyan',
    duration: '15分',
    items: [
      { label: 'Explain GitHub Actions' },
      { label: 'Explain Dependabot' },
      { label: 'Explain Code Scanning' },
      { label: 'Explain Secret Protection' },
    ],
  },
  {
    title: 'Q&A',
    subtitle: '質疑応答',
    color: 'amber',
    duration: '1時間30分',
    items: [
      { label: 'Open Q&A' },
    ],
  },
];

const objectivesGithub =
  locale === 'en'
    ? 'This GitHub workshop tours the GitHub platform basics — collaboration tools, pull requests and branching, GitHub Actions, and GHAS (Dependabot, Code Scanning, Secret Protection) — to build a solid foundation for team development and security.'
    : 'この GitHub ワークショップでは、GitHub プラットフォームの基本 ── コラボレーションツール、Pull Request とブランチ戦略、GitHub Actions、そして GHAS（Dependabot・Code Scanning・Secret Protection）── を一巡りして、チーム開発とセキュリティの土台を固める。';

const PLAYBOOK = 'https://theomonfort.github.io/theomonfort/playbook';

const ghasSections: Section[] = [
  {
    title: 'PREPARATION',
    subtitle: '登壇準備',
    color: 'amber',
    items: [
      { label: 'Have the AGENDA (This one) / GHAS, SECRET PROTECTION, CODE SCANNING, CODE QUALITY playbooks / ghas-test-1 open in the browser' },
      { label: 'Sign in as owner / security manager on octodemo (enterprise) and theomonfort-org' },
      { label: 'Check push protection, validity checks and delegated bypass are enabled on ghas-test-1' },
      { label: 'Check the CodeQL Advanced setup workflow has a recent green run on ghas-test-1' },
      { label: 'Check Code Quality is enabled on ghas-test-1 and the CODE REVIEW ORG LVL ruleset is active' },
      { label: 'Open a terminal in the local ghas-test-1 clone (push protection script)' },
      { label: 'Have a contributor account WITHOUT bypass privileges ready (bypass request demo)' },
    ],
  },
  {
    title: 'GHAS CONCEPT',
    subtitle: 'GHAS の全体像',
    color: 'cyan',
    duration: '20分',
    items: [
      { label: 'Self-introduction' },
      {
        label: 'Send following message in Teams',
        teams: [
          { label: 'GitHub Advanced Security', url: `${PLAYBOOK}/github-advanced-security/` },
          { label: 'Secret Protection', url: `${PLAYBOOK}/secret-scanning/` },
          { label: 'Code Scanning', url: `${PLAYBOOK}/code-scanning/` },
          { label: 'Code Quality', url: `${PLAYBOOK}/code-quality/` },
        ],
      },
      { label: "Explain WHY NOW: FIRST's four recommendations, data leaks in Japan (SLIDE)" },
      { label: "Explain HOW GHAS ANSWERS IT and WHAT'S INSIDE (SLIDE)" },
      { label: 'Explain WHO CAN DO WHAT and PRICING (SLIDE)' },
      { label: 'Explain RISK ASSESSMENTS and ENTERPRISE ROLLOUT (SLIDE)' },
      { label: 'Demo SECURITY OVERVIEW: Enterprise → Org → Repo (Overview, Coverage, Risk)' },
    ],
  },
  {
    title: 'SECRET PROTECTION',
    subtitle: 'シークレットの漏洩を止める',
    color: 'magenta',
    duration: '40分',
    items: [
      { label: 'Explain WHY SECRETS MATTER in private / internal repos (SLIDE)' },
      { label: 'Explain MAIN CAPABILITIES: push protection, merge protection, alerts, validity checks (SLIDE)' },
      {
        label: 'Demo PUSH PROTECTION: push a generated secret from ghas-test-1, the push is blocked',
        command: './demo/secret-scanning/01-push-protection.sh',
        commandCopyOnly: true,
      },
      { label: 'Demo PATTERN CONFIGURATIONS (octodemo): push-protected patterns, False positives / Bypass rate columns' },
      {
        label: "Demo BYPASS: open the unblock URL, compare “used in tests” vs “I'll fix it later”, push again, show who bypassed and why",
        command: 'git push origin HEAD',
        commandCopyOnly: true,
      },
      { label: 'Demo DELEGATED BYPASS: Security configuration → Bypass privileges → Specific actors, then contributor request → Approve / Deny' },
      { label: "Demo MERGE PROTECTION: ruleset “Require secret scanning alerts are resolved”, PR from the “fix later” branch is blocked" },
      { label: 'Demo VALIDITY CHECK: Secret scanning → Validity filter, triage Active secrets first' },
      { label: 'Explain WHAT GETS DETECTED: provider vs generic patterns (SLIDE)' },
      {
        label: 'Demo CUSTOM PATTERN: “Octodemo internal service token”, Save and dry run, then Publish',
        command: 'octodemo_(live|test)_[A-Za-z0-9]{32}',
        commandCopyOnly: true,
      },
      { label: 'Demo PUBLIC MONITORING: enterprise report vs repository alerts' },
      { label: 'Demo SECURITY CAMPAIGN: from secret scanning filters (Validity Active + Unknown), save as draft' },
      { label: 'Explain MY RECOMMENDED STARTING CHECKLIST (SLIDE)' },
    ],
  },
  {
    title: 'CODE SCANNING',
    subtitle: 'CodeQL と Autofix',
    color: 'amber',
    duration: '40分',
    items: [
      { label: 'Explain CODE SCANNING IS NOT CODEQL and HOW CODEQL WORKS (SLIDE)' },
      { label: 'Explain READING A CODEQL QUERY and WHAT CODEQL FINDS (SLIDE)' },
      { label: 'Explain MAIN CAPABILITIES: Default vs Advanced setup (SLIDE)' },
      { label: 'Demo ADVANCED SETUP: Settings → Advanced Security, codeql.yml (triggers, language matrix, build-mode, CERT / MISRA packs)' },
      { label: 'Demo CODEQL RUN: Actions → CodeQL per-language Analyze jobs, then Security → Code scanning alerts' },
      { label: 'Explain WHY SHIFT LEFT and COPILOT AUTOFIX (SLIDE)' },
      { label: 'Demo SECURITY BOT ON A PR (octodemo #57): CodeQL XSS vs AI Scan findings' },
      { label: 'Demo MERGE PROTECTION: ruleset “Require code scanning results” (High or higher / Errors), keep disabled' },
      { label: 'Demo AGENTIC AUTOFIX: org + repo settings, then Assign to Copilot on a backlog alert → draft PR' },
      { label: 'Explain AUTOFIX vs AGENTIC AUTOFIX (SLIDE)' },
      { label: 'Show AI SCAN controls (PRs / repositories / AI apps) without starting a paid scan' },
      { label: 'Demo SECURITY CAMPAIGN: from code scanning filters, save as draft' },
      { label: 'Explain PRICING: three meters and CODE SECURITY RISK ASSESSMENT (SLIDE)' },
    ],
  },
  {
    title: 'CODE QUALITY',
    subtitle: '品質ゲートと技術的負債',
    color: 'green',
    duration: '20分',
    items: [
      { label: 'Explain WHAT CODE QUALITY COVERS and LANGUAGE SUPPORT (SLIDE)' },
      { label: 'Explain CATCH ISSUES BEFORE MERGE (SLIDE)' },
      { label: 'Demo ENABLE: Org Settings → Code quality → Repository access, Repo Settings → Enable code quality' },
      { label: 'Demo PR GATE: Code Quality findings on a PR + Code quality rule in the CODE REVIEW ORG LVL ruleset' },
      { label: 'Demo STANDARD FINDINGS: Security and quality → Code quality, review and dismiss a finding' },
      { label: 'Demo AGENTIC AUTOFIX: select 1–25 findings → Assign to Copilot → review the PR' },
      { label: 'Demo MEASURE OVER TIME: Org → Insights → Code quality scores and trends' },
      { label: 'Explain WHO CAN DO WHAT and GA AVAILABILITY / BILLING (SLIDE)' },
    ],
  },
];

const objectivesGhas =
  locale === 'en'
    ? 'This GHAS workshop starts from why application security matters now, then walks through Secret Protection, Code Scanning and Code Quality with live demos: blocking leaks at push, gating merges, and fixing the backlog with Autofix and security campaigns.'
    : 'この GHAS ワークショップでは、いまアプリケーションセキュリティが重要な理由から始め、Secret Protection・Code Scanning・Code Quality をデモで一巡りする。push での漏洩ブロック、マージ前のゲート、そして Autofix とセキュリティキャンペーンでのバックログ解消までを体験する。';

const workshops: Record<WorkshopId, { label: string; title: string; time: string; sections: Section[]; objectives: string }> = {
  github: { label: 'GITHUB', title: 'GITHUB WORKSHOP', time: locale === 'en' ? '~3 hours' : '約3時間', sections: githubSections, objectives: objectivesGithub },
  copilot: { label: 'COPILOT', title: 'COPILOT WORKSHOP', time: locale === 'en' ? '~3 hours' : '約3時間', sections, objectives: objectivesText },
  ghas: { label: 'GHAS', title: 'GHAS WORKSHOP', time: locale === 'en' ? '~2 hours' : '約2時間', sections: ghasSections, objectives: objectivesGhas },
};

const w = { id: workshop, ...workshops[workshop] };
const totalItems = w.sections.reduce((n, s) => n + s.items.length, 0);
const tabOrder: WorkshopId[] = ['github', 'copilot', 'ghas'];
---

<Layout locale={locale} currentPath={currentPath} title={`${w.title} | Presenter Notes`}>
  <section class="max-w-3xl mx-auto px-4 py-12 md:py-16">
    <section class="ws-quest">
      <span class="ws-quest-time font-mono">⏱ {w.time}</span>
      <div class="ws-quest-grid">
        <div class="ws-quest-copy">
          <nav class="ws-switch flex items-center gap-2 mb-3" aria-label="Workshop">
            {tabOrder.map((id) => (
              <a
                href={localizedPath(locale, `/ws/${id}/`)}
                class:list={['ws-tab', { 'is-active': id === workshop }]}
                aria-current={id === workshop ? 'page' : undefined}
              >{workshops[id].label}</a>
            ))}
          </nav>
          <h1 id="ws-title" class="ws-quest-title font-display">{w.title}</h1>
          <div id="ws-quest-body">
            <p id="ws-objectives" class="ws-quest-sum font-body">{w.objectives}</p>
            <div id="ws-progress" class="ws-quest-progress">
              <div class="ws-exp">
                <span class="ws-exp-tag">EXP</span>
                <div class="ws-track">
                  <div id="ws-bar" class="ws-bar-fill" style="width:0%"></div>
                  <div class="ws-exp-ticks" aria-hidden="true">
                    {Array.from({ length: 12 }).map(() => <span></span>)}
                  </div>
                </div>
                <span id="ws-count" class="ws-exp-count">0 / {totalItems}</span>
              </div>
              <div class="ws-exp-ctrls">
                <button id="ws-expand" type="button" class="ws-exp-btn">EXPAND</button>
                <button id="ws-collapse" type="button" class="ws-exp-btn">COLLAPSE</button>
                <button id="ws-reset" type="button" class="ws-exp-btn reset">RESET</button>
              </div>
            </div>
          </div>
        </div>
        <div class="ws-quest-mascot" aria-hidden="true">
          <img src="/theomonfort/favicon.svg" alt="" width="160" height="160" />
        </div>
      </div>
    </section>

    {(() => {
      let counter = 0;
      return (
      <div id={`ws-notes-${w.id}`} class="ws-panel" data-workshop={w.id}>

    <div class="ws-secs" data-total={totalItems} data-workshop={w.id}>
      {w.sections.map((section, si) => {
        const c = COLORS[section.color];
        return (
          <details class="ws-section" data-section={`${w.id}-${section.sectionIndex ?? si}`} style={`--c:${c.cssVar}`} open>
            <summary class={`ws-summary flex items-center gap-3 cursor-pointer select-none px-2.5 py-2.5 rounded-[var(--radius-card)] ${c.text}`}>
              <span class="ws-node shrink-0" aria-hidden="true"></span>
              <span class="ws-chevron font-mono text-xs transition-transform duration-200">▶</span>
              <h2 class="font-display text-sm md:text-base font-bold tracking-[0.08em] leading-tight flex-1">
                {section.duration && <span class="ws-duration font-mono text-xs font-medium normal-case opacity-90 mr-1.5">（~{section.duration}）</span>}
                <span class="uppercase">{section.title}</span>
                {section.subtitle && <span class="ws-subtitle font-body"> : {section.subtitle}</span>}
              </h2>
              <button type="button" class="ws-check-all font-mono" aria-label="Toggle all items in this section">✓ ALL</button>
              <span class="ws-section-count font-mono text-xs font-semibold opacity-90">0 / {section.items.length}</span>
            </summary>
            {section.note && <p class="font-body text-sm text-phosphor px-2.5 py-2">{section.note}</p>}
            <ul class="ws-list ml-[6px] pl-5 py-1 space-y-0.5">
              {section.items.map((item) => {
                counter = item.checklistIndex ?? counter;
                const id = `ws-${w.id}-${item.checklistKey ?? counter++}`;
                const copyText = item.teams
                  ? item.teams.map((t) => `${t.label}\n${t.url}`).join('\n\n')
                  : item.commandCopyOnly ? item.command : undefined;
                const stepKind = item.stepKind ?? (
                  section.title === 'PREPARATION'
                    ? 'prep'
                    : /^(explain|summarize|candidate explanations)\b/i.test(item.label)
                      ? 'explain'
                      : /^(demo|show|send prompt)\b/i.test(item.label)
                        ? 'demo'
                        : section.title === 'INTRODUCTION'
                          ? 'explain'
                          : '');
                return (
                  <li>
                    <label
                      class="ws-row group flex items-start gap-3 cursor-pointer px-2.5 py-2 rounded-[var(--radius-card)] border border-transparent hover:border-neon-cyan/25 hover:bg-deep-purple/65 transition-colors"
                      for={id}
                    >
                      <input type="checkbox" id={id} class={`ws-check mt-0.5 h-4 w-4 shrink-0 ${c.accent} cursor-pointer`} />
                      <span class="ws-label font-body text-sm md:text-[15px] text-phosphor leading-snug">
                        {stepKind === 'explain' && <span class="ws-step-ico" aria-hidden="true">💬</span>}
                        {stepKind === 'prep' && <span class="ws-step-ico" aria-hidden="true">🛠️</span>}
                        {stepKind === 'demo' && <img class="ws-step-ico ws-step-demo" src="/theomonfort/icons/arcade-machine.png" alt="" />}
                        {item.label}
                      </span>
                      {copyText && (
                        <button type="button" class="ws-copy shrink-0" data-clip={copyText} data-copy-command={item.commandCopyOnly ? '' : undefined} aria-label={item.commandCopyOnly ? 'Copy demo command' : 'Copy Teams message'}>
                          <span class="ws-copy-icon" aria-hidden="true">📋</span>
                          <span class="ws-copy-text" role="status" aria-live="polite" aria-atomic="true">Copy</span>
                        </button>
                      )}
                    </label>
                    {item.command && !item.commandCopyOnly && (
                      <div class="ml-9 mr-2.5 mb-3 space-y-2">
                        {item.note && <p class="font-body text-sm text-phosphor">{item.note}</p>}
                        <pre class="whitespace-pre-wrap break-words bg-midnight border border-neon-cyan/25 rounded-[var(--radius-card)] p-2.5 text-sm text-phosphor"><code class="font-mono">{item.command}</code></pre>
                      </div>
                    )}
                  </li>
                );
              })}
            </ul>
          </details>
        );
      })}
    </div>
    </div>
      );
    })()}
  </section>
</Layout>

