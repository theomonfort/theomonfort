---
import Layout from '../layout/Layout.astro';
import { localizedPath, siteCopy, type Locale } from '../../lib/i18n';

interface Props {
  locale?: Locale;
}
const { locale = 'ja' } = Astro.props;
const t = siteCopy[locale];
---

<Layout locale={locale} currentPath="/secret" title={t.secret.title}>
  <section class="max-w-2xl mx-auto px-4 py-20 text-center">
    <div>
      <p class="inline-flex items-center px-3 py-1 rounded-[3px] border border-crt-amber/35 bg-crt-amber/10 font-mono text-xs font-semibold text-crt-amber mb-4 tracking-[0.22em] uppercase">{t.secret.area}</p>
      <h1 class="font-display font-bold text-3xl md:text-5xl text-phosphor tracking-[0.06em] mb-4 drop-shadow-[0_2px_18px_rgba(147,168,255,0.28)]">
        {t.secret.heading}
      </h1>
      <p class="font-body font-semibold text-xl md:text-2xl text-neon-cyan mb-10">{t.secret.found}</p>
    </div>

    <div class="secret-hud-card rounded-[3px] p-8 text-left">
      <p class="font-body text-base text-phosphor leading-loose mb-5 text-center">
        {t.secret.intro}
      </p>
      <p class="font-body text-sm text-phosphor-body leading-relaxed text-center">
        {t.secret.body.split('\n').map((part, i) => <>{i > 0 && <br />}{part}</>)}
      </p>

      <div class="mt-7 pt-5 border-t border-neon-cyan/20">
        <p class="font-mono text-xs font-semibold text-crt-amber mb-3 tracking-[0.18em] uppercase">{t.secret.recommendationsHeading}</p>
        <ul class="space-y-2.5 font-body text-sm">
          <li>
            <a href={t.secret.interviewUrl} target="_blank" rel="noopener noreferrer"
               class="retro-link inline-flex items-start gap-2">
              <span aria-hidden="true" class="text-crt-amber">▶</span>
              <span>{t.secret.interviewLabel}</span>
            </a>
          </li>
          <li>
            <a href={t.secret.albumUrl} target="_blank" rel="noopener noreferrer"
               class="retro-link inline-flex items-start gap-2">
              <span aria-hidden="true" class="text-crt-amber">▶</span>
              <span>{t.secret.albumLabel}</span>
            </a>
          </li>
        </ul>
      </div>
    </div>

    <div class="mt-10 space-y-4 font-mono text-xs">
      <p class="text-gb-green font-semibold tracking-[0.08em]">{t.secret.stat}</p>
      <a href={localizedPath(locale, '/')} class="inline-block px-5 py-2.5 rounded-[3px] font-semibold tracking-[0.06em] border border-neon-cyan/40 bg-deep-purple/80 text-neon-cyan hover:bg-neon-cyan hover:text-shadow-ink transition-colors">
        {t.common.backHome}
      </a>
    </div>
  </section>
</Layout>

<style>
  .secret-hud-card {
    background-color: rgba(11, 20, 32, 0.86);
    background-image: linear-gradient(
      90deg,
      #fcd34d 0%,
      rgba(252, 211, 77, 0.30) 55%,
      transparent 100%
    );
    background-size: 100% 2px;
    background-position: top left;
    background-repeat: no-repeat;
    border: 1px solid rgba(252, 211, 77, 0.32);
    backdrop-filter: blur(10px);
    box-shadow: 0 12px 32px rgba(4, 8, 14, 0.45);
  }
</style>
