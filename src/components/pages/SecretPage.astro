---
import Layout from '../layout/Layout.astro';
import { localizedPath, siteCopy, type Locale } from '../../lib/i18n';

interface Props {
  locale?: Locale;
}
const { locale = 'ja' } = Astro.props;
const t = siteCopy[locale];
---

<Layout locale={locale} currentPath="/secret" title={t.secret.title}>
  <section class="max-w-2xl mx-auto px-4 py-20 text-center">
    <div class="secret-header">
      <p class="secret-eyebrow inline-flex items-center px-3 py-1 rounded-[var(--radius-ui)] border border-crt-amber/35 bg-crt-amber/10 font-mono text-xs font-semibold text-crt-amber mb-4 tracking-[0.22em] uppercase">{t.secret.area}</p>
      <h1 class="secret-title font-display font-bold text-3xl md:text-5xl text-phosphor tracking-[0.06em] mb-4 drop-shadow-[0_2px_18px_rgb(var(--rgb-neon-magenta)/0.28)]">
        {t.secret.heading}
      </h1>
      <p class="secret-found font-body font-semibold text-xl md:text-2xl text-neon-cyan mb-10">{t.secret.found}</p>
    </div>

    <div class="secret-hud-card rounded-[var(--radius-card)] p-8 text-left">
      <p class="font-body text-base text-phosphor leading-loose mb-5 text-center">
        {t.secret.intro}
      </p>
      <p class="font-body text-sm text-phosphor-body leading-relaxed text-center">
        {t.secret.body.split('\n').map((part, i) => <>{i > 0 && <br />}{part}</>)}
      </p>

      <div class="secret-rec-box mt-7 pt-5 border-t border-neon-cyan/20">
        <p class="secret-rec-heading font-mono text-xs font-semibold text-crt-amber mb-3 tracking-[0.18em] uppercase">{t.secret.recommendationsHeading}</p>
        <ul class="space-y-2.5 font-body text-sm">
          <li>
            <a href={t.secret.interviewUrl} target="_blank" rel="noopener noreferrer"
               class="retro-link inline-flex items-start gap-2">
              <span aria-hidden="true" class="text-crt-amber">▶</span>
              <span>{t.secret.interviewLabel}</span>
            </a>
          </li>
          <li>
            <a href={t.secret.albumUrl} target="_blank" rel="noopener noreferrer"
               class="retro-link inline-flex items-start gap-2">
              <span aria-hidden="true" class="text-crt-amber">▶</span>
              <span>{t.secret.albumLabel}</span>
            </a>
          </li>
        </ul>
      </div>
    </div>

    <div class="secret-footer mt-10 space-y-4 font-mono text-xs">
      <p class="text-gb-green font-semibold tracking-[0.08em]">{t.secret.stat}</p>
      <a href={localizedPath(locale, '/')} class="secret-back-btn inline-block px-5 py-2.5 rounded-[var(--radius-ui)] font-semibold tracking-[0.06em] border border-neon-cyan/40 bg-deep-purple/80 text-neon-cyan hover:bg-neon-cyan hover:text-shadow-ink transition-colors">
        {t.common.backHome}
      </a>
    </div>
  </section>
</Layout>

<style>
  .secret-hud-card {
    background-color: var(--c-bg-elevated);
    background-image: linear-gradient(
      90deg,
      var(--c-crt-amber) 0%,
      rgb(var(--rgb-crt-amber) / 0.30) 55%,
      transparent 100%
    );
    background-size: 100% 2px;
    background-position: top left;
    background-repeat: no-repeat;
    border: 1px solid rgb(var(--rgb-crt-amber) / 0.32);
    backdrop-filter: blur(10px);
    box-shadow: 0 12px 32px rgb(var(--rgb-shadow-ink) / 0.45);
  }

  :global(html[data-theme='retro']) .secret-eyebrow {
    font-family: 'Press Start 2P', monospace;
    font-size: 10px;
    letter-spacing: 0.4em;
    background: transparent;
    border-color: transparent;
    padding: 0;
  }
  :global(html[data-theme='retro']) .secret-title {
    font-family: 'Press Start 2P', monospace;
    color: var(--c-neon-magenta);
    filter: drop-shadow(0 0 12px rgb(var(--rgb-neon-magenta) / 0.7));
  }
  :global(html[data-theme='retro']) .secret-found {
    font-family: 'DotGothic16', sans-serif;
  }
  :global(html[data-theme='retro']) .secret-hud-card {
    background-image: none;
    background-color: rgb(var(--rgb-shadow-ink) / 0.9);
    border: 4px solid var(--c-crt-amber);
    border-radius: 0;
    backdrop-filter: none;
    box-shadow: 4px 4px 0 var(--c-shadow-ink), var(--shadow-neon-amber);
  }
  :global(html[data-theme='retro']) .secret-rec-box {
    border-top-color: rgb(var(--rgb-crt-amber) / 0.35);
  }
  :global(html[data-theme='retro']) .secret-rec-heading,
  :global(html[data-theme='retro']) .secret-footer {
    font-family: 'Press Start 2P', monospace;
    font-size: 10px;
  }
  :global(html[data-theme='retro']) .secret-back-btn {
    border: 2px solid var(--c-neon-magenta);
    border-radius: 0;
    background: transparent;
    color: var(--c-neon-magenta);
    box-shadow: 4px 4px 0 var(--c-shadow-ink);
  }
  :global(html[data-theme='retro']) .secret-back-btn:hover {
    background: var(--c-neon-magenta);
    color: var(--c-shadow-ink);
  }
</style>
