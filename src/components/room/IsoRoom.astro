---
import { accentClasses, type AccentColor } from '../../lib/theme';
import { localizedPath, type Locale } from '../../lib/i18n';

// Pure-CSS/SVG isometric retro room.
// Each "furniture" is a clickable nav target with its own pixel-art look.
interface RoomItem {
  href: string;
  label: string;
  en: string;
  icon: string;
  color: AccentColor;
  desc: string;
  pos: string;
  external?: boolean;
}

interface Props {
  locale?: Locale;
}
const { locale = 'ja' } = Astro.props;

const items: RoomItem[] = [
  {
    href: localizedPath(locale, '/playbook'),
    label: locale === 'ja' ? '本棚' : 'Bookshelf',
    en: 'PLAYBOOK',
    icon: '📚',
    color: 'amber',
    desc: locale === 'ja' ? 'プレイブック' : 'Playbook',
    pos: 'col-start-1 row-start-1',
  },
  {
    href: localizedPath(locale, '/skills'),
    label: locale === 'ja' ? 'チェスト' : 'Chest',
    en: 'EQUIPMENT',
    icon: '🗃️',
    color: 'magenta',
    desc: locale === 'ja' ? '装備所' : 'Equipment',
    pos: 'col-start-2 row-start-1',
  },
  {
    href: 'https://github.com/theomonfort',
    label: locale === 'ja' ? 'ファミコン' : 'Console',
    en: 'GITHUB',
    icon: '🎮',
    color: 'magenta',
    desc: locale === 'ja' ? 'ソースコード' : 'Source code',
    pos: 'col-start-3 row-start-2',
    external: true,
  },
];

const TONE_HEX: Record<AccentColor, string> = {
  cyan: '#5eead4',
  green: '#86efac',
  magenta: '#93a8ff',
  amber: '#fcd34d',
};
---

<div class="iso-room relative w-full max-w-5xl">
  <!-- Coordinate floor (isometric grid backdrop) -->
  <div class="iso-floor absolute inset-x-0 -bottom-6 h-48 pointer-events-none" aria-hidden="true"></div>

  <!-- Window: distant Tokyo skyline -->
  <div class="window absolute -top-4 right-4 md:right-12 w-44 h-28 pointer-events-none hidden sm:block" aria-hidden="true">
    <div class="window-frame">
      <div class="skyline">
        <div class="moon"></div>
        <div class="building b1"></div>
        <div class="building b2"></div>
        <div class="building b3"></div>
        <div class="building b4"></div>
        <div class="building b5"></div>
      </div>
    </div>
  </div>

  <!-- Furniture grid -->
  <div class="relative grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 md:gap-6 z-10">
    {items.map((item) => {
      const c = accentClasses[item.color];
      const tone = TONE_HEX[item.color];
      return (
        <a
          href={item.href}
          target={item.external ? '_blank' : undefined}
          rel={item.external ? 'noopener noreferrer' : undefined}
          style={`--item-tone:${tone}`}
          class="furniture group relative block p-5 transition-all duration-200 hover:-translate-y-0.5"
          data-sfx="select"
        >
          <div class="flex items-center gap-3 mb-2.5">
            <span class="text-3xl md:text-4xl group-hover:scale-105 transition-transform">{item.icon}</span>
            <div>
              <div class={`font-mono text-[11px] font-semibold tracking-[0.1em] ${c.text}`}>{item.en}</div>
              <div class="font-body font-bold text-base text-phosphor group-hover:text-neon-cyan transition-colors">{item.desc}</div>
            </div>
          </div>
          <div class="font-mono text-[11px] text-phosphor-muted group-hover:text-phosphor-body transition-colors">
            ▶ {item.label}
          </div>
          <span class="absolute top-2 right-2.5 font-mono text-[10px] font-semibold tracking-[0.08em] text-phosphor-muted/70 group-hover:text-neon-cyan transition-colors">
            ENTER
          </span>
        </a>
      );
    })}
  </div>
</div>

<script>
  function initIsoRoom() {
    const root = document.querySelector<HTMLElement>('.iso-room');
    if (!root || root.dataset.isoInit === '1') return;
    root.dataset.isoInit = '1';

    import('../../lib/sfx').then(({ play }) => {
      root.querySelectorAll<HTMLElement>('.furniture').forEach((el) => {
        el.addEventListener('mouseenter', () => play('hover'));
        el.addEventListener('click', () => play('select'));
      });
    });
  }

  const win = window as Window & typeof globalThis & {
    __akqIsoRoomBound?: boolean;
  };

  initIsoRoom();
  if (!win.__akqIsoRoomBound) {
    document.addEventListener('astro:page-load', initIsoRoom);
    win.__akqIsoRoomBound = true;
  }
</script>

<style>
  .iso-floor {
    background-image:
      linear-gradient(to right, rgba(94, 234, 212, 0.10) 1px, transparent 1px),
      linear-gradient(to bottom, rgba(94, 234, 212, 0.10) 1px, transparent 1px);
    background-size: 28px 28px;
    transform: perspective(700px) rotateX(60deg);
    transform-origin: top;
    mask-image: linear-gradient(to bottom, rgba(0, 0, 0, 1), rgba(0, 0, 0, 0));
  }

  .window {
    z-index: 0;
  }
  .window-frame {
    position: relative;
    width: 100%;
    height: 100%;
    background: linear-gradient(to bottom, #04080e 0%, #0b1420 100%);
    border: 1px solid rgba(94, 234, 212, 0.32);
    border-radius: 3px;
    box-shadow:
      inset 0 0 0 1px rgba(147, 168, 255, 0.14),
      0 8px 20px rgba(4, 8, 14, 0.65);
    overflow: hidden;
  }
  .window-frame::after {
    content: '';
    position: absolute;
    inset: 0;
    background:
      linear-gradient(to right, transparent 49.2%, rgba(94, 234, 212, 0.2) 49.2%, rgba(94, 234, 212, 0.2) 50.8%, transparent 50.8%),
      linear-gradient(to bottom, transparent 49.2%, rgba(94, 234, 212, 0.2) 49.2%, rgba(94, 234, 212, 0.2) 50.8%, transparent 50.8%);
    pointer-events: none;
  }
  .skyline { position: absolute; inset: 0; }
  .moon {
    position: absolute;
    top: 6px;
    right: 12px;
    width: 14px;
    height: 14px;
    background: #fcd34d;
    box-shadow: 0 0 12px rgba(252, 211, 77, 0.7), 0 0 4px #ecf7fb;
    border-radius: 999px;
  }
  .building {
    position: absolute;
    bottom: 0;
    background: #93a8ff;
    box-shadow: inset 0 0 0 1px #04080e;
  }
  .b1 { left: 0;   width: 18px; height: 50%; background: #5eead4; opacity: 0.7; }
  .b2 { left: 22px; width: 14px; height: 70%; background: #93a8ff; opacity: 0.8; }
  .b3 { left: 40px; width: 22px; height: 45%; background: #fcd34d; opacity: 0.6; }
  .b4 { left: 66px; width: 16px; height: 80%; background: #5eead4; opacity: 0.7; }
  .b5 { left: 86px; width: 20px; height: 55%; background: #86efac; opacity: 0.65; }

  .furniture {
    --item-tone: #5eead4;
    border-radius: 3px;
    border: 1px solid color-mix(in srgb, var(--item-tone) 24%, rgba(94, 234, 212, 0.16));
    background-color: rgba(11, 20, 32, 0.86);
    background-image: linear-gradient(
      90deg,
      var(--item-tone) 0%,
      color-mix(in srgb, var(--item-tone) 30%, transparent) 55%,
      transparent 100%
    );
    background-size: 100% 2px;
    background-position: top left;
    background-repeat: no-repeat;
    backdrop-filter: blur(10px);
    box-shadow: 0 8px 24px rgba(4, 8, 14, 0.35);
  }
  .furniture:hover {
    background-color: rgba(16, 29, 45, 0.95);
    border-color: color-mix(in srgb, var(--item-tone) 55%, rgba(94, 234, 212, 0.16));
    box-shadow: 0 12px 28px rgba(4, 8, 14, 0.5), 0 0 18px color-mix(in srgb, var(--item-tone) 16%, transparent);
  }
</style>
