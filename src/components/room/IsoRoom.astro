---
import { accentClasses, type AccentColor } from '../../lib/theme';
import { localizedPath, type Locale } from '../../lib/i18n';

// Pure-CSS/SVG isometric retro room.
// Each "furniture" is a clickable nav target with its own pixel-art look.
interface RoomItem {
  href: string;
  label: string;
  en: string;
  icon: string;
  color: AccentColor;
  desc: string;
  pos: string;
  external?: boolean;
}

interface Props {
  locale?: Locale;
}
const { locale = 'ja' } = Astro.props;

const items: RoomItem[] = [
  {
    href: localizedPath(locale, '/playbook'),
    label: locale === 'ja' ? '本棚' : 'Bookshelf',
    en: 'PLAYBOOK',
    icon: '📚',
    color: 'amber',
    desc: locale === 'ja' ? 'プレイブック' : 'Playbook',
    pos: 'col-start-1 row-start-1',
  },
  {
    href: localizedPath(locale, '/skills'),
    label: locale === 'ja' ? 'チェスト' : 'Chest',
    en: 'EQUIPMENT',
    icon: '🗃️',
    color: 'magenta',
    desc: locale === 'ja' ? '装備所' : 'Equipment',
    pos: 'col-start-2 row-start-1',
  },
  {
    href: 'https://github.com/theomonfort',
    label: locale === 'ja' ? 'ファミコン' : 'Console',
    en: 'GITHUB',
    icon: '🎮',
    color: 'magenta',
    desc: locale === 'ja' ? 'ソースコード' : 'Source code',
    pos: 'col-start-3 row-start-2',
    external: true,
  },
];

const TONE_CSS: Record<AccentColor, string> = {
  cyan: 'var(--c-neon-cyan)',
  green: 'var(--c-gb-green)',
  magenta: 'var(--c-neon-magenta)',
  amber: 'var(--c-crt-amber)',
};
---

<div class="iso-room relative w-full max-w-5xl">
  <!-- Coordinate floor (isometric grid backdrop) -->
  <div class="iso-floor absolute inset-x-0 -bottom-6 h-48 pointer-events-none" aria-hidden="true"></div>

  <!-- Window: distant Tokyo skyline -->
  <div class="window absolute -top-4 right-4 md:right-12 w-44 h-28 pointer-events-none hidden sm:block" aria-hidden="true">
    <div class="window-frame">
      <div class="skyline">
        <div class="moon"></div>
        <div class="building b1"></div>
        <div class="building b2"></div>
        <div class="building b3"></div>
        <div class="building b4"></div>
        <div class="building b5"></div>
      </div>
    </div>
  </div>

  <!-- Furniture grid -->
  <div class="relative grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 md:gap-6 z-10">
    {items.map((item) => {
      const c = accentClasses[item.color];
      const tone = TONE_CSS[item.color];
      return (
        <a
          href={item.href}
          target={item.external ? '_blank' : undefined}
          rel={item.external ? 'noopener noreferrer' : undefined}
          style={`--item-tone:${tone}`}
          class="furniture group relative block p-5 transition-all duration-200 hover:-translate-y-0.5"
          data-sfx="select"
        >
          <div class="flex items-center gap-3 mb-2.5">
            <span class="text-3xl md:text-4xl group-hover:scale-105 transition-transform">{item.icon}</span>
            <div>
              <div class={`furniture-en font-mono text-[11px] font-semibold tracking-[0.1em] ${c.text}`}>{item.en}</div>
              <div class="furniture-desc font-body font-bold text-base text-phosphor group-hover:text-neon-cyan transition-colors">{item.desc}</div>
            </div>
          </div>
          <div class="furniture-label font-mono text-[11px] text-phosphor-muted group-hover:text-phosphor-body transition-colors">
            ▶ {item.label}
          </div>
          <span class="furniture-enter absolute top-2 right-2.5 font-mono text-[10px] font-semibold tracking-[0.08em] text-phosphor-muted/70 group-hover:text-neon-cyan transition-colors">
            ENTER
          </span>
        </a>
      );
    })}
  </div>
</div>

<script>
  function initIsoRoom() {
    const root = document.querySelector<HTMLElement>('.iso-room');
    if (!root || root.dataset.isoInit === '1') return;
    root.dataset.isoInit = '1';

    import('../../lib/sfx').then(({ play }) => {
      root.querySelectorAll<HTMLElement>('.furniture').forEach((el) => {
        el.addEventListener('mouseenter', () => play('hover'));
        el.addEventListener('click', () => play('select'));
      });
    });
  }

  const win = window as Window & typeof globalThis & {
    __akqIsoRoomBound?: boolean;
  };

  initIsoRoom();
  if (!win.__akqIsoRoomBound) {
    document.addEventListener('astro:page-load', initIsoRoom);
    win.__akqIsoRoomBound = true;
  }
</script>

<style>
  .iso-floor {
    background-image:
      linear-gradient(to right, rgb(var(--rgb-neon-cyan) / 0.10) 1px, transparent 1px),
      linear-gradient(to bottom, rgb(var(--rgb-neon-cyan) / 0.10) 1px, transparent 1px);
    background-size: 28px 28px;
    transform: perspective(700px) rotateX(60deg);
    transform-origin: top;
    mask-image: linear-gradient(to bottom, rgba(0, 0, 0, 1), rgba(0, 0, 0, 0));
  }

  .window {
    z-index: 0;
  }
  .window-frame {
    position: relative;
    width: 100%;
    height: 100%;
    background: linear-gradient(to bottom, var(--c-shadow-ink) 0%, var(--c-deep-purple) 100%);
    border: 1px solid var(--c-border-strong);
    border-radius: var(--radius-card);
    box-shadow:
      inset 0 0 0 1px rgb(var(--rgb-neon-magenta) / 0.14),
      0 8px 20px rgb(var(--rgb-shadow-ink) / 0.65);
    overflow: hidden;
  }
  .window-frame::after {
    content: '';
    position: absolute;
    inset: 0;
    background:
      linear-gradient(to right, transparent 49.2%, rgb(var(--rgb-neon-cyan) / 0.2) 49.2%, rgb(var(--rgb-neon-cyan) / 0.2) 50.8%, transparent 50.8%),
      linear-gradient(to bottom, transparent 49.2%, rgb(var(--rgb-neon-cyan) / 0.2) 49.2%, rgb(var(--rgb-neon-cyan) / 0.2) 50.8%, transparent 50.8%);
    pointer-events: none;
  }
  .skyline { position: absolute; inset: 0; }
  .moon {
    position: absolute;
    top: 6px;
    right: 12px;
    width: 14px;
    height: 14px;
    background: var(--c-crt-amber);
    box-shadow: 0 0 12px rgb(var(--rgb-crt-amber) / 0.7), 0 0 4px var(--c-phosphor);
    border-radius: 999px;
  }
  .building {
    position: absolute;
    bottom: 0;
    background: var(--c-neon-magenta);
    box-shadow: inset 0 0 0 1px var(--c-shadow-ink);
  }
  .b1 { left: 0;   width: 18px; height: 50%; background: var(--c-neon-cyan); opacity: 0.7; }
  .b2 { left: 22px; width: 14px; height: 70%; background: var(--c-neon-magenta); opacity: 0.8; }
  .b3 { left: 40px; width: 22px; height: 45%; background: var(--c-crt-amber); opacity: 0.6; }
  .b4 { left: 66px; width: 16px; height: 80%; background: var(--c-neon-cyan); opacity: 0.7; }
  .b5 { left: 86px; width: 20px; height: 55%; background: var(--c-gb-green); opacity: 0.65; }

  .furniture {
    --item-tone: var(--c-neon-cyan);
    border-radius: var(--radius-card);
    border: 1px solid color-mix(in srgb, var(--item-tone) 24%, var(--c-border));
    background-color: var(--c-bg-elevated);
    background-image: linear-gradient(
      90deg,
      var(--item-tone) 0%,
      color-mix(in srgb, var(--item-tone) 30%, transparent) 55%,
      transparent 100%
    );
    background-size: 100% 2px;
    background-position: top left;
    background-repeat: no-repeat;
    backdrop-filter: blur(10px);
    box-shadow: 0 8px 24px rgb(var(--rgb-shadow-ink) / 0.35);
  }
  .furniture:hover {
    background-color: var(--c-bg-elevated-hover);
    border-color: color-mix(in srgb, var(--item-tone) 55%, var(--c-border));
    box-shadow: 0 12px 28px rgb(var(--rgb-shadow-ink) / 0.5), 0 0 18px color-mix(in srgb, var(--item-tone) 16%, transparent);
  }

  /* Retro JRPG overrides */
  :global(html[data-theme='retro']) .iso-floor {
    background-image:
      linear-gradient(to right, rgb(var(--rgb-gb-green) / 0.08) 1px, transparent 1px),
      linear-gradient(to bottom, rgb(var(--rgb-gb-green) / 0.08) 1px, transparent 1px);
    background-size: 32px 32px;
  }
  :global(html[data-theme='retro']) .window-frame {
    border: 4px solid color-mix(in srgb, var(--c-deep-purple) 78%, var(--c-neon-magenta));
    border-radius: 0;
    box-shadow:
      inset 0 0 0 2px color-mix(in srgb, var(--c-deep-purple) 62%, var(--c-phosphor)),
      4px 4px 0 var(--c-shadow-ink);
  }
  :global(html[data-theme='retro']) .window-frame::after {
    background:
      linear-gradient(to right, transparent 49%, color-mix(in srgb, var(--c-deep-purple) 78%, var(--c-neon-magenta)) 49%, color-mix(in srgb, var(--c-deep-purple) 78%, var(--c-neon-magenta)) 51%, transparent 51%),
      linear-gradient(to bottom, transparent 49%, color-mix(in srgb, var(--c-deep-purple) 78%, var(--c-neon-magenta)) 49%, color-mix(in srgb, var(--c-deep-purple) 78%, var(--c-neon-magenta)) 51%, transparent 51%);
  }
  :global(html[data-theme='retro']) .moon {
    border-radius: 0;
    box-shadow: 0 0 12px var(--c-crt-amber), 0 0 4px var(--c-phosphor);
  }
  :global(html[data-theme='retro']) .b5 {
    background: var(--c-neon-magenta);
    opacity: 0.6;
  }
  :global(html[data-theme='retro']) .furniture {
    image-rendering: pixelated;
    border-radius: 0;
    border: 2px solid var(--item-tone);
    background-image: none;
    background-color: rgb(var(--rgb-shadow-ink) / 0.85);
    backdrop-filter: none;
    box-shadow: 4px 4px 0 var(--c-shadow-ink), 0 0 14px color-mix(in srgb, var(--item-tone) 32%, transparent);
  }
  :global(html[data-theme='retro']) .furniture::before {
    content: '';
    position: absolute;
    inset: -4px;
    border: 2px solid transparent;
    pointer-events: none;
    transition: border-color 0.2s ease, opacity 0.2s ease;
  }
  :global(html[data-theme='retro']) .furniture:hover::before {
    border-color: var(--item-tone);
    opacity: 0.35;
  }
  :global(html[data-theme='retro']) .furniture-en {
    font-family: 'Press Start 2P', monospace;
    font-size: 10px;
  }
  :global(html[data-theme='retro']) .furniture-desc {
    font-family: 'DotGothic16', sans-serif;
  }
  :global(html[data-theme='retro']) .furniture-enter {
    font-family: 'Press Start 2P', monospace;
    font-size: 8px;
  }
  :global(html[data-theme='retro']) .furniture:hover .furniture-enter {
    color: var(--c-neon-magenta);
  }
</style>
