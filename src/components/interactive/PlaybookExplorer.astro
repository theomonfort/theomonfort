  .galaxy-detail h4 img { object-fit: contain; }
  .galaxy-detail a {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-family: var(--font-mono-hud), var(--font-prose);
    font-weight: 600;
    color: var(--sector-color);
    background: color-mix(in srgb, var(--sector-color) 10%, transparent);
    border: 1px solid color-mix(in srgb, var(--sector-color) 45%, transparent);
    border-radius: var(--radius-ui);
