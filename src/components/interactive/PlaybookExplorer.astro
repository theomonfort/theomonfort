    padding: .48rem .55rem;
    font-size: .84rem;
    color: var(--c-fg-body);
    border: 1px solid transparent;
    border-radius: var(--radius-ui);
    transition: background .15s ease, border-color .15s ease, color .15s ease;
  }
  .galaxy-missions button > span {
    color: var(--sector-color);
