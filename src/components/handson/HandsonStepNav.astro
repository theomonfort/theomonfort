---
import { localizedPath, type Locale } from '../../lib/i18n';
import {
  type LocalizedHandsonEntry,
  handsonCategoryForSlug,
  handsonCategoryMeta,
  handsonStepTitle,
} from '../../lib/handson';

interface Props {
  prev: LocalizedHandsonEntry | null;
  next: LocalizedHandsonEntry | null;
  locale: Locale;
  prevLabel: string;
  nextLabel: string;
}
const { prev, next, locale, prevLabel, nextLabel } = Astro.props;

const prevAccent = prev ? handsonCategoryMeta(handsonCategoryForSlug(prev.slug), locale).accent : undefined;
const nextAccent = next ? handsonCategoryMeta(handsonCategoryForSlug(next.slug), locale).accent : undefined;
---

<nav class="handson-step-nav" aria-label="Step navigation">
  {prev ? (
    <a
      href={localizedPath(locale, `/handson/${prev.slug}`)}
      class="step-nav-card prev"
      rel="prev"
      data-handson-prev
      style={`--nav-accent:${prevAccent}`}
    >
      <span class="step-nav-label font-mono text-[11px] font-semibold tracking-[0.08em] uppercase text-phosphor-muted">◀ {prevLabel}</span>
      <span class="step-nav-title font-body text-sm md:text-base mt-1 block">
        {String(prev.entry.data.order).padStart(2, '0')} · {handsonStepTitle(prev)}
      </span>
    </a>
  ) : <span class="step-nav-card placeholder" aria-hidden="true"></span>}
  {next ? (
    <a
      href={localizedPath(locale, `/handson/${next.slug}`)}
      class="step-nav-card next"
      rel="next"
      data-handson-next
      style={`--nav-accent:${nextAccent}`}
    >
      <span class="step-nav-label font-mono text-[11px] font-semibold tracking-[0.08em] uppercase text-phosphor-muted text-right block">{nextLabel} ▶</span>
      <span class="step-nav-title font-body text-sm md:text-base mt-1 block text-right">
        {String(next.entry.data.order).padStart(2, '0')} · {handsonStepTitle(next)}
      </span>
    </a>
  ) : <span class="step-nav-card placeholder" aria-hidden="true"></span>}
</nav>

<style>
  :global(html:not([data-theme='retro'])) .step-nav-card:not(.placeholder) {
    background-image: linear-gradient(
      90deg,
      var(--nav-accent, var(--c-neon-cyan)) 0%,
      color-mix(in srgb, var(--nav-accent, var(--c-neon-cyan)) 30%, transparent) 55%,
      transparent 100%
    );
    background-size: 100% 2px;
    background-position: top left;
    background-repeat: no-repeat;
  }
  :global(html[data-theme='retro']) .step-nav-label {
    font-family: 'Press Start 2P', monospace;
    font-size: 10px;
  }
  :global(html[data-theme='retro']) .step-nav-title {
    font-family: 'DotGothic16', sans-serif;
  }
</style>
