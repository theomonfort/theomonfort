---
interface Props {
  image?: string;
  imageAlt?: string;
  variant?: 'mona';
}

const { image, imageAlt = '', variant = 'mona' } = Astro.props;
---

<div class={`hero-quote hero-quote-${variant} mona-comm-dialog`}>
  <div class="mona-comm-bar" aria-hidden="true">
    <span class="mona-comm-dot"></span>
    <span class="mona-comm-tag">COMM-LINK // MONA</span>
    <span class="mona-comm-signal">▮▮▮</span>
  </div>
  <div class="hero-quote-text"><slot /></div>
  {image && <img src={image} alt={imageAlt} />}
</div>

<style>
  :global(html:not([data-theme='retro'])) .mona-comm-dialog {
    background-color: rgb(var(--rgb-deep-purple) / 0.90);
    background-image: linear-gradient(
      90deg,
      var(--entry-accent, var(--c-neon-cyan)) 0%,
      color-mix(in srgb, var(--entry-accent, var(--c-neon-cyan)) 32%, transparent) 55%,
      transparent 100%
    );
    background-size: 100% 2px;
    background-position: top left;
    background-repeat: no-repeat;
    border: 1px solid color-mix(in srgb, var(--entry-accent, var(--c-neon-cyan)) 36%, var(--c-border));
    border-radius: var(--radius-card);
    backdrop-filter: blur(10px);
    box-shadow: 0 10px 28px rgb(var(--rgb-shadow-ink) / 0.38);
  }
  .mona-comm-dialog::before {
    image-rendering: pixelated;
    image-rendering: crisp-edges;
  }
  .mona-comm-bar {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    padding-bottom: 0.55rem;
    margin-bottom: 0.75rem;
    border-bottom: 1px solid var(--c-border);
    font-family: var(--font-mono-hud);
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    color: var(--entry-accent, var(--c-neon-cyan));
  }
  :global(html[data-theme='retro']) .mona-comm-bar {
    display: none;
  }
  .mona-comm-dot {
    width: 6px;
    height: 6px;
    border-radius: 999px;
    background: var(--c-gb-green);
    box-shadow: 0 0 8px rgb(var(--rgb-gb-green) / 0.7);
  }
  .mona-comm-signal {
    margin-left: auto;
    font-size: 0.62rem;
    letter-spacing: 0.08em;
    color: var(--c-gb-green);
    opacity: 0.85;
  }
</style>
