---
interface Props {
  type?: 'positive' | 'negative' | 'reference' | 'caution' | 'danger';
  mascot?: string;
  accent?: string;
}
const { type = 'positive', mascot, accent } = Astro.props;
const isAlert = type === 'negative' || type === 'caution' || type === 'danger';
const marker =
  type === 'danger'
    ? '🚨 DANGER'
    : type === 'caution' || type === 'negative'
      ? '⚠️ NOTE'
      : type === 'reference'
        ? null
        : '💡 TIP';
const styleParts = [];
if (mascot) styleParts.push(`--aside-mascot: url('${mascot}')`);
if (accent) styleParts.push(`--aside-accent: ${accent}`);
const style = styleParts.length ? `${styleParts.join('; ')};` : undefined;
---

<aside
  class:list={[
    'handson-aside',
    `aside-${type}`,
    { 'aside-negative': type === 'caution' || type === 'danger', 'is-alert': isAlert },
  ]}
  data-aside={type}
  style={style}
>
  {marker && <span class="aside-marker font-mono text-[11px] font-semibold tracking-[0.1em]" aria-hidden="true">{marker}</span>}
  <div class="aside-body">
    <slot />
  </div>
</aside>

<style>
  .handson-aside {
    background-image: linear-gradient(
      90deg,
      var(--aside-accent, #5eead4) 0%,
      color-mix(in srgb, var(--aside-accent, #5eead4) 30%, transparent) 55%,
      transparent 100%
    );
    background-size: 100% 2px;
    background-position: top left;
    background-repeat: no-repeat;
  }
  .handson-aside.is-alert {
    --aside-accent: var(--c-coral-alert, #fb7185);
  }
</style>
