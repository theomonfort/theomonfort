---
import { accentClasses, type AccentColor } from '../../lib/theme';

interface Item {
  name: string;
  icon?: string;
  description: string;
  url?: string;
  install?: string;
  badge?: string;
}
interface Props {
  items: Item[];
  color?: AccentColor;
  readMoreLabel?: string;
}
const { items, color = 'cyan', readMoreLabel = '▶ 詳細を見る ↗' } = Astro.props;
const c = accentClasses[color];
const TONE_HEX: Record<AccentColor, string> = {
  cyan: '#5eead4',
  magenta: '#93a8ff',
  amber: '#fcd34d',
  green: '#86efac',
};
const tone = TONE_HEX[color];
---

<ul class="grid grid-cols-1 md:grid-cols-2 gap-4">
  {items.map((it) => (
    <li class="equip-card p-5 transition-all duration-150 hover:-translate-y-0.5" style={`--tone:${tone}`}>
      <div class="flex items-start gap-3.5">
        {it.icon && <span class="text-2xl shrink-0 leading-none mt-0.5">{it.icon}</span>}
        <div class="flex-1 min-w-0">
          <div class="flex items-center gap-2 flex-wrap mb-1.5">
            <h3 class="font-body text-base font-semibold text-phosphor">{it.name}</h3>
            {it.badge && (
              <span class={`font-mono text-[10px] font-semibold px-1.5 py-0.5 rounded-[3px] border border-current/30 bg-shadow-ink/80 ${c.text}`}>
                {it.badge}
              </span>
            )}
          </div>
          <p class="font-body text-sm text-phosphor-body leading-relaxed">
            {it.description}
          </p>
          {it.install && (
            <pre class="font-mono text-[11px] text-gb-green bg-shadow-ink border border-neon-cyan/20 rounded-[3px] px-3 py-2 mt-3 overflow-x-auto"><code>{it.install}</code></pre>
          )}
          {it.url && (
            <a href={it.url} target="_blank" rel="noopener noreferrer" class="equip-link inline-block font-mono text-xs mt-2.5">
              {readMoreLabel}
            </a>
          )}
        </div>
      </div>
    </li>
  ))}
</ul>

<style>
  .equip-card {
    background-color: rgba(11, 20, 32, 0.86);
    background-image: linear-gradient(
      90deg,
      var(--tone, #5eead4) 0%,
      color-mix(in srgb, var(--tone, #5eead4) 30%, transparent) 55%,
      transparent 100%
    );
    background-size: 100% 2px;
    background-position: top left;
    background-repeat: no-repeat;
    border: 1px solid rgba(94, 234, 212, 0.16);
    border-radius: 3px;
    box-shadow: 0 8px 24px rgba(4, 8, 14, 0.34);
  }
  .equip-card:hover {
    background-color: rgba(16, 29, 45, 0.95);
    border-color: color-mix(in srgb, var(--tone, #5eead4) 45%, rgba(94, 234, 212, 0.24));
  }
  .equip-link {
    color: #67e8f9;
    text-decoration: underline;
    text-underline-offset: 4px;
    transition: color 0.15s ease;
  }
  .equip-link:hover {
    color: #a5f3fc;
  }
</style>
