---
import '../../styles/globals.css';
import { ClientRouter } from 'astro:transitions';
import CRTOverlay from '../retro/CRTOverlay.tsx';
import SiteControls from '../interactive/SiteControls.astro';
import KonamiListener from '../interactive/KonamiListener.tsx';
import BootSequence from '../interactive/BootSequence.tsx';
import Footer from './Footer.astro';
import Nav from './Nav.astro';
import { localizedPath, otherLocale, siteCopy, type Locale } from '../../lib/i18n';

interface Props {
  title?: string;
  description?: string;
  locale?: Locale;
  currentPath?: string;
}
const {
  locale = 'ja',
  currentPath = '/',
  title,
  description,
} = Astro.props;
const copy = siteCopy[locale];
const pageTitle = title ?? copy.siteTitle;
const pageDescription = description ?? copy.siteDescription;
const alternateLocale = otherLocale(locale);
const jaUrl = localizedPath('ja', currentPath);
const enUrl = localizedPath('en', currentPath);
---

<!doctype html>
<html lang={copy.lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={pageDescription} />
    <meta name="theme-color" content="#060b12" />
    <meta property="og:locale" content={copy.localeCode} />
    <meta property="og:locale:alternate" content={siteCopy[alternateLocale].localeCode} />
    <link rel="alternate" hreflang="ja" href={jaUrl} />
    <link rel="alternate" hreflang="en" href={enUrl} />
    <link rel="alternate" hreflang="x-default" href={jaUrl} />
    <title>{pageTitle}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Press+Start+2P&family=DotGothic16&family=VT323&family=Noto+Sans+JP:wght@400;700&family=IBM+Plex+Sans+JP:wght@400;700&family=IBM+Plex+Mono:wght@400;700&family=Orbitron:wght@500;700&family=Share+Tech+Mono&family=M+PLUS+1+Code:wght@400;700&family=Caveat:wght@700&display=swap"
    />
    <link rel="icon" type="image/svg+xml" href="/theomonfort/favicon.svg" />
    <script is:inline>
      (function () {
        var KEY = 'akq-site-theme';
        var EVENT = 'akq:theme-change';
        var SWAP_SVGS = [
          ['/theomonfort/favicon.svg', '/theomonfort/favicon-retro.svg'],
          ['/theomonfort/diagrams/codeql-architecture.svg', '/theomonfort/diagrams/codeql-architecture-retro.svg'],
          ['/theomonfort/icons/play-cyan.svg', '/theomonfort/icons/play-cyan-retro.svg'],
          ['/theomonfort/icons/vscode-extensions.svg', '/theomonfort/icons/vscode-extensions-retro.svg']
        ];

        function resolveInitialTheme() {
          try {
            var params = new URLSearchParams(window.location.search);
            var q = params.get('theme');
            if (q === 'retro' || q === 'phosphor') {
              localStorage.setItem(KEY, q);
              return q;
            }
            var stored = localStorage.getItem(KEY);
            if (stored === 'retro' || stored === 'phosphor') return stored;
          } catch (_) {}
          return 'phosphor';
        }

        function syncThemeAssets(theme, rootDoc) {
          var doc = rootDoc || document;
          var isRetro = theme === 'retro';
          var meta = doc.querySelector('meta[name="theme-color"]');
          if (meta) meta.setAttribute('content', isRetro ? '#0a0e27' : '#060b12');
          var icon = doc.querySelector('link[rel="icon"]');
          if (icon) icon.setAttribute('href', isRetro ? '/theomonfort/favicon-retro.svg' : '/theomonfort/favicon.svg');

          var imgs = doc.querySelectorAll('img[src]');
          for (var i = 0; i < imgs.length; i++) {
            var img = imgs[i];
            var src = img.getAttribute('src') || '';
            for (var j = 0; j < SWAP_SVGS.length; j++) {
              var phos = SWAP_SVGS[j][0];
              var ret = SWAP_SVGS[j][1];
              if (src === phos || src === ret) {
                var target = isRetro ? ret : phos;
                if (src !== target) img.setAttribute('src', target);
                break;
              }
            }
          }
        }

        function applyTheme(next, broadcast) {
          var theme = next === 'retro' ? 'retro' : 'phosphor';
          document.documentElement.dataset.theme = theme;
          try {
            localStorage.setItem(KEY, theme);
          } catch (_) {}
          syncThemeAssets(theme, document);
          if (broadcast !== false) {
            window.dispatchEvent(new CustomEvent(EVENT, { detail: { theme: theme } }));
          }
          return theme;
        }

        var initial = resolveInitialTheme();
        document.documentElement.dataset.theme = initial;
        syncThemeAssets(initial, document);

        window.__akqGetTheme = function () {
          return document.documentElement.dataset.theme === 'retro' ? 'retro' : 'phosphor';
        };
        window.__akqSyncThemeAssets = syncThemeAssets;
        window.__akqSetTheme = function (next) {
          return applyTheme(next, true);
        };
        window.__akqToggleTheme = function () {
          var cur = window.__akqGetTheme();
          return applyTheme(cur === 'retro' ? 'phosphor' : 'retro', true);
        };

        if (!window.__akqThemeRouterBound) {
          window.__akqThemeRouterBound = true;
          document.addEventListener('astro:before-swap', function (e) {
            var cur = window.__akqGetTheme();
            if (e && e.newDocument && e.newDocument.documentElement) {
              e.newDocument.documentElement.dataset.theme = cur;
              syncThemeAssets(cur, e.newDocument);
            }
          });
          document.addEventListener('astro:page-load', function () {
            var cur = window.__akqGetTheme();
            document.documentElement.dataset.theme = cur;
            syncThemeAssets(cur, document);
          });
        }
      })();
    </script>
    <ClientRouter />
  </head>
  <body class="bg-stars min-h-screen relative">
    <BootSequence client:load transition:persist locale={locale} copy={{ brandMiddle: copy.brandMiddle }} />
    <CRTOverlay client:load transition:persist locale={locale} currentPath={currentPath} />
    <SiteControls locale={locale} feedbackUrl={copy.handson.bugReportUrl} />
    <KonamiListener client:load transition:persist secretPath={localizedPath(locale, '/secret')} />

    <!-- Page-transition wipe overlay (CRT scanline sweep) -->
    <div class="page-wipe" aria-hidden="true" transition:persist></div>

    <div class="relative z-10">
      <Nav locale={locale} currentPath={currentPath} />
      <main class="relative" transition:animate="none">
        <slot />
      </main>
      <Footer locale={locale} currentPath={currentPath} />
    </div>

    <script>
      // Retro page-transition: scanline wipe + SFX on every navigation.
      import('../../lib/sfx').then(({ play }) => {
        const win = window as Window & typeof globalThis & {
          __akqPageTransitionCleanup?: () => void;
        };

        win.__akqPageTransitionCleanup?.();

        const wipe = document.querySelector<HTMLElement>('.page-wipe');

        const runWipe = () => {
          if (wipe) {
            wipe.classList.remove('is-wiping');
            // force reflow so the animation restarts
            void wipe.offsetWidth;
            wipe.classList.add('is-wiping');
          }
          play('hover');
        };

        const resetScroll = () => {
          window.scrollTo({ top: 0, behavior: 'instant' as ScrollBehavior });
        };

        const clearWipe = () => {
          setTimeout(() => wipe?.classList.remove('is-wiping'), 700);
        };

        document.addEventListener('astro:before-preparation', runWipe);
        document.addEventListener('astro:after-swap', resetScroll);
        document.addEventListener('astro:page-load', clearWipe);

        win.__akqPageTransitionCleanup = () => {
          document.removeEventListener('astro:before-preparation', runWipe);
          document.removeEventListener('astro:after-swap', resetScroll);
          document.removeEventListener('astro:page-load', clearWipe);
        };
      });
    </script>
  </body>
</html>
