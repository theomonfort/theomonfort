---
import { localizedPath, siteCopy, type Locale } from '../../lib/i18n';
import { getHandsonSteps } from '../../lib/handson';

interface Props {
  locale?: Locale;
  currentPath?: string;
}
const { locale = 'ja', currentPath = '/' } = Astro.props;
const t = siteCopy[locale];
const handsonSteps = await getHandsonSteps(locale);
const handsonHref = `/handson/${handsonSteps[0]?.slug ?? 'intro'}`;

const items = [
  { path: '/', label: t.nav.hub, short: t.nav.hubShort },
  { path: '/playbook', label: t.nav.playbook, short: t.nav.playbookShort },
  { path: '/handson', href: handsonHref, label: t.nav.handson, short: t.nav.handsonShort },
  { path: '/skills', label: t.nav.equipment, short: t.nav.equipmentShort },
  { path: '/changelog', label: t.nav.changelog, short: t.nav.changelogShort },
];
---

<header class="site-nav sticky top-0 z-40 backdrop-blur-md bg-[rgba(6,11,18,0.88)] border-b border-[rgba(94,234,212,0.16)]">
  <nav class="max-w-6xl mx-auto px-4 py-2.5 flex flex-wrap items-center justify-between gap-4">
    <a
      href={localizedPath(locale, '/')}
      class="group inline-flex items-center gap-2.5 text-phosphor hover:text-neon-cyan transition-colors leading-none"
      aria-label={t.brandAria}
    >
      <img
        src="/theomonfort/favicon.svg"
        alt=""
        class="w-6 h-6 md:w-7 md:h-7 shrink-0 pixelated opacity-95 group-hover:opacity-100 transition-opacity"
        aria-hidden="true"
      />
      <span class="font-display text-[11px] md:text-xs font-bold tracking-[0.1em] text-neon-cyan">AI</span>
      <span class="font-body text-[0.96rem] md:text-[1.02rem] font-bold leading-none text-phosphor">{t.brandMiddle}</span>
      <span class="font-display text-[11px] md:text-xs font-bold tracking-[0.12em] text-neon-cyan">QUEST</span>
    </a>
    <ul class="flex items-center gap-1 md:gap-1.5 flex-wrap text-xs md:text-[0.8rem] font-body font-semibold">
      {items.slice(1).map((item) => {
        const active = currentPath === item.path || currentPath.startsWith(item.path + '/');
        return (
          <li>
            <a
              href={localizedPath(locale, item.href ?? item.path)}
              aria-current={active ? 'page' : undefined}
              class={`inline-block px-2.5 lg:px-3.5 py-1.5 rounded-[3px] border tracking-[0.04em] transition-colors ${
                active
                  ? 'border-neon-cyan/[0.42] bg-neon-cyan/[0.14] text-phosphor'
                  : 'border-transparent text-phosphor-muted hover:text-phosphor hover:bg-white/[0.04] hover:border-[rgba(94,234,212,0.18)]'
              }`}
            >
              <span class="hidden lg:inline">{item.label}</span>
              <span class="lg:hidden">{item.short}</span>
            </a>
          </li>
        );
      })}
    </ul>
  </nav>
</header>
