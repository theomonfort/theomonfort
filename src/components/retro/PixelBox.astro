---
import { accentColorValues, accentGlowClasses, type AccentColor } from '../../lib/theme';

// FF6/DQ-style double-border pixel box
interface Props {
  variant?: AccentColor;
  padding?: string;
  glow?: boolean;
  class?: string;
}
const { variant = 'cyan', padding = 'p-5 md:p-7', glow = true, class: cls = '' } = Astro.props;

const color = accentColorValues[variant];
const glowClass = glow ? accentGlowClasses[variant] : '';
---

<div
  class={`pixel-box relative backdrop-blur-md ${padding} ${glowClass} ${cls}`}
  style={`--pb-color:${color}`}
>
  <slot />
</div>

<style>
  .pixel-box {
    border-radius: var(--radius-card);
    border: 1px solid color-mix(in srgb, var(--pb-color) 26%, var(--c-border));
    background-color: var(--c-bg-elevated);
    background-image: linear-gradient(
      90deg,
      var(--pb-color) 0%,
      color-mix(in srgb, var(--pb-color) 32%, transparent) 55%,
      transparent 100%
    );
    background-size: 100% 2px;
    background-position: top left;
    background-repeat: no-repeat;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.30);
  }

  :global(html[data-theme='retro']) .pixel-box {
    border-radius: 0;
    border: 2px solid var(--pb-color);
    background-color: rgba(5, 6, 15, 0.8);
    background-image: none;
    box-shadow:
      inset 0 0 0 4px var(--c-shadow-ink),
      inset 0 0 0 6px var(--pb-color),
      4px 4px 0 0 var(--c-shadow-ink);
    image-rendering: pixelated;
  }
  :global(html[data-theme='retro']) .pixel-box::before,
  :global(html[data-theme='retro']) .pixel-box::after {
    content: '';
    position: absolute;
    width: 8px;
    height: 8px;
    background: var(--pb-color);
  }
  :global(html[data-theme='retro']) .pixel-box::before {
    top: -2px;
    left: -2px;
    box-shadow: calc(100% + 4px - 8px) 0 0 var(--pb-color);
  }
  :global(html[data-theme='retro']) .pixel-box::after {
    bottom: -2px;
    left: -2px;
    box-shadow: calc(100% + 4px - 8px) 0 0 var(--pb-color);
  }
</style>
