---
import { localizedPath } from '../../lib/i18n';
import { getHandsonSteps } from '../../lib/handson';

const locale = 'ja';
const steps = await getHandsonSteps(locale);
const target = localizedPath(locale, `/handson/${steps[0]?.slug ?? 'intro'}`);
Astro.response.headers.set('Refresh', `0;url=${target}`);
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8">
    <meta http-equiv="refresh" content={`0;url=${target}`}>
    <link rel="canonical" href={target}>
    <title>Redirecting…</title>
    <style>body{background:#060b12;color:#ecf7fb;font-family:'IBM Plex Mono',monospace;display:grid;place-items:center;height:100vh;margin:0;}a{color:#5eead4;text-decoration:none;border:1px solid rgba(94,234,212,0.32);border-radius:3px;padding:0.5rem 0.9rem;background:rgba(11,20,32,0.86);}a:hover{border-color:#5eead4;color:#a5f3fc;}</style>
  </head>
  <body>
    <p>→ <a href={target}>ハンズオンを開く</a></p>
    <script is:inline define:vars={{ target }}>
      window.location.replace(target);
    </script>
  </body>
</html>
