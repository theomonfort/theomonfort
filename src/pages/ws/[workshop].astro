---
import WorkshopNotesPage from '../../components/pages/WorkshopNotesPage.astro';

export function getStaticPaths() {
  return ['copilot', 'github', 'ghas'].map((workshop) => ({ params: { workshop } }));
}

const workshop = Astro.params.workshop as 'copilot' | 'github' | 'ghas';
---

<WorkshopNotesPage locale="ja" workshop={workshop} currentPath={`/ws/${workshop}`} />
