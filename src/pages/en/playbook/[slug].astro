    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--c-fg-muted);
  }

  .related-pill {
    display: inline-flex;
    align-items: center;
    padding: 0.32rem 0.72rem;
    font-family: var(--font-prose);
    font-size: 0.8rem;
    color: var(--c-fg-body);
    background: var(--c-bg-elevated);
    border: 1px solid var(--c-border);
    border-radius: var(--radius-pill);
    text-decoration: none;
    transition: color 0.15s ease, border-color 0.15s ease, background 0.15s ease;
  }
  .related-pill:hover {
    color: var(--c-neon-cyan);
    border-color: var(--c-border-strong);
    background: var(--c-bg-elevated-hover);
  }

  .entry-page-link {
    display: block;
    padding: 0.85rem 1.05rem;
    font-family: var(--font-prose);
    font-size: 0.9rem;
    line-height: 1.5;
    color: var(--c-fg-body);
    background: var(--c-bg-elevated);
    border: 1px solid var(--c-border);
    border-radius: var(--radius-card);
    box-shadow: 0 6px 18px rgba(0, 0, 0, 0.26);
    text-decoration: none;
    transition: transform 0.18s ease, color 0.15s ease, border-color 0.15s ease, background 0.15s ease;
  }
  .entry-page-link.is-next {
    text-align: right;
  }
  .entry-page-link:hover {
    transform: translateY(-2px);
    color: var(--c-neon-cyan);
    border-color: var(--c-border-strong);
    background: var(--c-bg-elevated-hover);
  }
  .entry-page-link.is-next:hover {
    color: var(--c-neon-magenta);
    border-color: rgba(147, 168, 255, 0.42);
  }

  /* ── Article & Slide Prose (Phosphor Cosmos HUD) ── */
  .prose-akq {
    color: var(--c-fg-body);
    font-family: var(--font-prose);
    font-size: 1.0625rem;
    line-height: 1.88;
    letter-spacing: 0.01em;
  }
  .prose-akq h2, .prose-akq h3 {
    font-family: var(--font-prose);
    font-weight: 700;
    margin-top: 2em;
    margin-bottom: 0.65em;
  }
  .prose-akq h2 {
    font-size: 1.75em;
    line-height: 1.4;
    color: var(--c-fg-strong);
    padding-left: 0.85rem;
    padding-bottom: 0.4rem;
    border-left: 4px solid var(--entry-accent, #5eead4);
    border-bottom: 1px solid rgba(94, 234, 212, 0.16);
  }
  .prose-akq h3 {
    color: var(--entry-accent, #93a8ff);
    font-size: 1.35em;
    line-height: 1.4;
  }
  /* Compact reference link sitting to the right of a section title. */
  .prose-akq h2 .h2-doc {
    display: inline-flex;
    align-items: center;
    gap: 0.35em;
    vertical-align: middle;
    margin-left: 0.75rem;
    padding: 0.2rem 0.55rem;
    font-family: var(--font-mono-hud);
    font-size: 12px;
    font-weight: 600;
    line-height: 1.35;
    letter-spacing: 0.04em;
    white-space: nowrap;
    color: #5eead4;
    background: rgba(94, 234, 212, 0.08);
    border: 1px solid rgba(94, 234, 212, 0.28);
    border-radius: 3px;
    text-decoration: none;
    opacity: 0.9;
    transition: opacity 0.15s ease, color 0.15s ease, background 0.15s ease, border-color 0.15s ease, transform 0.15s ease;
  }
  .prose-akq h2 .h2-doc:hover,
  .prose-akq h2 .h2-doc:focus-visible {
    color: #93a8ff;
    background: rgba(147, 168, 255, 0.14);
    border-color: rgba(147, 168, 255, 0.52);
    opacity: 1;
    transform: translateY(-1px);
  }

  /* ─────────────────────────────────────────────
     DEMO reveal — a presenter run-book hidden
     behind a button next to a section title.
     Pure CSS (checkbox toggle) so it behaves the
     same in document and presentation mode.
     ───────────────────────────────────────────── */
  .prose-akq h2 .demo-toggle {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: 0;
    padding: 0;
    opacity: 0;
    pointer-events: none;
  }
  .prose-akq h2 .h2-demo {
    display: inline-flex;
    align-items: center;
    gap: 0.35em;
    vertical-align: middle;
    margin-left: 0.75rem;
    padding: 0.2rem 0.65rem;
    font-family: var(--font-mono-hud);
    font-size: 12px;
    font-weight: 600;
    line-height: 1.35;
    letter-spacing: 0.08em;
    white-space: nowrap;
    cursor: pointer;
    user-select: none;
    color: #fcd34d;
    background: rgba(252, 211, 77, 0.1);
    border: 1px solid rgba(252, 211, 77, 0.45);
    border-radius: 3px;
    transition: color 0.15s ease, background 0.15s ease, border-color 0.15s ease, transform 0.15s ease;
  }
  .prose-akq h2 .h2-demo:hover,
  .prose-akq h2 .demo-toggle:focus-visible + .h2-demo {
    color: #04080e;
    background: #fcd34d;
    border-color: #fcd34d;
    text-shadow: none;
    transform: translateY(-1px);
  }

  /* Overlay is closed by default and revealed by the checkbox. */
  .demo-panel { display: none; }
  .prose-akq h2:has(.demo-toggle:checked) + .demo-panel { display: block; }
  /* Never let the slide-in transform turn this into a containing block. */
  body.present-mode .demo-panel.akq-slide-active { animation: none; }

  /* The sticky site header uses backdrop-filter, which paints above the
     overlay no matter how high we push z-index. Fade it out instead of
     hiding it, so the page below keeps its layout. */
  body:has(.demo-toggle:checked) .site-nav {
    opacity: 0;
    pointer-events: none;
  }
  .demo-panel .demo-scrim {
    position: fixed;
    inset: 0;
    z-index: 200;
    display: block;
    cursor: pointer;
    background: rgba(4, 8, 14, 0.84);
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
  }
  .demo-panel .demo-window {
    position: fixed;
    top: 50%;
    left: 50%;
    z-index: 201;
    transform: translate(-50%, -50%);
    width: min(60rem, 92vw);
    max-height: 84vh;
    overflow-y: auto;
    background: #0b1420;
    border: 1px solid rgba(252, 211, 77, 0.45);
    border-radius: 3px;
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.65), 0 0 24px rgba(252, 211, 77, 0.16);
  }
  .demo-panel .demo-head {
    position: sticky;
    top: 0;
    z-index: 1;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.6rem 0.95rem;
    color: #04080e;
    background: #fcd34d;
    text-shadow: none;
  }
  .demo-panel .demo-tag {
    font-family: var(--font-mono-hud);
    font-size: 0.74rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    color: #04080e;
    text-shadow: none;
  }
  .demo-panel .demo-name {
    font-family: var(--font-prose);
    font-size: 1.05rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    color: #04080e;
    opacity: 0.82;
    text-shadow: none;
  }
  .demo-panel .demo-note {
    margin-left: auto;
    padding: 0.14rem 0.55rem;
    font-family: var(--font-mono-hud), var(--font-prose);
    font-size: 0.72rem;
    font-weight: 600;
    line-height: 1.45;
    letter-spacing: 0.06em;
    white-space: nowrap;
    color: #fcd34d;
    background: #04080e;
    border: 1px solid rgba(4, 8, 14, 0.65);
    border-radius: 2px;
  }
  .demo-panel .demo-note + .demo-close {
    margin-left: 0;
  }
  .demo-panel .demo-close {
    margin-left: auto;
    padding: 0.1rem 0.5em;
    font-family: var(--font-mono-hud);
    font-size: 0.95rem;
    font-weight: 700;
    line-height: 1.35;
    cursor: pointer;
    user-select: none;
    color: #04080e;
    border: 1px solid rgba(4, 8, 14, 0.45);
    border-radius: 2px;
    text-shadow: none;
  }
  .demo-panel .demo-close:hover {
    color: #fcd34d;
    background: #04080e;
  }

  .demo-panel .demo-steps {
    counter-reset: demo-step;
    margin: 0;
    padding: 1.1rem 1.15rem 1.3rem;
    list-style: none;
  }
  .demo-panel .demo-steps > li {
    counter-increment: demo-step;
    position: relative;
    margin: 0 0 1rem;
    padding: 0.75rem 0.95rem 0.85rem 3.1rem;
    background: rgba(4, 8, 14, 0.55);
    border-left: 2px solid rgba(252, 211, 77, 0.45);
    border-radius: 0 3px 3px 0;
  }
  .demo-panel .demo-steps > li:last-child { margin-bottom: 0; }
  .demo-panel .demo-steps > li::before {
    content: counter(demo-step);
    position: absolute;
    top: 0.7rem;
    left: 0.75rem;
    display: grid;
    place-items: center;
    width: 1.7rem;
    height: 1.7rem;
    font-family: var(--font-mono-hud);
    font-size: 0.78rem;
    font-weight: 700;
    color: #04080e;
    background: #fcd34d;
    border-radius: 2px;
    text-shadow: none;
  }
  .demo-panel .demo-step-title {
    margin: 0 0 0.4rem;
    font-family: var(--font-prose);
    font-size: 1.2rem;
    font-weight: 700;
    line-height: 1.25;
    letter-spacing: 0.02em;
    color: #fcd34d;
  }
  .demo-panel .demo-steps p {
    margin: 0.3rem 0;
    font-size: 0.95rem;
    line-height: 1.7;
    color: #bad0de;
  }
  .demo-panel .demo-steps b { color: #93a8ff; }
  .demo-panel .demo-cmd {
    display: block;
    margin: 0.45rem 0;
    padding: 0.45rem 0.7rem;
    font-family: var(--font-mono-hud);
    font-size: 0.88rem;
    line-height: 1.5;
    color: #86efac;
    background: rgba(134, 239, 172, 0.08);
    border: 1px solid rgba(134, 239, 172, 0.28);
    border-radius: 3px;
    white-space: pre;
    overflow-x: auto;
  }
  .demo-panel .demo-cmd::before {
    content: '$ ';
    opacity: 0.5;
  }
  .demo-panel .demo-path {
    display: inline-block;
    padding: 0.05em 0.45em;
    font-family: var(--font-mono-hud);
    font-size: 0.85em;
    color: #5eead4;
    background: rgba(94, 234, 212, 0.09);
    border: 1px solid rgba(94, 234, 212, 0.26);
    border-radius: 2px;
  }
  .demo-panel .demo-out {
    margin: 0.35rem 0 0;
    font-size: 0.88rem;
    color: var(--c-fg-muted);
  }
  .demo-panel .demo-out::before {
    content: '\2192\00a0';
    color: #fcd34d;
  }

  /* INFO variant: the same checkbox overlay as DEMO, in cyan, holding
     audience-facing background (e.g. "who is FIRST?") instead of steps. */
  .prose-akq h2 .h2-demo.h2-info {
    color: #5eead4;
    background: rgba(94, 234, 212, 0.09);
    border-color: rgba(94, 234, 212, 0.42);
  }
  .prose-akq h2 .h2-demo.h2-info:hover,
  .prose-akq h2 .demo-toggle:focus-visible + .h2-demo.h2-info {
    color: #04080e;
    background: #5eead4;
    border-color: #5eead4;
    text-shadow: none;
  }
  .demo-panel.is-info .demo-window {
    border-color: rgba(94, 234, 212, 0.45);
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.65), 0 0 24px rgba(94, 234, 212, 0.16);
  }
  .demo-panel.is-info .demo-head { background: #5eead4; color: #04080e; text-shadow: none; }
  .demo-panel.is-info .demo-close:hover { color: #5eead4; }
  .demo-panel .info-body { padding: 1.1rem 1.4rem 1.4rem; color: #bad0de; }
  .demo-panel .info-body p {
    margin: 0.4rem 0;
    font-size: 0.98rem;
    line-height: 1.7;
  }
  .demo-panel .info-body p.info-lead {
    margin-top: 0;
    font-size: 1.18rem;
    line-height: 1.5;
    color: #5eead4;
  }
  .demo-panel .info-body p.info-h {
    margin: 1.15rem 0 0.45rem;
    padding-left: 0.6rem;
    font-family: var(--font-prose);
    font-size: 1.08rem;
    font-weight: 700;
    line-height: 1.3;
    color: #5eead4;
    border-left: 2px solid #5eead4;
  }
  .demo-panel .info-list {
    margin: 0.3rem 0 0;
    padding-left: 1.4rem;
    font-size: 0.95rem;
    line-height: 1.65;
  }
  .demo-panel ol.info-list { list-style: decimal; }
  .demo-panel ul.info-list { list-style: square; }
  .demo-panel .info-list li { margin: 0.35rem 0; }
  .demo-panel .info-list ul {
    margin: 0.25rem 0 0;
    padding-left: 1.2rem;
    list-style: square;
  }
  .demo-panel .info-list li::marker { color: #5eead4; }
  .demo-panel .info-body b { color: #fcd34d; }
  .demo-panel .info-body p.info-sum {
    margin-top: 1.2rem;
    padding: 0.65rem 0.85rem;
    background: rgba(94, 234, 212, 0.06);
    border: 1px solid rgba(94, 234, 212, 0.28);
    border-radius: 3px;
  }

  @media (max-width: 640px) {
    .prose-akq h2 .h2-demo {
      margin-left: 0.5rem;
      font-size: 11px;
    }
    .demo-panel .demo-window { width: 94vw; max-height: 88vh; }
    .demo-panel .demo-name { display: none; }
    .demo-panel .demo-note { font-size: 0.65rem; letter-spacing: 0.04em; }
    .demo-panel .demo-steps { padding: 0.85rem 0.7rem 1rem; }
    .demo-panel .demo-steps > li { padding: 0.7rem 0.7rem 0.75rem 2.7rem; }
    .demo-panel .demo-steps > li::before { left: 0.5rem; }
    .demo-panel .info-body { padding: 0.85rem 0.9rem 1rem; }
  }

  @media (prefers-reduced-motion: reduce) {
    .prose-akq h2 .h2-demo { transition: none; }
    .prose-akq h2 .h2-demo:hover { transform: none; }
  }

  .prose-akq p { margin: 1em 0; }
  .prose-akq strong { color: var(--c-fg-strong); font-weight: 600; }
  .prose-akq code {
    font-family: var(--font-mono-hud);
    background: var(--c-code-bg);
    padding: 0.1em 0.42em;
    border: 1px solid var(--c-code-border);
    border-radius: 3px;
    color: var(--c-code-fg);
    font-size: 0.88em;
  }
  .prose-akq pre {
    background: var(--c-shadow-ink);
    border: 1px solid rgba(94, 234, 212, 0.24);
    border-left: 3px solid var(--entry-accent, #5eead4);
    border-radius: var(--radius-card);
    padding: 1.05em 1.2em;
    margin: 1.5em 0;
    overflow-x: auto;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.35);
  }
  .prose-akq pre code {
    border: none;
    padding: 0;
    background: none;
    color: var(--c-fg-strong);
    font-size: 0.9em;
  }
  .prose-akq blockquote {
    border-left: 3px solid #fcd34d;
    border-top: 1px solid rgba(252, 211, 77, 0.14);
    border-right: 1px solid rgba(252, 211, 77, 0.14);
    border-bottom: 1px solid rgba(252, 211, 77, 0.14);
    border-radius: 0 var(--radius-card) var(--radius-card) 0;
    padding: 0.95em 1.2em;
    color: var(--c-fg-strong);
    background: rgba(252, 211, 77, 0.06);
    margin: 1.6em 0;
    font-style: normal;
    box-shadow: 0 6px 20px rgba(0, 0, 0, 0.24);
  }
  .prose-akq blockquote p { margin: 0; }
  .prose-akq blockquote strong { color: #fcd34d; }

  /* TEST & SECURE category → cyan note style instead of amber */
  [data-category="secure"].prose-akq blockquote {
    border-left-color: #5eead4;
    border-top-color: rgba(94, 234, 212, 0.16);
    border-right-color: rgba(94, 234, 212, 0.16);
    border-bottom-color: rgba(94, 234, 212, 0.16);
    background: rgba(94, 234, 212, 0.06);
  }
  [data-category="secure"].prose-akq blockquote strong { color: #5eead4; }

  .prose-akq .hero-quote {
    position: relative;
    margin: 1.8em 0;
    padding: 1.2em 1.4em 1.3em 1.65em;
    color: var(--c-fg-strong);
    background: var(--c-bg-elevated);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border: 1px solid color-mix(in srgb, var(--entry-accent, #5eead4) 36%, transparent);
    border-left: 3px solid var(--entry-accent, #5eead4);
    border-radius: var(--radius-card);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.32);
    font-family: var(--font-prose);
    font-size: 1.12em;
    line-height: 1.72;
    margin-left: 150px;
  }
  /* Octocat mascot speaking */
  .prose-akq .hero-quote::before {
    content: '';
    position: absolute;
    left: -150px;
    top: 50%;
    transform: translateY(-50%);
    width: 130px;
    height: 130px;
    background: url('/octocat-full-green.png') center / contain no-repeat;
    filter: drop-shadow(0 8px 18px rgba(4, 8, 14, 0.65));
  }
  .prose-akq .hero-quote.hero-quote-chat::before {
    background-image: url('/octocat-full-red.png');
  }
  .prose-akq .hero-quote.hero-quote-theo::before {
    background-image: url('/theomonfort.png');
    background-size: cover;
    border-radius: 9999px;
    clip-path: circle(50% at 50% 50%);
  }
  .prose-akq .hero-quote.hero-quote-soon::before {
    background-image: url('/octocat-full-blue.png');
  }
  .prose-akq .hero-quote.hero-quote-green::before {
    background-image: url('/octocat-profile-green.png');
  }
  .prose-akq .hero-quote.hero-quote-stars::before {
    background-image: url('/octocat-full-yellow.png');
  }
  .prose-akq .hero-quote.hero-quote-red::before {
    background-image: url('/octocat-profile-red.png');
  }
  .prose-akq .hero-quote.hero-quote-mona::before {
    background-image: url('/octocat-full-mona.png');
  }
  .prose-akq .hero-quote.hero-quote-team::before {
    background-image: url('/octocat-team.png');
  }
  .prose-akq .hero-quote.hero-quote-admin::before {
    background-image: url('/octocat-full-admin.png');
  }
  /* Inline play-bullet icon used as a list marker in lieu of ✅ */
  .prose-akq .play-bullet {
    display: inline-block;
    height: 1em;
    width: auto;
    vertical-align: -0.1em;
    margin-right: 0.35em;
    filter: drop-shadow(0 0 6px rgba(94, 234, 212, 0.45));
  }
  /* Plain hero-quote — no mascot, no speech bubble notch, normal width */
  .prose-akq .hero-quote.hero-quote-plain { margin-left: 0; }
  .prose-akq .hero-quote.hero-quote-plain::before,
  .prose-akq .hero-quote.hero-quote-plain::after { content: none; display: none; }
  body.present-mode .prose-akq .hero-quote.hero-quote-plain { margin-left: 0; }
  /* TEST & SECURE category → full-body blue octocat by default (overridable per-entry) */
  [data-category="secure"].prose-akq .hero-quote::before {
    background-image: url('/octocat-full-blue.png');
  }
  [data-category="secure"].prose-akq .hero-quote.hero-quote-plain::before { background-image: none; }
  /* Speech bubble pointer (notch on the left side, in accent color) */
  .prose-akq .hero-quote::after {
    content: '';
    position: absolute;
    left: -12px;
    top: 50%;
    transform: translateY(-50%);
    width: 0;
    height: 0;
    border-top: 10px solid transparent;
    border-bottom: 10px solid transparent;
    border-right: 12px solid var(--entry-accent, #5eead4);
  }
  .prose-akq .hero-quote > p { margin: 0; }
  body.present-mode .prose-akq .hero-quote { font-size: 1.22em; padding: 1.35em 1.55em 1.45em 1.75em; margin-left: 200px; }
  body.present-mode .prose-akq .hero-quote::before { left: -200px; width: 175px; height: 175px; }
  @media (max-width: 640px) {
    .prose-akq .hero-quote { margin-left: 0; padding-top: 110px; }
    .prose-akq .hero-quote::before { left: 50%; top: -90px; transform: translateX(-50%); width: 100px; height: 100px; }
    .prose-akq .hero-quote::after {
      left: 50%; top: -8px; transform: translateX(-50%);
      border-left: 10px solid transparent; border-right: 10px solid transparent;
      border-bottom: 12px solid var(--entry-accent, #5eead4); border-top: none;
    }
  }

  /* ── Setup cards (scope comparison) ── */
  .prose-akq .setup-cards {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.1em;
    margin: 1.8em 0;
  }
  /* ── Bar comparison chart (HTML/CSS) ── */
  .prose-akq .bar-chart {
    margin: 1.2em 0 1.5em;
    padding: 1.05em 1.25em 0.85em;
    background: var(--c-bg-elevated);
    border: 1px solid rgba(94, 234, 212, 0.24);
    border-radius: var(--radius-card);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.32);
    max-width: 720px;
  }
  .prose-akq .bar-chart-title {
    color: var(--c-fg-strong);
    font-size: 1em;
    font-weight: 600;
    margin-bottom: 0.5em;
  }
  .prose-akq .bar-chart-legend {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5em 1.4em;
    color: var(--c-fg-body);
    margin-bottom: 1em;
    font-size: 0.85em;
  }
  .prose-akq .bar-chart-legend .dot {
    display: inline-block;
    width: 10px; height: 10px;
    border-radius: 50%;
