  .present-toc-toggle:hover { color: var(--c-fg-strong); }
  .present-toc-toggle:hover .key {
    background: var(--entry-accent, #5eead4);
    border-color: var(--entry-accent, #5eead4);
    color: #04080e;
    text-shadow: none;
  }
  .present-toc-toggle[aria-pressed="true"] .key {
    background: color-mix(in srgb, var(--entry-accent, #5eead4) 28%, transparent);
    border-color: var(--entry-accent, #5eead4);
  }
  @media (max-width: 767px) {
    .present-toc-toggle { display: none; }
  }
  .present-toc .toc-item {
    display: flex !important;
    align-items: baseline;
    gap: 0.55rem;
    width: 100%;
    padding: 0.44rem 0.65rem 0.44rem 0.8rem;
    text-align: left;
    position: relative;
    background: transparent;
    border: none;
    border-left: 2px solid transparent;
    border-radius: 0 3px 3px 0;
    color: var(--c-fg-body);
    font-family: var(--font-prose);
    font-size: 13px;
    line-height: 1.42;
    cursor: pointer;
    text-decoration: none;
    transition: color 0.15s ease, background 0.15s ease, border-color 0.15s ease;
  }
  .present-toc .toc-item.toc-hidden {
    display: none !important;
  }
  .present-toc .toc-item:hover {
    color: var(--c-fg-strong);
    background: rgba(94, 234, 212, 0.05);
    border-left-color: color-mix(in srgb, var(--cat-color, #5eead4) 55%, transparent);
  }
  .present-toc .toc-item.active {
    color: var(--c-fg-strong) !important;
    font-weight: 600;
    background: rgba(94, 234, 212, 0.1);
    border-left-color: var(--cat-color, #5eead4);
  }
  .present-toc .toc-section {
    font-family: var(--font-mono-hud), var(--font-prose);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    padding: 0.9rem 0.6rem 0.35rem;
    margin-top: 0.35rem;
    margin-bottom: 0.15rem;
    border-bottom: 1px solid color-mix(in srgb, currentColor 28%, transparent);
    opacity: 0.92;
  }
  .present-toc .toc-section:first-child {
    margin-top: 0;
  }
  .present-toc .toc-num {
    font-family: var(--font-mono-hud);
    font-size: 11px;
    font-weight: 500;
    color: var(--c-fg-muted);
    flex-shrink: 0;
    min-width: 1.55rem;
  }
  .present-toc .toc-item.active .toc-num {
    color: var(--cat-color, #5eead4);
    font-weight: 700;
  }
  .present-toc .toc-text {
    flex: 1;
    overflow: hidden;
    text-overflow: ellipsis;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
  }
  .present-toc .toc-title-text {
    position: relative;
  }
  .present-toc .toc-new-badge {
    display: inline-block;
    position: static;
    margin-left: 0.35rem;
    padding: 0.04rem 0.32rem;
    font-family: var(--font-mono-hud);
    font-weight: 600;
    font-size: 9px;
    line-height: 1.3;
    letter-spacing: 0.05em;
    color: #fcd34d;
    background: rgba(252, 211, 77, 0.12);
    border: 1px solid rgba(252, 211, 77, 0.38);
    border-radius: 2px;
    vertical-align: middle;
    pointer-events: none;
    white-space: nowrap;
  }

  /* ── Slide visibility ── */
  body.present-mode .akq-slide-el { /* no-op marker */ }
  body.present-mode .akq-slide-hidden:not(.present-toc):not(.toc-item):not(.toc-num):not(.toc-text) { display: none !important; }

  body.present-mode .akq-slide-active {
    animation: slide-in 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }
  @keyframes slide-in {
    0%   { opacity: 0; transform: translateY(18px) scale(0.99); filter: blur(3px); }
    60%  { opacity: 1; filter: blur(0); }
    100% { opacity: 1; transform: translateY(0) scale(1); filter: blur(0); }
  }
  body.present-mode .playbook-detail {
    transition: background 0.4s ease, padding-left 0.25s ease;
  }

  /* Boost typography in slide mode */
  body.present-mode .playbook-detail header { margin-bottom: 1.5rem; }
  body.present-mode .playbook-detail header h1 {
    font-family: var(--font-display);
    font-size: clamp(2.35rem, 3.8vw, 3.1rem) !important;
    line-height: 1.22;
    color: var(--c-fg-strong);
  }
  body.present-mode .playbook-detail header > p:nth-of-type(2) { font-size: 1.45rem !important; }
  body.present-mode .prose-akq { font-size: 1.55rem; line-height: 1.78; max-width: 72rem; width: 100%; margin: 0 auto; }
  body.present-mode .prose-akq h2 { font-size: 2.3rem; margin-top: 0.4em; margin-bottom: 0.65em; }
  body.present-mode .prose-akq > h2 {
    position: relative;
    padding-left: 0.85rem;
    padding-bottom: 0.38rem;
    font-family: var(--font-prose);
    color: var(--c-fg-strong);
    border-left: 4px solid var(--entry-accent, #5eead4);
    border-bottom: 1px solid rgba(94, 234, 212, 0.16);
    letter-spacing: 0.02em;
    line-height: 1.42;
    text-wrap: balance;
  }
  body.present-mode .prose-akq h3 { font-size: 1.65rem; }
  body.present-mode .prose-akq pre,
  body.present-mode .mermaid-wrap {
    font-size: 1.05rem;
    padding: 2em;
    margin: 1.5em 0;
    width: 100% !important;
    max-width: none !important;
    max-height: 75vh;
    overflow-y: auto;
    overflow-x: auto;
  }
  body.present-mode .mermaid-wrap svg {
    max-width: none !important;
    width: auto !important;
    height: auto !important;
  }
  body.present-mode .prose-akq blockquote { font-size: 1.25rem; }

  /* ── Progress telemetry dots (top) ── */
  .slide-progress {
    display: none;
    position: fixed;
    top: 0; left: 0; right: 0;
    justify-content: center;
    align-items: center;
    padding: 7px 24px;
    gap: 6px;
    z-index: 60;
    background: linear-gradient(180deg, rgba(4, 8, 14, 0.92) 0%, transparent 100%);
    border-bottom: none;
  }
  body.present-mode .slide-progress { display: flex; }
  /* ── "New" markers pinned above flagged nav-bar segments ── */
  .slide-new-marker {
    display: none;
    position: fixed;
    z-index: 61;
    width: 5px;
    height: 5px;
    border-radius: 999px;
    background: #fcd34d;
    box-shadow: 0 0 6px rgba(252, 211, 77, 0.75);
    transform: translate(-50%, 3px);
    pointer-events: none;
  }
  body.present-mode .slide-new-marker { display: block; }
  .slide-new-arrow,
  .slide-new-text {
    display: none !important;
  }
  .slide-progress-bar {
    flex: 0 1 12px;
    min-width: 5px;
    border: 0;
    background: transparent;
    cursor: pointer;
    padding: 6px 0;
    position: relative;
    appearance: none;
    -webkit-appearance: none;
  }
  .slide-progress-bar[aria-selected="true"] {
    flex: 0 1 32px;
  }
  .slide-progress-bar::before {
    content: '';
    display: block;
    height: 4px;
    border-radius: 999px;
    background: rgba(114, 143, 163, 0.35);
    transition: background 0.2s ease, box-shadow 0.2s ease;
  }
  .slide-progress-bar.active::before {
    background: color-mix(in srgb, var(--entry-accent, #5eead4) 45%, transparent);
    box-shadow: none;
  }
  .slide-progress-bar[aria-selected="true"]::before {
    background: var(--entry-accent, #5eead4);
    box-shadow: 0 0 8px color-mix(in srgb, var(--entry-accent, #5eead4) 55%, transparent);
  }
  .slide-progress-bar:hover::before {
    background: color-mix(in srgb, var(--entry-accent, #5eead4) 75%, transparent);
  }
  .slide-progress-bar:focus-visible { outline: none; }
  .slide-progress-bar:focus-visible::before {
    background: var(--entry-accent, #5eead4);
    box-shadow: 0 0 8px var(--entry-accent, #5eead4);
  }

  /* ── Slide counter HUD readout pill (bottom right) ── */
  .slide-counter {
    display: none;
    position: fixed;
    bottom: 18px;
    right: 22px;
    z-index: 60;
    padding: 6px 12px;
    font-family: var(--font-mono-hud);
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.05em;
    color: var(--c-fg-strong);
    background: var(--c-bg-hud);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border: 1px solid rgba(94, 234, 212, 0.24);
    border-radius: var(--radius-ui);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.35);
    text-decoration: none;
    cursor: pointer;
    transition: border-color 0.18s ease, transform 0.18s ease, background 0.18s ease;
  }
  body.present-mode .slide-counter { display: inline-flex; align-items: center; }
  .slide-counter:hover {
    border-color: var(--entry-accent, #5eead4);
    background: var(--c-bg-elevated-hover);
    transform: translateY(-1px);
  }
  .slide-counter-text::before {
    content: '[ ';
    color: var(--c-fg-muted);
  }
  .slide-counter-text::after {
    content: ' ]';
    color: var(--c-fg-muted);
  }

  /* ── Slide title tag (top-left, hidden in present-mode when TOC active) ── */
  .slide-title-tag {
    display: none;
    position: fixed;
    top: 20px;
    left: 24px;
    z-index: 60;
    padding: 7px 14px;
    background: var(--c-bg-hud);
    border: 1px solid rgba(94, 234, 212, 0.24);
    border-radius: var(--radius-ui);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.35);
    color: var(--c-fg-strong);
    letter-spacing: 0.04em;
    align-items: center;
    gap: 10px;
    opacity: 0;
    transform: translateX(-12px);
    transition: opacity 0.35s ease, transform 0.35s cubic-bezier(0.16, 1, 0.3, 1);
    pointer-events: none;
    max-width: 80vw;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    font-family: var(--font-mono-hud), var(--font-prose);
    font-size: 13px;
    line-height: 1.2;
  }
  body.present-mode .slide-title-tag { display: flex; }
  body.present-mode .slide-title-tag.visible { opacity: 0.95; transform: translateX(0); }
  .slide-title-tag .tag-main { color: #93a8ff; display: inline-flex; align-items: center; gap: 8px; }
  .slide-title-tag .tag-main span { font-size: 1.05em; }
  .slide-title-tag .tag-sep { color: #5eead4; opacity: 0.7; font-size: 0.9em; }
  .slide-title-tag .tag-sub { color: #5eead4; font-family: var(--font-prose); font-size: 0.95em; }

  .slide-counter-bug {
    position: absolute;
    right: calc(100% + 12px);
    top: 50%;
    width: 1.35em;
    height: 1.35em;
    background-color: var(--entry-accent, #5eead4);
    -webkit-mask-image: url('/icons/bug.svg');
            mask-image: url('/icons/bug.svg');
    -webkit-mask-size: contain;
            mask-size: contain;
    -webkit-mask-repeat: no-repeat;
            mask-repeat: no-repeat;
    -webkit-mask-position: center;
            mask-position: center;
    filter: drop-shadow(0 0 6px color-mix(in srgb, var(--entry-accent, #5eead4) 55%, transparent));
    transform: translateY(-50%);
    transition: transform 0.18s ease, filter 0.18s ease;
    pointer-events: auto;
  }
  .slide-counter:hover .slide-counter-bug {
    transform: translateY(-50%) scale(1.1) rotate(-6deg);
    filter: drop-shadow(0 0 10px color-mix(in srgb, var(--entry-accent, #5eead4) 75%, transparent));
  }

  /* ─────────────────────────────────────────────────────────────
     Risk reveal — progressive-disclosure accordion
     Native <details name> gives exclusive open with no JS, so it works
     identically in document mode and in presentation mode.
     ───────────────────────────────────────────────────────────── */
  .prose-akq .risk-widget { margin: 1.2em 0; }
  .prose-akq .risk-hint {
    margin: 0 0 0.5em;
    font-family: var(--font-prose);
    font-size: 1em;
    letter-spacing: 0.02em;
    color: #fcd34d;
    text-shadow: none;
  }
  .prose-akq .risk-list {
    display: flex;
    flex-direction: column;
    gap: 0.25em;
  }
  .prose-akq .risk-item {
    position: relative;
    min-width: 0;
    border: 1px solid rgba(94, 234, 212, 0.22);
    border-radius: var(--radius-card);
    background: var(--c-bg-elevated);
  }
  .prose-akq .risk-item[open] {
    border: 1px solid rgba(251, 113, 133, 0.55);
    border-left: 3px solid #fb7185;
    background: rgba(251, 113, 133, 0.07);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.32);
  }
  .prose-akq .risk-btn {
    display: flex;
    align-items: center;
    gap: 0.6em;
    padding: 0.32em 0.65em;
    font-size: 0.95em;
    line-height: 1.4;
    color: var(--c-fg-strong);
    cursor: pointer;
    list-style: none;
    transition: background 0.15s ease, color 0.15s ease;
  }
  .prose-akq .risk-btn::-webkit-details-marker { display: none; }
  .prose-akq .risk-btn:hover { background: rgba(94, 234, 212, 0.06); }
  .prose-akq .risk-btn:focus-visible { outline: 2px solid #fcd34d; outline-offset: 2px; }
  .prose-akq .risk-num {
    flex: none;
    min-width: 1.6em;
    font-family: var(--font-mono-hud);
    font-size: 0.88em;
    font-weight: 600;
    line-height: 1;
    color: #5eead4;
  }
  .prose-akq .risk-item[open] .risk-num { color: #fcd34d; }
  .prose-akq .risk-icon { flex: none; font-size: 1em; line-height: 1; }
  .prose-akq .risk-label { flex: 0 1 auto; min-width: 0; }
  .prose-akq .risk-gauge {
    flex: none;
    display: inline-flex;
    gap: 2px;
    margin-left: auto;
    padding-right: 0.55em;
  }
  .prose-akq .risk-gauge i {
    display: block;
    width: 7px;
    height: 12px;
    border-radius: 1px;
    background: rgba(186, 208, 222, 0.16);
  }
  .prose-akq .risk-gauge i.on { background: #fb7185; box-shadow: 0 0 6px rgba(251, 113, 133, 0.55); }
  .prose-akq .risk-toggle {
    flex: none;
    font-family: var(--font-mono-hud);
    font-size: 1.15em;
    line-height: 1;
    color: #fcd34d;
    transition: transform 0.2s ease, color 0.15s ease;
  }
  .prose-akq .risk-toggle::before { content: '+'; }
  .prose-akq .risk-item[open] .risk-toggle { color: #fb7185; transform: rotate(45deg); }
  .prose-akq .risk-why {
    position: relative;
    margin: 0 0.65em;
    padding: 0.55em 0.6em 1.15em 2.3em;
    border-top: 1px solid rgba(251, 113, 133, 0.26);
    font-size: 0.88em;
    line-height: 1.6;
    color: var(--c-fg-body);
  }
  .prose-akq .risk-why b,
  .prose-akq .risk-why strong { color: #fcd34d; font-weight: 600; }
  .prose-akq .risk-item[open] .risk-why::after {
    content: '▊';
    margin-left: 0.15em;
    color: #fcd34d;
    animation: akq-risk-blink 1s steps(1) infinite;
  }
  .prose-akq .risk-item[open] .risk-why::before {
    content: 'ALERT';
    position: absolute;
    right: 0.35em;
    bottom: 0.25em;
    padding: 2px 6px;
    border: 1px solid rgba(251, 113, 133, 0.55);
    border-radius: 2px;
    font-family: var(--font-mono-hud);
    font-size: 0.62em;
    font-weight: 700;
    letter-spacing: 0.12em;
    color: #fb7185;
    opacity: 0.65;
    pointer-events: none;
  }
  @keyframes akq-risk-blink {
    0%, 49% { opacity: 1; }
    50%, 100% { opacity: 0; }
  }
  /* Smooth open/close where the engine supports it; instant elsewhere. */
  @supports (interpolate-size: allow-keywords) {
    .prose-akq .risk-widget { interpolate-size: allow-keywords; }
    .prose-akq .risk-item::details-content {
      block-size: 0;
      overflow: hidden;
      content-visibility: hidden;
      transition: block-size 0.28s ease, content-visibility 0.28s allow-discrete;
    }
    .prose-akq .risk-item[open]::details-content {
      block-size: auto;
      content-visibility: visible;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .prose-akq .risk-item[open] .risk-why::after { animation: none; }
    .prose-akq .risk-item::details-content { transition: none; }
    .prose-akq .risk-toggle { transition: none; }
  }

  /* ─────────────────────────────────────────────────────────────
     Spec reveal — key / since accordion
     ───────────────────────────────────────────────────────────── */
  .prose-akq .spec-widget { margin: 1.2em 0; }
  .prose-akq .spec-hint {
    margin: 0 0 0.5em;
    font-family: var(--font-prose);
    font-size: 1em;
    letter-spacing: 0.02em;
    color: #fcd34d;
    text-shadow: none;
  }
  .prose-akq .spec-list {
    display: flex;
    flex-direction: column;
    gap: 0.25em;
  }
  .prose-akq .spec-item {
    position: relative;
    min-width: 0;
    border: 1px solid color-mix(in srgb, var(--entry-accent, #5eead4) 24%, transparent);
    border-radius: var(--radius-card);
    background: var(--c-bg-elevated);
  }
  .prose-akq .spec-item[open] {
    border: 1px solid color-mix(in srgb, var(--entry-accent, #5eead4) 55%, transparent);
    border-left: 3px solid var(--entry-accent, #5eead4);
    background: var(--c-bg-elevated-hover);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.32);
  }
  .prose-akq .spec-btn {
    display: flex;
    align-items: center;
    gap: 0.55em;
    padding: 0.28em 0.6em;
    font-size: 0.95em;
    line-height: 1.4;
    color: var(--c-fg-strong);
    cursor: pointer;
    list-style: none;
    transition: background 0.15s ease;
  }
  .prose-akq .spec-btn::-webkit-details-marker { display: none; }
  .prose-akq .spec-btn:hover { background: rgba(94, 234, 212, 0.06); }
  .prose-akq .spec-btn:focus-visible { outline: 2px solid #fcd34d; outline-offset: 2px; }
  .prose-akq .spec-icon { flex: none; font-size: 1em; line-height: 1; }
  .prose-akq .spec-key {
    display: flex;
    flex: 0 1 auto;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.35em;
    min-width: 0;
    overflow-wrap: break-word;
  }
  .prose-akq .spec-key code { font-size: 0.86em; }
  /* Who decides the key: a team file (overridable / additive) or only the enterprise. */
  .prose-akq .spec-tag {
    flex: none;
    padding: 0.06em 0.42em;
    font-family: var(--font-mono-hud), var(--font-prose);
    font-size: 0.68em;
    font-weight: 600;
    line-height: 1.4;
    letter-spacing: 0.06em;
    white-space: nowrap;
    border: 1px solid currentColor;
    border-radius: 2px;
  }
  .prose-akq .spec-tag.is-team,
  .prose-akq .spec-tag.is-add { color: #5eead4; background: rgba(94, 234, 212, 0.1); }
  .prose-akq .spec-tag.is-locked { color: #fb7185; background: rgba(251, 113, 133, 0.12); }
  .prose-akq .spec-since {
    flex: none;
    margin-left: auto;
    padding: 0.08em 0.42em;
    font-family: var(--font-mono-hud), var(--font-prose);
    font-size: 0.84em;
    line-height: 1.3;
    letter-spacing: 0.04em;
    white-space: nowrap;
    color: #fcd34d;
    text-decoration: none;
    border: 1px solid rgba(252, 211, 77, 0.35);
    border-radius: 2px;
    transition: color 0.15s ease, background 0.15s ease, border-color 0.15s ease;
  }
  .prose-akq .spec-since::after { content: ' ↗'; }
  .prose-akq .spec-since:hover,
  .prose-akq .spec-since:focus-visible {
    color: #04080e;
    background: #fcd34d;
    border-color: #fcd34d;
    text-shadow: none;
  }
  .prose-akq .spec-toggle {
    flex: none;
    font-family: var(--font-mono-hud);
    font-size: 1.15em;
    line-height: 1;
    color: #fcd34d;
    transition: transform 0.2s ease, color 0.15s ease;
  }
  .prose-akq .spec-toggle::before { content: '+'; }
  .prose-akq .spec-item[open] .spec-toggle {
    color: var(--entry-accent, #5eead4);
    transform: rotate(45deg);
  }
  .prose-akq .spec-what {
    margin: 0 0.6em;
    padding: 0.5em 0.6em 0.6em 2.15em;
    border-top: 1px solid color-mix(in srgb, var(--entry-accent, #5eead4) 24%, transparent);
    font-size: 0.88em;
    line-height: 1.6;
    color: var(--c-fg-body);
  }
  .prose-akq .spec-what b,
  .prose-akq .spec-what strong { color: #fcd34d; font-weight: 600; }
  /* A bare URL has no break opportunity and would blow out the cell. */
  .prose-akq .spec-what code {
    font-size: 0.92em;
    overflow-wrap: anywhere;
  }
  .prose-akq .spec-item[open] .spec-what::after {
    content: '▊';
    margin-left: 0.15em;
    color: #fcd34d;
    animation: akq-risk-blink 1s steps(1) infinite;
  }
  /* Narrow screens: an explicit 2-row grid so the key keeps a full-width
     column and the date sits under it, instead of flex-wrapping every
     child onto its own line. */
  @media (max-width: 640px) {
    .prose-akq .spec-btn {
      display: grid;
      grid-template-columns: auto minmax(0, 1fr) auto;
      grid-template-areas:
        "icon key toggle"
        "icon since toggle";
      align-items: center;
      column-gap: 0.5em;
