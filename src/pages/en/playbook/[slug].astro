  .prose-akq .pd-icon {
    font-size: 2.3rem;
    line-height: 1;
    margin-bottom: 0.3em;
  }
  .prose-akq .pd-title {
    font-size: 1.3rem;
    font-weight: 700;
    color: var(--pd-color);
    letter-spacing: 0.03em;
    margin-bottom: 0.2em;
  }
  .prose-akq .pd-sub {
    font-size: 0.95rem;
    color: var(--c-fg-body);
    margin-bottom: 0.6em;
    line-height: 1.4;
  }
  .prose-akq .pd-cost {
    display: inline-block;
    font-family: var(--font-mono-hud);
    font-weight: 600;
    font-size: 0.78rem;
