---
import Layout from '../../../components/layout/Layout.astro';
import '../../../styles/pull-request-slides.css';
import '../../../styles/fusion-slides.css';
import '../../../styles/github-platform-slide.css';
import '../../../styles/github-summary-slides.css';
import { render } from 'astro:content';
import MenuArrow from '../../../components/retro/MenuArrow.astro';
import PlaybookZettelkastenModal from '../../../components/playbook/PlaybookZettelkastenModal.astro';
import { accentColorValues } from '../../../lib/theme';
import { categories, localizedCategory } from '../../../lib/playbook-categories';
import { localizedPath, siteCopy } from '../../../lib/i18n';
import { getPlaybookEntries, playbookEntryKicker, playbookEntryTitle } from '../../../lib/playbook';
import { formatPlaybookUpdated, isNewPlaybookEntry, navHintSlides, playbookUpdatedISO } from '../../../lib/playbook-meta';

const locale = 'en';
const t = siteCopy[locale];

export async function getStaticPaths() {
  const entries = await getPlaybookEntries('en');
  return entries.map((item) => ({
    params: { slug: item.slug },
    props: { item },
  }));
}

const { item } = Astro.props;
const entry = item.entry;
const { Content } = await render(entry);

const all = await getPlaybookEntries(locale);
const idx = all.findIndex((e) => e.slug === item.slug);
const prev = idx > 0 ? all[idx - 1] : null;
const next = idx < all.length - 1 ? all[idx + 1] : null;

const tocEntries = all.map((e) => ({
  id: e.slug,
  title: e.entry.data.titleEn || playbookEntryTitle(e),
  titleEn: playbookEntryKicker(e),
  icon: e.entry.data.icon,
  category: e.entry.data.category,
  isNew: isNewPlaybookEntry(e.slug),
  url: localizedPath(locale, `/playbook/${e.slug}`),
}));

const updatedLabel = formatPlaybookUpdated(playbookUpdatedISO(item), locale);
const newBadgeLabel = t.playbook.newBadge;
const navHintSlideNumbers = navHintSlides(item.slug);

const tocGroups = categories
  .map((cat) => ({
    cat: localizedCategory(cat, locale),
    color: accentColorValues[cat.color],
    items: tocEntries.filter((t) => t.category === cat.id),
  }))
  .filter((g) => g.items.length > 0);

let _tocIdx = 0;

const category = categories.find((c) => c.id === entry.data.category);
const accentColor = category?.color ?? entry.data.color;
const accent = accentColorValues[accentColor];

// Group links by `group` field; preserve original order; treat ungrouped as "" (rendered without heading)
const linkGroups: { name: string; items: typeof entry.data.links }[] = [];
for (const link of entry.data.links) {
  const g = link.group ?? '';
  let bucket = linkGroups.find((lg) => lg.name === g);
  if (!bucket) {
    bucket = { name: g, items: [] };
    linkGroups.push(bucket);
  }
  bucket.items.push(link);
}
const hasGroups = linkGroups.some((g) => g.name !== '');
---

<Layout locale={locale} currentPath={`/playbook/${item.slug}`} title={`${playbookEntryTitle(item)} — ${t.playbook.heading}`}>
  <script is:inline>
    // Apply present-mode classes synchronously so the full article does not flash before slides initialize.
    if (new URLSearchParams(location.search).get('present') === '1') {
      document.documentElement.classList.add('present-mode');
      document.documentElement.classList.add('slide-preparing');
      document.body.classList.add('present-mode');
      document.body.classList.add('slide-preparing');
      const _initSlide = parseInt(new URLSearchParams(location.search).get('slide') || '1', 10) || 1;
      if (_initSlide <= 1) document.body.classList.add('slide-cover');
    }
  </script>
  <script is:inline define:vars={{ BASE: import.meta.env.BASE_URL }}>
    // Warm the HTTP cache for every category backdrop so present-mode TOC
    // navigation never flashes a black background while the next webp loads.
    // `new Image()` requests are low-priority by default so this does not
    // compete with first paint, but starts immediately rather than waiting
    // for browser idle (which can delay if the user clicks quickly).
    (function preloadBackdrops() {
      var cats = ['introduction', 'plan', 'develop', 'review', 'secure', 'operate', 'administration'];
      var base = BASE.charAt(BASE.length - 1) === '/' ? BASE : BASE + '/';
      cats.forEach(function (cat) {
        var img = new Image();
        img.decoding = 'async';
        img.src = base + 'slide-bg-' + cat + '.webp';
      });
    })();
  </script>
  <section
    class="max-w-5xl mx-auto px-4 py-12 playbook-detail"
    style={`--entry-accent:${accent}`}
    data-category={entry.data.category}
    data-prev={prev ? localizedPath(locale, `/playbook/${prev.slug}`) : ''}
    data-next={next ? localizedPath(locale, `/playbook/${next.slug}`) : ''}
    data-index={localizedPath(locale, '/playbook')}
  >
    <a href={localizedPath(locale, '/playbook')} class="playbook-back-link">{t.playbook.backToList}</a>

    <header class="playbook-entry-header">
      <div class="flex items-center gap-2.5 mb-2.5 flex-wrap">
        <span class="playbook-entry-no">
          NO.{String(entry.data.order).padStart(2, '0')}
        </span>
        {category && (
          <span class="playbook-entry-cat">
            {category.icon} {category.labelEn}
          </span>
        )}
      </div>
      <h1 class="playbook-entry-title">
        {entry.data.icon && /\.(svg|png|jpg|jpeg|webp|gif)$/i.test(entry.data.icon)
          ? <img src={entry.data.icon} alt="" class="h-[1.15em] w-auto shrink-0" />
          : <span class="text-[1.1em] leading-none shrink-0">{entry.data.icon}</span>}
        <span>{playbookEntryTitle(item)}</span>
      </h1>
      <div class="flex items-baseline flex-wrap gap-x-4 gap-y-1 mb-2">
        {playbookEntryKicker(item) && <p class="playbook-entry-kicker">{playbookEntryKicker(item)}</p>}
        {updatedLabel && (
          <span class="playbook-entry-updated">
            {t.playbook.updated}: {updatedLabel}
          </span>
        )}
      </div>
      {item.isFallback && (
        <p class="playbook-entry-fallback">
          {t.common.translationPending}
        </p>
      )}
    </header>

    <article class="prose-akq" data-category={entry.data.category} style={`--entry-accent:${accent}`}>
      <Content />
    </article>

    {entry.data.links.length > 0 && (
      <aside class="links-aside mt-10">
        <h2 class="links-aside-title">{t.playbook.officialLinks}</h2>
        {hasGroups ? (
          <div class="space-y-6">
            {linkGroups.map((g) => (
              <div>
                {g.name && (
                  <h3 class="links-aside-group">
                    {g.name}
                  </h3>
                )}
                <ul class="space-y-2.5">
                  {g.items.map((l) => (
                    <li class="links-aside-item">
                      <MenuArrow /> <a href={l.url} target="_blank" rel="noopener noreferrer" class="retro-link">{l.label}</a>
                    </li>
                  ))}
                </ul>
              </div>
            ))}
          </div>
        ) : (
          <ul class="space-y-2.5">
            {entry.data.links.map((l) => (
              <li class="links-aside-item">
                <MenuArrow /> <a href={l.url} target="_blank" rel="noopener noreferrer" class="retro-link">{l.label}</a>
              </li>
            ))}
          </ul>
        )}
      </aside>
    )}

    {entry.data.related.length > 0 && (
      <aside class="related-aside mt-8">
        <h2 class="related-aside-title">{t.playbook.related}</h2>
        <div class="flex flex-wrap gap-2">
          {entry.data.related.map((slug) => {
            const r = all.find((e) => e.slug === slug);
            if (!r) return null;
            return (
              <a
                href={localizedPath(locale, `/playbook/${r.slug}`)}
                class="related-pill"
              >
                {r.entry.data.icon && /\.(svg|png|jpg|jpeg|webp|gif)$/i.test(r.entry.data.icon)
                  ? <img src={r.entry.data.icon} alt="" class="inline h-[1em] w-auto align-middle mr-1" />
                  : <span>{r.entry.data.icon} </span>}{playbookEntryTitle(r)}
              </a>
            );
          })}
        </div>
      </aside>
    )}

    <nav class="entry-pagination mt-12 grid grid-cols-2 gap-4">
      {prev ? (
        <a href={localizedPath(locale, `/playbook/${prev.slug}`)} class="entry-page-link">
          ◀ {playbookEntryTitle(prev)}
        </a>
      ) : <span></span>}
      {next ? (
        <a href={localizedPath(locale, `/playbook/${next.slug}`)} class="entry-page-link is-next">
          {playbookEntryTitle(next)} ▶
        </a>
      ) : <span></span>}
    </nav>

    <button
      type="button"
      id="present-toggle"
      class="present-hint"
      aria-label="Toggle presentation mode"
    >
      <span class="key">P</span> {t.playbook.presentationMode}
    </button>

    <div class="present-overlay-hint">
      <span>
        <button
          type="button"
          class="key key-button"
          data-slide-action="prev"
          aria-label="Previous slide"
          title="Previous slide (←)"
        >◀</button>
        <button
          type="button"
          class="key key-button"
          data-slide-action="next"
          aria-label="Next slide"
          title="Next slide (→ / Space)"
        >▶</button>
        {t.playbook.slides}
      </span>
      <button
        type="button"
        class="present-action-btn"
        data-slide-action="exit"
        aria-label="Exit presentation"
        title="Exit (Esc)"
      >
        <span class="key">Esc</span> {t.playbook.exit}
      </button>
      <button type="button" class="present-toc-toggle" aria-label="Toggle TOC" data-toc-toggle>
        <span class="key">T</span> TOC
      </button>
      <a
        class="present-lang-toggle"
        href={`${localizedPath('ja', `/playbook/${item.slug}`)}?present=1`}
        data-other-locale-base={localizedPath('ja', `/playbook/${item.slug}`)}
        aria-label="日本語に切り替え"
      ><span class="key">日本語</span></a>
    </div>

    <div class="slide-progress" role="tablist" aria-label="Slides" data-hint-slides={navHintSlideNumbers.join(',')} data-new-label={newBadgeLabel}></div>
    <PlaybookZettelkastenModal locale={locale} slug={item.slug} category={entry.data.category} />
    <a
      class="slide-counter"
      href={t.handson.bugReportUrl}
      target="_blank"
      rel="noopener noreferrer"
      aria-label="Report a bug (new tab)"
      title="Report a bug"
    >
      <span class="slide-counter-bug" aria-hidden="true"></span>
      <span class="slide-counter-text"></span>
    </a>
    <div class="slide-title-tag" aria-hidden="true"></div>
    <nav class="present-toc" aria-label={t.playbook.tocLabel} data-current-id={item.slug} transition:persist={`present-toc-${locale}`}>
      {tocGroups.map((g) => (
        <>
          <div class="toc-section" style={`color:${g.color}; border-color:${g.color}`}>
            {g.cat.labelEn}
          </div>
          {g.items.map((t) => {
            _tocIdx += 1;
            const num = _tocIdx;
            return (
              <a
                href={t.url}
                class="toc-item"
                data-id={t.id}
                data-active={t.id === item.slug ? 'true' : 'false'}
                style={`--cat-color:${g.color}`}
              >
                <span class="toc-num">{String(num).padStart(2, '0')}</span>
                <span class="toc-text">
                  {t.icon && /\.(svg|png|jpg|jpeg|webp|gif)$/i.test(t.icon)
                    ? <img src={t.icon} alt="" class="inline h-[1em] w-auto align-middle mr-3" />
                    : <span>{t.icon} </span>}<span class="toc-title-text">{t.title}{t.isNew && <span class="toc-new-badge">{newBadgeLabel}</span>}</span>
                </span>
              </a>
            );
          })}
        </>
      ))}
    </nav>
  </section>
</Layout>

<script>
  import { handlePlaybookVideoKey, pausePlaybookVideos, syncPlaybookVideos } from '../../../lib/playbook-video';

  // ── Slide engine (split content by <h2>; cover = header + first H2 group) ──
  type Slide = HTMLElement[];
  let slides: Slide[] = [];
  let current = 0;
  let restoreFns: Array<() => void> = [];
  let slideRefreshToken = 0;
  let preservedTocScrollTop: number | null = null;
  const SLIDE_PREPARING_CLASS = 'slide-preparing';
  // Set true when Esc fires inside present mode to short-circuit the
  // present→article paint and propagate "no present" onto the destination doc.
  let escapingFromPresent = false;

  function setSlidePreparing(on: boolean) {
    document.documentElement.classList.toggle(SLIDE_PREPARING_CLASS, on);
    document.body.classList.toggle(SLIDE_PREPARING_CLASS, on);
  }

  function buildSlides(): Slide[] {
    const section = document.querySelector<HTMLElement>('.playbook-detail');
    if (!section) return [];
    const header = section.querySelector<HTMLElement>(':scope > header');
    const article = section.querySelector<HTMLElement>(':scope > article.prose-akq');
    if (!article) return header ? [[header]] : [];

    const groups: HTMLElement[][] = [];
    let bucket: HTMLElement[] = [];
    Array.from(article.children).forEach((child) => {
      const el = child as HTMLElement;
      if (el.tagName === 'H2' && bucket.length > 0) {
        groups.push(bucket);
        bucket = [el];
      } else {
        bucket.push(el);
      }
    });
    if (bucket.length) groups.push(bucket);

    if (header && groups[0]) groups[0] = [header, ...groups[0]];
    else if (header) groups.unshift([header]);

    const linksAside = section.querySelector<HTMLElement>(':scope > aside.links-aside');
    if (linksAside) groups.push([linksAside]);

    return groups;
  }

  // ── Hero-quote typewriter reveal ─────────────────────────────
  type HeroReveal = {
    textNodes: Text[];
    originals: string[];
    total: number;
    timer: ReturnType<typeof setTimeout> | null;
  };
  const heroReveals = new Map<HTMLElement, HeroReveal>();
  const HERO_REVEAL_SPEED_MS = 18;
  const HERO_REVEAL_DELAY_MS = 140;

  function captureHero(el: HTMLElement): HeroReveal {
    const cached = heroReveals.get(el);
    if (cached) return cached;
    const textNodes: Text[] = [];
    const walker = document.createTreeWalker(el, NodeFilter.SHOW_TEXT);
    let n: Node | null = walker.nextNode();
    while (n) {
      textNodes.push(n as Text);
      n = walker.nextNode();
    }
    const originals = textNodes.map((t) => t.nodeValue ?? '');
    const total = originals.reduce((sum, s) => sum + s.length, 0);
    const data: HeroReveal = { textNodes, originals, total, timer: null };
    heroReveals.set(el, data);
    return data;
  }

  function applyHeroShown(data: HeroReveal, shown: number) {
    let remaining = shown;
    for (let i = 0; i < data.textNodes.length; i++) {
      const full = data.originals[i];
      if (remaining <= 0) {
        data.textNodes[i].nodeValue = '';
        continue;
      }
      const take = Math.min(full.length, remaining);
      data.textNodes[i].nodeValue = full.slice(0, take);
      remaining -= take;
    }
  }

  function finishHero(el: HTMLElement) {
    const data = heroReveals.get(el);
    if (!data) return;
    if (data.timer) {
      clearTimeout(data.timer);
      data.timer = null;
    }
    applyHeroShown(data, data.total);
    el.style.minHeight = '';
    el.classList.remove('akq-typing');
  }

  function startHeroReveal(el: HTMLElement) {
    const data = captureHero(el);
    if (data.timer) {
      clearTimeout(data.timer);
      data.timer = null;
    }
    if (data.total === 0) {
      el.classList.remove('akq-typing');
      return;
    }
    const reduceMotion = window.matchMedia?.('(prefers-reduced-motion: reduce)').matches;
    if (reduceMotion) {
      applyHeroShown(data, data.total);
      el.classList.remove('akq-typing');
      return;
    }
    // Snapshot rendered height with full text so the bubble doesn't collapse during reveal
    applyHeroShown(data, data.total);
    const h = el.getBoundingClientRect().height;
    if (h > 0) el.style.minHeight = h + 'px';
    applyHeroShown(data, 0);
    el.classList.add('akq-typing');
    let i = 0;
    const tick = () => {
      i += 1;
      applyHeroShown(data, i);
      if (i < data.total) {
        data.timer = setTimeout(tick, HERO_REVEAL_SPEED_MS);
      } else {
        data.timer = null;
        el.style.minHeight = '';
        el.classList.remove('akq-typing');
      }
    };
    data.timer = setTimeout(tick, HERO_REVEAL_DELAY_MS);
  }

  function syncHeroReveals() {
    const all = document.querySelectorAll<HTMLElement>('.prose-akq .hero-quote');
    all.forEach((el) => {
      const slideEl = el.closest('.akq-slide-el');
      const isActive = slideEl?.classList.contains('akq-slide-active');
      if (isActive) startHeroReveal(el);
      else finishHero(el);
    });
  }

  function finishAllHeroReveals() {
    heroReveals.forEach((_, el) => finishHero(el));
  }

  // Delegated click-to-skip on hero-quotes
  if (!(window as any).__akqHeroSkipBound) {
    (window as any).__akqHeroSkipBound = true;
    document.addEventListener('click', (e) => {
      if (!document.body.classList.contains('present-mode')) return;
      const target = e.target as HTMLElement | null;
      if (!target) return;
      if (target.closest('a')) return;
      const bubble = target.closest<HTMLElement>('.prose-akq .hero-quote');
      if (bubble) finishHero(bubble);
    });
  }

  function showSlide(i: number) {
    if (!slides.length) return;
    current = Math.max(0, Math.min(slides.length - 1, i));
    slides.forEach((slide, idx) => {
      const active = idx === current;
      slide.forEach((el) => {
        el.classList.toggle('akq-slide-hidden', !active);
        el.classList.toggle('akq-slide-active', active);
      });
    });
    // A DEMO overlay belongs to the slide that opened it — never let it
    // re-appear when the presenter comes back to that slide later.
    document
      .querySelectorAll<HTMLInputElement>('.demo-toggle:checked')
      .forEach((el) => { el.checked = false; });
    updateChrome();
    syncHeroReveals();
    syncPlaybookVideos();
  }

  function updateChrome() {
    const counter = document.querySelector<HTMLElement>('.slide-counter');
    if (counter) {
      const text = counter.querySelector<HTMLElement>('.slide-counter-text');
      if (text) text.textContent = `${current + 1} / ${slides.length}`;
    }
    const prog = document.querySelector<HTMLElement>('.slide-progress');
    if (prog) {
      prog.innerHTML = '';
      for (let i = 0; i < slides.length; i++) {
        const bar = document.createElement('button');
        bar.type = 'button';
        bar.className = 'slide-progress-bar' + (i <= current ? ' active' : '');
        bar.dataset.slideIndex = String(i);
        bar.setAttribute('role', 'tab');
        bar.setAttribute('aria-label', `Slide ${i + 1}`);
        bar.setAttribute('aria-selected', i === current ? 'true' : 'false');
        bar.addEventListener('click', () => {
          showSlide(i);
          const url = new URL(window.location.href);
          if (i > 0) url.searchParams.set('slide', String(i + 1));
          else url.searchParams.delete('slide');
          history.replaceState(null, '', url.pathname + url.search);
        });
        prog.appendChild(bar);
      }
    }
    const tag = document.querySelector<HTMLElement>('.slide-title-tag');
    if (tag) {
      const titleEl = document.querySelector<HTMLElement>('.playbook-detail header h1');
      const titleText = titleEl?.textContent ?? '';
      tag.replaceChildren();
      if (current !== 0) {
        const titleSpan = document.createElement('span');
        titleSpan.className = 'tag-main';
        titleSpan.textContent = titleText;
        tag.appendChild(titleSpan);
      }
      tag.classList.toggle('visible', current > 0);
    }
    document.body.classList.toggle('slide-cover', current === 0);
    placeNewMarkers();
    // Update active item in left TOC (now playbook-entry-based, handled by syncToc)
  }

  // Pin an always-visible "New!" marker above each flagged slide's progress-bar segment.
  function placeNewMarkers() {
    document.querySelectorAll('.slide-new-marker').forEach((e) => e.remove());
    const prog = document.querySelector<HTMLElement>('.slide-progress');
    if (!prog) return;
    const raw = prog.dataset.hintSlides || '';
    const label = prog.dataset.newLabel || 'New!';
    const idxs = raw
      .split(',')
      .map((s) => parseInt(s.trim(), 10))
      .filter((n) => !Number.isNaN(n));
    if (!idxs.length) return;
    const bars = prog.querySelectorAll<HTMLElement>('.slide-progress-bar');
    const progRect = prog.getBoundingClientRect();
    idxs.forEach((idx) => {
      const bar = bars[idx];
      if (!bar) return;
      const r = bar.getBoundingClientRect();
      const marker = document.createElement('div');
      marker.className = 'slide-new-marker';
      marker.setAttribute('aria-hidden', 'true');
      const svg = document.createElementNS('http://www.w3.org/2000/svg', 'svg');
      svg.classList.add('slide-new-arrow');
      svg.setAttribute('viewBox', '0 0 44 40');
      svg.setAttribute('fill', 'none');
      const arrowPath = document.createElementNS('http://www.w3.org/2000/svg', 'path');
      arrowPath.setAttribute('d', 'M36 34 C 25 31, 15 25, 10 10');
      arrowPath.setAttribute('stroke', '#fcd34d');
      arrowPath.setAttribute('stroke-width', '3.4');
      arrowPath.setAttribute('stroke-linecap', 'round');
      const headPath = document.createElementNS('http://www.w3.org/2000/svg', 'path');
      headPath.setAttribute('d', 'M4 21 L9 7 L22 12');
      headPath.setAttribute('stroke', '#fcd34d');
      headPath.setAttribute('stroke-width', '3.4');
      headPath.setAttribute('stroke-linecap', 'round');
      headPath.setAttribute('stroke-linejoin', 'round');
      svg.append(arrowPath, headPath);
      const textEl = document.createElement('span');
      textEl.className = 'slide-new-text';
      textEl.textContent = label;
      marker.append(svg, textEl);
      marker.style.left = `${r.left + r.width / 2}px`;
      marker.style.top = `${progRect.bottom}px`;
      document.body.appendChild(marker);
    });
  }

  // ── TOC across playbook entries ──────────────────────────────
  function rememberTocScroll() {
    const toc = document.querySelector<HTMLElement>('.present-toc');
    if (toc) preservedTocScrollTop = toc.scrollTop;
  }

  function restoreTocScroll(toc: HTMLElement) {
    if (preservedTocScrollTop === null) return;
    const top = preservedTocScrollTop;
    toc.scrollTop = top;
    requestAnimationFrame(() => {
      toc.scrollTop = top;
      requestAnimationFrame(() => {
        toc.scrollTop = top;
        if (preservedTocScrollTop === top) preservedTocScrollTop = null;
      });
    });
  }

  function syncToc() {
    const toc = document.querySelector<HTMLElement>('.present-toc');
    if (!toc) return;
    const currentScrollTop = preservedTocScrollTop ?? toc.scrollTop;
    const currentId = (location.pathname.match(/\/(?:en\/)?playbook\/([^/]+)/)?.[1]) || toc.dataset.currentId || '';
    const items = Array.from(toc.querySelectorAll<HTMLElement>('.toc-item'));
    items.forEach((el) => {
      el.classList.remove('toc-hidden');
      el.classList.toggle('active', el.dataset.id === currentId);
      // Preserve present mode in target href when navigating
      if (document.body.classList.contains('present-mode')) {
        const u = new URL(el.getAttribute('href') || '', window.location.origin);
        u.searchParams.set('present', '1');
        u.searchParams.delete('slide');
        el.setAttribute('href', u.pathname + (u.search ? u.search : ''));
      }
    });
    // Do not auto-scroll the TOC: keep the user's current sidebar position stable.
    toc.scrollTop = currentScrollTop;
    restoreTocScroll(toc);
  }

  function enterSlideMode(startSlide?: number) {
    slides = buildSlides();
    if (!slides.length) return;

    // Tag every slide element so CSS can apply
    slides.forEach((slide) => slide.forEach((el) => el.classList.add('akq-slide-el')));
    restoreFns.push(() => {
      slides.forEach((slide) =>
        slide.forEach((el) => {
          el.classList.remove('akq-slide-el', 'akq-slide-hidden', 'akq-slide-active');
        })
      );
    });

    syncToc();

    // start at slide param (1-indexed in the URL) or the cover slide
    const params = new URLSearchParams(window.location.search);
    const raw = params.get('slide');
    const s = startSlide ?? (raw === null ? 0 : parseInt(raw, 10) - 1);
    showSlide(isNaN(s) ? 0 : s);
  }

  function resetChrome() {
    const counter = document.querySelector<HTMLElement>('.slide-counter');
    if (counter) {
      const text = counter.querySelector<HTMLElement>('.slide-counter-text');
      if (text) text.textContent = '';
    }
    const prog = document.querySelector<HTMLElement>('.slide-progress');
    if (prog) prog.innerHTML = '';
    const tag = document.querySelector<HTMLElement>('.slide-title-tag');
    if (tag) {
      tag.innerHTML = '';
      tag.classList.remove('visible');
    }
    document.body.classList.remove('slide-cover');
  }

  function exitSlideMode() {
    pausePlaybookVideos();
    finishAllHeroReveals();
    restoreFns.forEach((fn) => fn());
    restoreFns = [];
    document
      .querySelectorAll<HTMLElement>('.akq-slide-el, .akq-slide-hidden, .akq-slide-active')
      .forEach((el) => {
        el.classList.remove('akq-slide-el', 'akq-slide-hidden', 'akq-slide-active');
      });
    slides = [];
    current = 0;
    resetChrome();
  }

  async function refreshSlideMode() {
    const token = ++slideRefreshToken;
    setSlidePreparing(true);
    exitSlideMode();
    if (!document.body.classList.contains('present-mode')) {
      setSlidePreparing(false);
      return;
    }
    if (!document.querySelector('.playbook-detail')) {
      setSlidePreparing(false);
      return;
    }
    await renderMermaid();
    if (token !== slideRefreshToken) return;
    if (!document.body.classList.contains('present-mode')) {
      setSlidePreparing(false);
      return;
    }
    if (!document.querySelector('.playbook-detail')) {
      setSlidePreparing(false);
      return;
    }
    enterSlideMode();
    syncSlideUrl();
    requestAnimationFrame(() => {
      if (token === slideRefreshToken) setSlidePreparing(false);
    });
  }

  // ── Presentation mode toggle ───────────────────────────────────
  function setPresent(on: boolean) {
    if (on && !document.querySelector('.playbook-detail')) return;
    const wasOn = document.body.classList.contains('present-mode');
    document.body.classList.toggle('present-mode', on);
    document.documentElement.classList.toggle('present-mode', on);
    if (on) restoreTocPref();
    const url = new URL(window.location.href);
    if (on) url.searchParams.set('present', '1');
    else { url.searchParams.delete('present'); url.searchParams.delete('slide'); }
    history.replaceState(null, '', url.pathname + (url.search || '') + url.hash);

    if (on) void refreshSlideMode();
    if (!on) {
      slideRefreshToken++;
      setSlidePreparing(false);
      if (wasOn || slides.length) exitSlideMode();
      syncPlaybookVideos();
    }

    if (on) {
      document.querySelectorAll<SVGSVGElement>('.mermaid-wrap svg').forEach((svg) => {
        svg.removeAttribute('width');
        svg.removeAttribute('height');
        svg.style.maxWidth = 'none';
        svg.style.width = '100%';
        svg.style.height = 'auto';
      });
    }
  }

  function syncSlideUrl() {
    const url = new URL(window.location.href);
    if (current > 0) url.searchParams.set('slide', String(current + 1));
    else url.searchParams.delete('slide');
    const nextUrl = url.pathname + (url.search || '') + url.hash;
    if (nextUrl !== window.location.pathname + window.location.search + window.location.hash) {
      history.replaceState(null, '', nextUrl);
    }
  }

  function initPresent() {
    const params = new URLSearchParams(window.location.search);
    setPresent(params.get('present') === '1');
    const btn = document.getElementById('present-toggle');
    if (btn && !btn.dataset.bound) {
      btn.dataset.bound = '1';
      btn.addEventListener('click', () =>
        setPresent(!document.body.classList.contains('present-mode'))
      );
    }
    const langToggle = document.querySelector<HTMLAnchorElement>('.present-lang-toggle');
    if (langToggle && !langToggle.dataset.bound) {
      langToggle.dataset.bound = '1';
      langToggle.addEventListener('click', (e) => {
        e.preventDefault();
        const base = langToggle.dataset.otherLocaleBase || langToggle.getAttribute('href') || '';
        const cleanBase = base.split('?')[0];
        const params = new URLSearchParams();
        params.set('present', '1');
        if (current > 0) params.set('slide', String(current + 1));
        navigateSmooth(`${cleanBase}?${params.toString()}`);
      });
    }
    document.querySelectorAll<HTMLButtonElement>('[data-slide-action]').forEach((b) => {
      if (b.dataset.bound) return;
      b.dataset.bound = '1';
      b.addEventListener('click', (e) => {
        e.preventDefault();
        b.blur();
        const action = b.dataset.slideAction;
        const keyMap: Record<string, string> = { prev: 'ArrowLeft', next: 'ArrowRight', exit: 'Escape' };
        const key = keyMap[action || ''];
        if (key) {
          document.body.dispatchEvent(new KeyboardEvent('keydown', { key, bubbles: true, cancelable: true }));
        }
      });
    });
  }

  function onKey(e: KeyboardEvent) {
    if (document.body.classList.contains('akq-zk-open')) return;
    if (handlePlaybookVideoKey(e)) return;
    const t = e.target as HTMLElement | null;
    // The DEMO overlay is a CSS-only checkbox, so Escape has to close it here
    // before the global handler reads Escape as "leave presentation mode".
    if (e.key === 'Escape') {
      const openDemo = document.querySelector<HTMLInputElement>('.demo-toggle:checked');
      if (openDemo) {
        e.preventDefault();
        openDemo.checked = false;
        openDemo.blur();
        return;
      }
    }
    if (t && t.matches('input:not(.ctl-check),textarea,select')) return;
    const section = document.querySelector<HTMLElement>('.playbook-detail');
    if (!section) return;
    const present = document.body.classList.contains('present-mode');

    if (e.key === 'p' || e.key === 'P') {
      e.preventDefault();
      setPresent(!present);
      return;
    }
    if (e.key === 'Escape') {
      // Escape always returns to the playbook grid — bypass the intermediate
      // article view. Keep present-mode + slide-preparing on while the SPA
      // navigation runs so the article doesn't flash into view; clean up
      // <html>'s persistent classes in the after-swap handler below.
      const index = section.dataset.index || '/en/playbook';
      if (present) {
        escapingFromPresent = true;
        setSlidePreparing(true);
      }
      navigateSmooth(index);
      return;
    }
    if (!present) return;
    if (e.key === ' ' && t?.closest('summary')) return;

    if (e.key === 'ArrowRight' || e.key === 'PageDown' || e.key === ' ') {
      e.preventDefault();
      if (current < slides.length - 1) {
        showSlide(current + 1);
        syncSlideUrl();
      } else {
        const nx = section?.dataset.next;
        if (nx) navigateSmooth(nx + '?present=1');
      }
      return;
    }
    if (e.key === 'ArrowLeft' || e.key === 'PageUp') {
      e.preventDefault();
      if (current > 0) {
        showSlide(current - 1);
        syncSlideUrl();
      } else {
        const pv = section?.dataset.prev;
        if (pv) navigateSmooth(pv + `?present=1&slide=999`);
      }
      return;
    }
    if (e.key === 't' || e.key === 'T') {
      e.preventDefault();
      toggleToc();
      return;
    }
  }

  const TOC_HIDDEN_KEY = 'akq:present:toc-hidden';
  function applyTocHidden(hidden: boolean) {
    document.body.classList.toggle('akq-toc-hidden', hidden);
    document
      .querySelectorAll<HTMLButtonElement>('[data-toc-toggle]')
      .forEach((btn) => btn.setAttribute('aria-pressed', hidden ? 'true' : 'false'));
  }
  function toggleToc(force?: boolean) {
    const next = typeof force === 'boolean' ? force : !document.body.classList.contains('akq-toc-hidden');
    applyTocHidden(next);
    try {
      localStorage.setItem(TOC_HIDDEN_KEY, next ? '1' : '0');
    } catch {}
  }
  function restoreTocPref() {
    let hidden = false;
    try {
      hidden = localStorage.getItem(TOC_HIDDEN_KEY) === '1';
    } catch {}
    applyTocHidden(hidden);
  }
  function onTocToggleClick(e: MouseEvent) {
    const target = e.target as HTMLElement | null;
    const tocItem = target?.closest<HTMLElement>('.present-toc .toc-item');
    if (tocItem) {
      rememberTocScroll();
      tocItem.blur();
      return;
    }
    const btn = target?.closest<HTMLElement>('[data-toc-toggle]');
    if (!btn) return;
    e.preventDefault();
    toggleToc();
  }

  async function navigateSmooth(href: string) {
    try {
      if (document.body.classList.contains('present-mode')) setSlidePreparing(true);
      const mod = await import('astro:transitions/client');
      await mod.navigate(href);
    } catch {
      window.location.href = href;
    }
  }

  const win = window as Window & typeof globalThis & {
    __akqGlossaryCleanup?: () => void;
  };

  win.__akqGlossaryCleanup?.();

  async function initGlossaryInteractions() {
    if (!document.querySelector('.playbook-detail')) {
      setPresent(false);
      return;
    }

    initPresent();
    if (!document.body.classList.contains('present-mode')) {
      await renderMermaid();
      syncPlaybookVideos();
    }
    syncToc();
  }

  // Toggling DEMO focuses its hidden checkbox, which would otherwise swallow
  // Space/arrow keys. Keyboard activation fires a click whose target is the
  // checkbox itself, so match that too. Hand keyboard control back to the deck.
  function onDemoToggleClick(e: MouseEvent) {
    const hit = (e.target as HTMLElement | null)?.closest?.('.h2-demo, .demo-close, .demo-scrim, .demo-toggle');
    if (!hit) return;
    requestAnimationFrame(() => {
      document.querySelectorAll<HTMLInputElement>('.demo-toggle').forEach((el) => el.blur());
    });
  }

  document.addEventListener('keydown', onKey);
  document.addEventListener('click', onTocToggleClick);
  document.addEventListener('click', onDemoToggleClick);
  function preparePresentNavigation(event?: Event) {
    pausePlaybookVideos();
    rememberTocScroll();
    if (escapingFromPresent) {
      // Escape-to-index: don't carry present-mode onto the destination doc.
      // The current page's classes stay put so the article view doesn't flash;
      // the after-swap handler strips them from <html> once the swap lands.
      return;
    }
    const currentPresent = document.body.classList.contains('present-mode') || document.documentElement.classList.contains('present-mode');
    const targetPresent = new URLSearchParams(location.search).get('present') === '1';
    if (!currentPresent && !targetPresent) return;
    setSlidePreparing(true);

    const astroEvent = event as (Event & {
      newDocument?: Document;
      detail?: { newDocument?: Document };
    });
    const nextDocument = astroEvent.newDocument ?? astroEvent.detail?.newDocument;
    nextDocument?.documentElement.classList.add('present-mode', SLIDE_PREPARING_CLASS);
    nextDocument?.body?.classList.add('present-mode', SLIDE_PREPARING_CLASS);
    if (document.body.classList.contains('akq-toc-hidden')) {
      nextDocument?.body?.classList.add('akq-toc-hidden');
    }
  }
  function clearPresentAfterEscape() {
    if (!escapingFromPresent) return;
    escapingFromPresent = false;
    // <html> persists across View Transitions, so its present-mode +
    // slide-preparing classes must be cleared manually once the index lands.
    document.documentElement.classList.remove('present-mode', SLIDE_PREPARING_CLASS);
    document.body.classList.remove('present-mode', SLIDE_PREPARING_CLASS);
  }
  document.addEventListener('astro:before-preparation', preparePresentNavigation);
  document.addEventListener('astro:before-swap', preparePresentNavigation);
  document.addEventListener('astro:after-swap', clearPresentAfterEscape);
  document.addEventListener('astro:page-load', initGlossaryInteractions);
  const onResizeMarkers = () => {
    if (document.body.classList.contains('present-mode')) placeNewMarkers();
  };
  window.addEventListener('resize', onResizeMarkers);
  window.addEventListener('pagehide', pausePlaybookVideos);
  win.__akqGlossaryCleanup = () => {
    pausePlaybookVideos();
    document.removeEventListener('keydown', onKey);
    document.removeEventListener('click', onTocToggleClick);
    document.removeEventListener('astro:before-preparation', preparePresentNavigation);
    document.removeEventListener('astro:before-swap', preparePresentNavigation);
    document.removeEventListener('astro:after-swap', clearPresentAfterEscape);
    document.removeEventListener('astro:page-load', initGlossaryInteractions);
    window.removeEventListener('resize', onResizeMarkers);
    window.removeEventListener('pagehide', pausePlaybookVideos);
    document.querySelectorAll('.slide-new-marker').forEach((e) => e.remove());
  };

  // ── Mermaid (loaded async, won't block keyboard) ───────────────
  let mermaidRenderPromise: Promise<void> | null = null;

  async function renderMermaid() {
    if (mermaidRenderPromise) return mermaidRenderPromise;

    mermaidRenderPromise = renderMermaidNow().finally(() => {
      mermaidRenderPromise = null;
    });
    return mermaidRenderPromise;
  }

  async function renderMermaidNow() {
    try {
      const blocks = document.querySelectorAll(
        'pre[data-language="mermaid"], pre > code.language-mermaid'
      );
      const existingWraps = document.querySelectorAll('.mermaid-wrap');
      if (blocks.length === 0 && existingWraps.length === 0) return;
      if (blocks.length === 0) {
        applyMermaidSizing();
        return;
      }

      const { default: mermaid } = await import('mermaid');
      await document.fonts.ready;
      mermaid.initialize({
        startOnLoad: false,
        theme: 'dark',
        themeVariables: {
          fontFamily: '"IBM Plex Sans JP", "Noto Sans JP", sans-serif',
          background: '#0b1420',
          primaryColor: '#0b1420',
          primaryTextColor: '#ecf7fb',
          primaryBorderColor: '#5eead4',
          lineColor: '#5eead4',
          secondaryColor: '#04080e',
          secondaryBorderColor: '#93a8ff',
          secondaryTextColor: '#ecf7fb',
          tertiaryColor: '#060b12',
          tertiaryBorderColor: '#86efac',
          tertiaryTextColor: '#bad0de',
          noteBkgColor: '#04080e',
          noteTextColor: '#fcd34d',
          noteBorderColor: '#fcd34d',
          clusterBkg: '#04080e',
          clusterBorder: '#5eead4',
          edgeLabelBackground: '#04080e',
          textColor: '#bad0de',
        },
          securityLevel: 'loose',
      });
      blocks.forEach((el, i) => {
        const pre = el.tagName === 'PRE' ? (el as HTMLElement) : (el.parentElement as HTMLElement | null);
        if (!pre || pre.dataset.mermaidProcessed === '1') return;
        pre.dataset.mermaidProcessed = '1';
        const raw = pre.textContent || '';
        const wrap = document.createElement('div');
        wrap.className = 'mermaid-wrap';
        // Preserve slide-engine classes if pre was tagged
        if (pre.classList.contains('akq-slide-el')) wrap.classList.add('akq-slide-el');
        if (pre.classList.contains('akq-slide-hidden')) wrap.classList.add('akq-slide-hidden');
        if (pre.classList.contains('akq-slide-active')) wrap.classList.add('akq-slide-active');
        wrap.id = `mermaid-${Date.now()}-${i}`;
        wrap.textContent = raw;
        pre.replaceWith(wrap);
      });

      // Mermaid can't render inside display:none slides — temporarily
      // move hidden wraps offscreen, render, then restore.
      const allWraps = Array.from(document.querySelectorAll<HTMLElement>('.mermaid-wrap'));
      const restored: Array<{ el: HTMLElement; orig: string }> = [];
      const restoredHiddenAncestors = new Map<HTMLElement, { orig: string; hadHidden: boolean }>();
      allWraps.forEach((el) => {
        const cs = window.getComputedStyle(el);
        if (cs.display === 'none') {
          restored.push({ el, orig: el.getAttribute('style') || '' });
          el.setAttribute(
            'style',
            (el.getAttribute('style') || '') +
              ';display:block !important;position:absolute !important;left:-99999px !important;top:0 !important;width:1100px !important;'
          );
        }

        let parent = el.parentElement;
        while (parent && !parent.classList.contains('playbook-detail')) {
          if (parent.classList.contains('akq-slide-hidden') && !restoredHiddenAncestors.has(parent)) {
            restoredHiddenAncestors.set(parent, {
              orig: parent.getAttribute('style') || '',
              hadHidden: true,
            });
            parent.classList.remove('akq-slide-hidden');
            parent.setAttribute(
              'style',
              (parent.getAttribute('style') || '') +
                ';display:block !important;position:absolute !important;left:-99999px !important;top:0 !important;width:1100px !important;visibility:hidden !important;'
            );
          }
          parent = parent.parentElement;
        }
      });
      await new Promise((r) => setTimeout(r, 30));
      try { await mermaid.run({ querySelector: '.mermaid-wrap' }); } catch (e) { console.error('[mermaid.run]', e); }
      // Keep mermaid's intrinsic size so vertical diagrams stay readable; CSS handles scrolling.
      applyMermaidSizing();
      restored.forEach(({ el, orig }) => {
        if (orig) el.setAttribute('style', orig); else el.removeAttribute('style');
      });
      restoredHiddenAncestors.forEach(({ orig, hadHidden }, el) => {
        if (orig) el.setAttribute('style', orig); else el.removeAttribute('style');
        if (hadHidden) el.classList.add('akq-slide-hidden');
      });

    } catch (err) {
      console.error('[mermaid]', err);
    }
  }

  function applyMermaidSizing() {
    document.querySelectorAll<SVGSVGElement>('.mermaid-wrap svg').forEach((svg) => {
      svg.removeAttribute('width');
      svg.removeAttribute('height');
      svg.style.maxWidth = 'none';
      svg.style.height = 'auto';
    });
  }

  // Initial kick-off, after every binding above is initialized so present mode
  // and Mermaid set up on the first paint. Running this earlier hit a temporal
  // dead zone on mermaidRenderPromise, making present mode fail once and flash
  // the article view before astro:page-load re-ran it.
  initGlossaryInteractions();
</script>

