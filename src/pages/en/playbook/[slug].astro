  .prose-akq .trio-summary:hover { background: rgba(94, 234, 212, 0.05); }
  .prose-akq .trio-summary:focus-visible { outline: 2px solid #5eead4; outline-offset: -2px; }
  .prose-akq .trio-row[open] { background: rgba(94, 234, 212, 0.05); }
