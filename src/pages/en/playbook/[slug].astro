    border: 1px solid rgba(94, 234, 212, 0.42);
    border-radius: 2px;
  }
  .present-hint:hover .key {
    background: #5eead4;
    color: #04080e;
    border-color: #5eead4;
    text-shadow: none;
  }

  .present-overlay-hint {
    position: fixed;
    top: 20px;
    right: 22px;
    display: none;
    align-items: center;
    gap: 12px;
    padding: 6px 12px;
    font-family: var(--font-mono-hud), var(--font-prose);
