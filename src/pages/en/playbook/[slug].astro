    padding: 0 0.4em 0.45em;
    line-height: 1.3;
  }
  .prose-akq .ch-era::before {
    content: '\25C6';
    color: #5eead4;
    margin-right: 0.4em;
    font-size: 0.7em;
    vertical-align: middle;
    opacity: 0.85;
