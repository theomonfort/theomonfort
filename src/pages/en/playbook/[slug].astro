  /* ── Presentation mode ── */
  body.present-mode { background: #060b12 !important; overflow: hidden; }
  body.present-mode header.sticky,
  body.present-mode nav,
  body.present-mode footer,
  body.present-mode .bgm-player,
  body.present-mode .bgm-bug-report,
