  /* Panels share one grid cell so the area keeps the tallest panel's height and the slide does not jump between tabs. */
  .prose-akq .trio-panels { display: grid; grid-template-columns: minmax(0, 1fr); }
  .prose-akq .trio-panel { grid-area: 1 / 1; align-self: start; min-width: 0; visibility: hidden; }
  /* inherit (not visible) so present mode's slide-preparing visibility:hidden still applies. */
  .prose-akq .trio-radio:nth-of-type(1):checked ~ .trio-panels > .trio-panel:nth-child(1),
  .prose-akq .trio-radio:nth-of-type(2):checked ~ .trio-panels > .trio-panel:nth-child(2),
  .prose-akq .trio-radio:nth-of-type(3):checked ~ .trio-panels > .trio-panel:nth-child(3) { visibility: inherit; z-index: 1; }
  .prose-akq .trio-row {
