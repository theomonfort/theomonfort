  /* ── Presentation-mode toggle button (Phosphor HUD control pill) ── */
  .present-hint {
    position: fixed;
    right: 16px;
    bottom: 64px;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 8px 13px;
    font-family: var(--font-mono-hud), var(--font-prose);
    font-size: 0.82rem;
    font-weight: 600;
    letter-spacing: 0.03em;
    background: var(--c-bg-hud);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    color: #5eead4;
    border: 1px solid rgba(94, 234, 212, 0.35);
    border-radius: var(--radius-ui);
    cursor: pointer;
    z-index: 60;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.35);
    transition: transform 0.15s ease, color 0.15s ease, border-color 0.15s ease, background 0.15s ease;
