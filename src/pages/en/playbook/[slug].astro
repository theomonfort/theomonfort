  }
  body.present-mode.slide-cover .playbook-detail[data-category="plan"] {
    background-image:
      linear-gradient(180deg, rgba(6, 11, 18, 0.55) 0%, rgba(6, 11, 18, 0.68) 55%, rgba(6, 11, 18, 0.84) 100%),
