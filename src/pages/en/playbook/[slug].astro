  .prose-akq .trio-radio:nth-of-type(1):checked ~ .trio-bar > .trio-tab:nth-child(1),
  .prose-akq .trio-radio:nth-of-type(2):checked ~ .trio-bar > .trio-tab:nth-child(2),
  .prose-akq .trio-radio:nth-of-type(3):checked ~ .trio-bar > .trio-tab:nth-child(3) {
    border-color: #5eead4;
    color: #5eead4;
    background: rgba(94, 234, 212, 0.1);
    box-shadow: 0 4px 16px rgba(94, 234, 212, 0.14);
