  /* ── Progressive Disclosure flow (Agent Skills) ── */
  .prose-akq .pd-flow {
    display: flex;
    align-items: stretch;
    gap: 0.5rem;
    margin: 2em 0;
    flex-wrap: wrap;
    justify-content: center;
  }
  .prose-akq .pd-stage {
    flex: 1 1 220px;
    min-width: 200px;
    position: relative;
    padding: 1.4em 1em 1.2em;
    background: var(--c-bg-elevated);
    border: 1px solid color-mix(in srgb, var(--pd-color, #5eead4) 42%, transparent);
    border-top: 2px solid var(--pd-color, #5eead4);
    border-radius: var(--radius-card);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.32);
    text-align: center;
    color: var(--c-fg-strong);
    font-family: var(--font-prose);
  }
  .prose-akq .pd-stage[data-tone="green"]   { --pd-color: #86efac; --pd-bg: rgba(134, 239, 172, 0.06); }
  .prose-akq .pd-stage[data-tone="amber"]   { --pd-color: #fcd34d; --pd-bg: rgba(252, 211, 77, 0.06); }
  .prose-akq .pd-stage[data-tone="magenta"] { --pd-color: #93a8ff; --pd-bg: rgba(147, 168, 255, 0.06); }
  .prose-akq .pd-stage::before {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--pd-bg);
    border-radius: inherit;
    pointer-events: none;
    z-index: 0;
  }
  .prose-akq .pd-stage > * { position: relative; z-index: 1; }
  .prose-akq .pd-num {
    position: absolute;
    top: -14px;
    left: 50%;
    transform: translateX(-50%);
    width: 28px;
    height: 28px;
    line-height: 26px;
    background: var(--pd-color);
    color: #04080e;
    font-family: var(--font-mono-hud);
