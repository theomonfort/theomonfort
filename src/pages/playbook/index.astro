---
import Layout from '../../components/layout/Layout.astro';
import MenuArrow from '../../components/retro/MenuArrow.astro';
import PlaybookExplorer from '../../components/interactive/PlaybookExplorer.astro';
import { accentClasses, accentColorValues } from '../../lib/theme';
import { categories, localizedCategory } from '../../lib/playbook-categories';
import { localizedPath, siteCopy } from '../../lib/i18n';
import { getPlaybookEntries, playbookEntryTitle } from '../../lib/playbook';
import { isNewPlaybookEntry } from '../../lib/playbook-meta';

const locale = 'ja';
const t = siteCopy[locale];
const entries = await getPlaybookEntries(locale);

const grouped = categories.map((cat) => ({
  ...localizedCategory(cat, locale),
  items: entries.filter((e) => e.entry.data.category === cat.id),
}));

const BASE = import.meta.env.BASE_URL.replace(/\/$/, '');
const CATEGORIES_WITH_PLANETS = new Set<string>(['plan', 'operate', 'review', 'develop', 'secure', 'introduction', 'administration']);
---

<Layout locale={locale} currentPath="/playbook" title={t.playbook.title}>
  <section class="max-w-5xl mx-auto px-4 py-12 relative playbook-cosmos">
    <header class="mb-10 relative z-10 playbook-hero">
      <div class="playbook-title-row">
        <h1 class="playbook-hero-title">{t.playbook.heading}</h1>
        <PlaybookExplorer locale={locale} entries={entries} />
      </div>
      <p class="playbook-hero-sub">{t.playbook.subtitle}</p>
      <p class="playbook-hero-intro">
        {t.playbook.intro}{' '}
        なお、これは個人的な学習リソースで情報が古くなっている可能性があるため、正確な情報は必ず <a href="https://docs.github.com/ja/copilot" target="_blank" rel="noopener noreferrer" class="playbook-hero-link">GitHub 公式ドキュメント ↗</a> をご確認ください。
      </p>

      <a class="retro-link inline-block mt-3 text-sm" href={localizedPath(locale, '/archive')}>{t.archive.link} ↗</a>

      <nav data-category-nav class="mt-8 flex flex-wrap md:flex-nowrap items-center gap-2 md:gap-2.5">
        {grouped.filter((g) => g.items.length > 0 && g.id !== 'introduction' && g.id !== 'administration').map((g, i, arr) => {
          const tone = accentColorValues[g.color];
          return (
            <>
              <a
                href={`#cat-${g.id}`}
                style={`--tone:${tone}`}
                class="playbook-phase-tab whitespace-nowrap transition"
              >
                {g.icon} {g.labelEn}
              </a>
              {i < arr.length - 1 && (
                <span class="playbook-phase-sep" aria-hidden="true">→</span>
              )}
            </>
          );
        })}
      </nav>
    </header>

    {grouped.map((g) => {
      if (g.items.length === 0) return null;
      const c = accentClasses[g.color];
      const tone = accentColorValues[g.color];
      return (
        <section id={`cat-${g.id}`} style={`--tone:${tone}`} class="mb-14 scroll-mt-24 relative category-section">
          <header class="category-header relative z-10">
            <div class="flex items-center gap-3 flex-wrap">
              <span class="text-xl leading-none">{g.icon}</span>
              <h2 class="category-title">{g.labelEn}</h2>
              {g.labelJa !== g.labelEn && <span class="category-label-sub">{g.labelJa}</span>}
              <span class="category-count">
                {g.items.length} {t.playbook.itemCount}
              </span>
            </div>
            {(g.avatar || g.localizedDescription) && (
              <div class="mt-3.5 flex items-start gap-3.5">
                {g.avatar && (
                  <img
                    src={g.avatar}
                    alt={g.actorLabel}
                    class="category-avatar shrink-0"
                  />
                )}
                <div class="flex-1 min-w-0">
                  {g.actorLabel && (
                    <p class="category-actor">👤 {g.actorLabel}</p>
                  )}
                  {g.localizedDescription && (
                    <p class="category-desc" set:html={g.localizedDescription}>
                    </p>
                  )}
                </div>
              </div>
            )}
          </header>

          <ul class="grid grid-cols-1 md:grid-cols-2 gap-4 auto-rows-fr relative z-10">
            {g.items.map((item) => {
              const e = item.entry;
              const ec = c;
              const cardTitle = e.data.titleEn || playbookEntryTitle(item);
              const cardSubtitle = e.data.title !== cardTitle ? e.data.title : undefined;
              const isNew = isNewPlaybookEntry(item.slug);
              return (
                <li class="h-full" data-catalogue-entry={item.slug}>
                  <a
                    href={localizedPath(locale, `/playbook/${item.slug}`)}
                    data-playbook-tile
                    style={`--tone:${tone}`}
                    class="playbook-card flex h-full group"
                  >
                    <div class="flex items-start gap-3.5 w-full">
                      {e.data.icon && /\.(svg|png|jpg|jpeg|webp|gif)$/i.test(e.data.icon)
                        ? <img src={e.data.icon} alt="" class="h-8 w-8 object-contain shrink-0 mt-0.5" />
                        : <span class="text-2xl leading-none shrink-0 mt-0.5">{e.data.icon}</span>}
                      <div class="flex-1 min-w-0">
                        <div class="flex items-center gap-2 mb-2">
                          <span class="playbook-card-no">NO.{String(e.data.order).padStart(2, '0')}</span>
                          {isNew && <span class="playbook-card-new">{t.playbook.newBadge}</span>}
                        </div>
                        <h3 class="playbook-card-title">{cardTitle}</h3>
                        {cardSubtitle && <p class="playbook-card-subtitle">{cardSubtitle}</p>}
                        <p class="playbook-card-summary line-clamp-3">
                          {e.data.summary}
                        </p>
                        <div class="playbook-card-more">
                          <MenuArrow color={ec.text} /> {t.playbook.readMore}
                        </div>
                      </div>
                    </div>
                  </a>
                </li>
              );
            })}
          </ul>
          {CATEGORIES_WITH_PLANETS.has(g.id) && (
            <div
              class="category-planet"
              data-planet={g.id}
              data-parallax
              data-parallax-speed="20"
              aria-hidden="true"
            >
              <img
                src={`${BASE}/planet-${g.id}.webp`}
                alt=""
                loading="lazy"
                decoding="async"
              />
            </div>
          )}
          {g.id === 'plan' && (
            <div
              class="category-decor"
              data-decor="asteroids-plan"
              data-parallax
              data-parallax-speed="35"
              aria-hidden="true"
            >
              <img
                src={`${BASE}/asteroids-plan.webp`}
                alt=""
                loading="lazy"
                decoding="async"
              />
            </div>
          )}
        </section>
      );
    })}
  </section>
</Layout>

<script>
  // On desktop (≥768px) — wide enough for the present-mode TOC sidebar — open
  // each playbook tile directly in presentation mode. Mobile keeps the plain
  // article view because present mode has no on-screen slide navigation.
  const TOC_HIDDEN_KEY = 'akq:present:toc-hidden';
  function upgradePlaybookTiles() {
    if (!window.matchMedia('(min-width: 768px)').matches) return;
    document.querySelectorAll<HTMLAnchorElement>('a[data-playbook-tile]').forEach((a) => {
      const href = a.getAttribute('href');
      if (href && !/[?&]present=1\b/.test(href)) {
        a.setAttribute('href', href + (href.includes('?') ? '&' : '?') + 'present=1');
      }
      if (a.dataset.tileClickBound === '1') return;
      a.dataset.tileClickBound = '1';
      // Clear any sticky "TOC hidden" preference so entering a playbook
      // from the index always starts with the TOC visible. Subsequent
      // in-mode navigation (arrow keys between slides) still respects the
      // user's toggle.
      a.addEventListener('click', () => {
        try { localStorage.removeItem(TOC_HIDDEN_KEY); } catch {}
      });
    });
  }
  upgradePlaybookTiles();
  document.addEventListener('astro:page-load', upgradePlaybookTiles);
</script>

<script is:inline>
  (function () {
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (reduceMotion) return;
    let items = [];
    let raf = 0;
    function update() {
      raf = 0;
      const vh = window.innerHeight;
      const mid = vh / 2;
      for (const el of items) {
        const r = el.getBoundingClientRect();
        if (r.bottom < -200 || r.top > vh + 200) continue;
        const center = r.top + r.height / 2;
        const offset = (center - mid) / vh;
        const speed = parseFloat(el.dataset.parallaxSpeed || '30');
        const ty = -offset * speed;
        el.style.transform = 'translate3d(0,' + ty.toFixed(2) + 'px,0)';
      }
    }
    function schedule() {
      if (!raf) raf = requestAnimationFrame(update);
    }
    function refresh() {
      items = Array.prototype.slice.call(document.querySelectorAll('[data-parallax]'));
      schedule();
    }
    if (!window.__pbParallaxInit) {
      window.__pbParallaxInit = true;
      window.addEventListener('scroll', schedule, { passive: true });
      window.addEventListener('resize', schedule, { passive: true });
    }
    refresh();
    document.addEventListener('astro:page-load', refresh);
  })();
</script>

<style>
  .playbook-cosmos {
    overflow: visible;
    padding-top: 2.75rem;
    padding-bottom: 4rem;
  }

  .playbook-hero-title {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(2rem, 3.2vw, 2.55rem);
    line-height: 1.2;
    letter-spacing: 0.02em;
    color: var(--c-fg-strong);
    margin: 0;
  }

  .playbook-hero-sub {
    font-family: var(--font-mono-hud), var(--font-prose);
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--c-neon-cyan);
    margin: 0.25rem 0 0;
  }

  .playbook-hero-intro {
    font-family: var(--font-prose);
    font-size: 0.95rem;
    line-height: 1.8;
    color: var(--c-fg-body);
    margin-top: 0.9rem;
    max-width: 44rem;
  }

  .playbook-hero-link {
    color: var(--c-link);
    text-decoration: underline;
    text-underline-offset: 3px;
    transition: color 0.15s ease;
  }
  .playbook-hero-link:hover {
    color: var(--c-link-hover);
  }

  .playbook-phase-tab {
    font-family: var(--font-mono-hud), var(--font-prose);
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.03em;
    padding: 0.48rem 0.9rem;
    border: 1px solid color-mix(in srgb, var(--tone, var(--c-neon-cyan)) 32%, transparent);
    border-radius: var(--radius-pill);
    background: rgb(var(--rgb-deep-purple) / 0.85);
    box-shadow: inset 0 1px 0 color-mix(in srgb, var(--tone, var(--c-neon-cyan)) 35%, transparent);
    color: var(--c-fg-strong);
    text-decoration: none;
  }
  .playbook-phase-tab:hover {
    transform: translateY(-1px);
    border-color: color-mix(in srgb, var(--tone, var(--c-neon-cyan)) 70%, transparent);
    background: color-mix(in srgb, var(--tone, var(--c-neon-cyan)) 16%, var(--c-bg-elevated));
    color: var(--tone, var(--c-neon-cyan));
  }

  .playbook-phase-sep {
    font-family: var(--font-mono-hud);
    font-size: 0.95rem;
    color: var(--c-fg-muted);
    opacity: 0.55;
    line-height: 1;
  }

  .category-header {
    padding-bottom: 0.95rem;
    margin-bottom: 1.35rem;
    border-bottom: 1px solid color-mix(in srgb, var(--tone, var(--c-neon-cyan)) 24%, var(--c-border));
    background-image: linear-gradient(
      90deg,
      var(--tone, var(--c-neon-cyan)) 0%,
      color-mix(in srgb, var(--tone, var(--c-neon-cyan)) 35%, transparent) 42%,
      transparent 100%
    );
    background-size: 100% 2px;
    background-position: bottom left;
    background-repeat: no-repeat;
  }

  .category-title {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.25rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--tone, var(--c-neon-cyan));
    margin: 0;
  }

  .category-label-sub {
    font-family: var(--font-prose);
    font-size: 0.92rem;
    color: var(--c-fg-muted);
  }

  .category-count {
    margin-left: auto;
    font-family: var(--font-mono-hud), var(--font-prose);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    color: var(--tone, var(--c-neon-cyan));
    background: color-mix(in srgb, var(--tone, var(--c-neon-cyan)) 10%, transparent);
    border: 1px solid color-mix(in srgb, var(--tone, var(--c-neon-cyan)) 25%, transparent);
    padding: 0.18rem 0.55rem;
    border-radius: var(--radius-pill);
  }

  .category-avatar {
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 9999px;
    object-fit: cover;
    border: 1.5px solid color-mix(in srgb, var(--tone, var(--c-neon-cyan)) 45%, var(--c-border));
  }

  .category-actor {
    font-family: var(--font-prose);
    font-weight: 600;
    font-size: 0.82rem;
    color: var(--tone, var(--c-neon-cyan));
    margin: 0 0 0.25rem;
  }

  .category-desc {
    font-family: var(--font-prose);
    font-size: 0.9rem;
    line-height: 1.7;
    color: var(--c-fg-body);
    margin: 0;
  }
  .category-desc :global(strong) {
    color: var(--c-fg-strong);
    font-weight: 600;
    background: color-mix(in srgb, var(--tone, var(--c-neon-cyan)) 12%, transparent);
    padding: 0.05em 0.35em;
    border-radius: 3px;
  }

  .playbook-card {
    background-color: var(--c-bg-elevated);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border: 1px solid color-mix(in srgb, var(--tone, var(--c-neon-cyan)) 22%, transparent);
    border-radius: var(--radius-card);
    padding: 1.35rem 1.45rem;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.32);
    background-image: linear-gradient(
      90deg,
      var(--tone, var(--c-neon-cyan)) 0%,
      color-mix(in srgb, var(--tone, var(--c-neon-cyan)) 30%, transparent) 55%,
      transparent 100%
    );
    background-size: 100% 2px;
    background-position: top left;
    background-repeat: no-repeat;
    text-decoration: none;
    transition: transform 0.2s ease, background-color 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
  }
  .playbook-card:hover {
    background-color: var(--c-bg-elevated-hover);
    border-color: color-mix(in srgb, var(--tone, var(--c-neon-cyan)) 52%, var(--c-border));
    transform: translateY(-2px);
    box-shadow: 0 12px 28px rgba(0, 0, 0, 0.42);
  }

  .playbook-card-no {
    display: inline-block;
    font-family: var(--font-mono-hud);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.08em;
    line-height: 1.2;
    color: var(--tone, var(--c-neon-cyan));
    background: color-mix(in srgb, var(--tone, var(--c-neon-cyan)) 11%, transparent);
    border: 1px solid color-mix(in srgb, var(--tone, var(--c-neon-cyan)) 26%, transparent);
    padding: 0.16rem 0.45rem;
    border-radius: 2px;
  }

  .playbook-card-new {
    display: inline-block;
    font-family: var(--font-mono-hud);
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.06em;
    line-height: 1.2;
    text-transform: uppercase;
    color: var(--c-crt-amber);
    background: rgb(var(--rgb-crt-amber) / 0.14);
    border: 1px solid rgb(var(--rgb-crt-amber) / 0.32);
    padding: 0.16rem 0.42rem;
    border-radius: 2px;
  }
  .playbook-card-new::before { content: '['; opacity: 0.72; margin-right: 1px; }
  .playbook-card-new::after  { content: ']'; opacity: 0.72; margin-left: 1px; }

  .playbook-card-title {
    font-family: var(--font-prose);
    font-weight: 700;
    font-size: 1.2rem;
    line-height: 1.35;
    color: var(--c-fg-strong);
    margin: 0 0 0.35rem;
    transition: color 0.15s ease;
  }
  .playbook-card:hover .playbook-card-title {
    color: var(--tone, var(--c-neon-cyan));
  }

  .playbook-card-subtitle {
    font-family: var(--font-prose);
    font-size: 0.8rem;
    color: var(--c-fg-muted);
    margin: 0 0 0.45rem;
  }

  .playbook-card-summary {
    font-family: var(--font-prose);
    font-size: 0.9rem;
    line-height: 1.72;
    color: var(--c-fg-body);
    margin: 0;
  }

  .playbook-card-more {
    margin-top: 0.75rem;
    font-family: var(--font-mono-hud), var(--font-prose);
    font-size: 0.8rem;
    font-weight: 500;
    color: var(--tone, var(--c-neon-cyan));
    opacity: 0;
    transition: opacity 0.18s ease;
  }
  .playbook-card:hover .playbook-card-more {
    opacity: 1;
  }

  .category-planet {
    position: absolute;
    bottom: 0;
    right: 0;
    width: calc(50% - 0.5rem);
    display: flex;
    justify-content: center;
    align-items: flex-end;
    pointer-events: none;
    z-index: 0;
    will-change: transform;
    opacity: 0.68;
    filter: hue-rotate(-8deg) saturate(0.85);
  }
  .category-planet img {
    width: auto;
    height: auto;
    max-width: 100%;
    max-height: 340px;
    display: block;
    object-fit: contain;
    animation: planet-float 7.5s ease-in-out infinite;
  }
  @keyframes planet-float {
    0%, 100% { transform: translateY(0) rotate(0deg); }
    50%      { transform: translateY(-10px) rotate(0.6deg); }
  }

  /* (planet-cell removed — planet is now position:absolute on .category-planet itself) */

  .category-planet[data-planet='introduction'] {
    bottom: -3.5rem;
  }
  .category-planet[data-planet='introduction'] img {
    max-height: 380px;
  }

  .category-planet[data-planet='plan'] {
    right: -15rem;
    left: auto;
    bottom: -4rem;
    width: 38rem;
    max-width: 75%;
    align-items: flex-end;
    z-index: 0;
  }
  .category-planet[data-planet='plan'] img {
    max-height: 520px;
  }

  .category-planet[data-planet='develop'] {
    left: -16rem;
    right: auto;
    top: 12rem;
    bottom: auto;
    width: 38rem;
    max-width: 75%;
    align-items: flex-start;
  }
  .category-planet[data-planet='develop'] img {
    max-height: 620px;
  }

  .category-planet[data-planet='review'] {
    bottom: 5rem;
    right: -3rem;
    z-index: 0;
  }
  .category-planet[data-planet='review'] img {
    max-height: 380px;
  }

  .category-planet[data-planet='secure'] {
    left: -14rem;
    right: auto;
    bottom: 6rem;
    top: auto;
    width: 38rem;
    max-width: 75%;
    align-items: flex-end;
  }
  .category-planet[data-planet='secure'] img {
    max-height: 560px;
  }

  .category-planet[data-planet='operate'] {
    top: -13rem;
    bottom: auto;
    right: -14rem;
    left: auto;
    width: 44rem;
    max-width: 85%;
    align-items: flex-start;
    z-index: 0;
  }
  .category-planet[data-planet='operate'] img {
    max-height: 760px;
  }

  .category-planet[data-planet='administration'] {
    right: -3rem;
    bottom: -15rem;
    width: calc(50% + 1rem);
    z-index: 20;
  }
  .category-planet[data-planet='administration'] img {
    max-height: 340px;
  }

  /* Decorative asteroid clusters (background, behind cards) */
  .category-decor {
    position: absolute;
    pointer-events: none;
    z-index: 0;
    will-change: transform;
    display: flex;
    justify-content: center;
    align-items: center;
  }
  .category-decor img {
    width: 100%;
    height: auto;
    object-fit: contain;
    opacity: 0.55;
    filter: drop-shadow(0 6px 14px rgba(0, 0, 0, 0.55));
    animation: planet-float 9s ease-in-out infinite;
  }
  .category-decor[data-decor='asteroids-plan'] {
    left: -7rem;
    top: 12rem;
    width: 16rem;
  }

  /* Per-category glow (color matches the section accent) */
  .category-planet[data-planet='plan']         img { filter: drop-shadow(0 12px 22px rgba(0,0,0,0.55)) drop-shadow(0 0 28px rgb(var(--rgb-gb-green) / 0.28)); }
  .category-planet[data-planet='introduction'] img { filter: drop-shadow(0 12px 22px rgba(0,0,0,0.55)) drop-shadow(0 0 28px rgb(var(--rgb-neon-cyan) / 0.28)); }
  .category-planet[data-planet='develop']      img { filter: drop-shadow(0 12px 22px rgba(0,0,0,0.55)) drop-shadow(0 0 28px rgb(var(--rgb-neon-magenta) / 0.28)); }
  .category-planet[data-planet='review']       img { filter: drop-shadow(0 12px 22px rgba(0,0,0,0.55)) drop-shadow(0 0 28px rgb(var(--rgb-crt-amber) / 0.28)); }
  .category-planet[data-planet='secure']       img { filter: drop-shadow(0 12px 22px rgba(0,0,0,0.55)) drop-shadow(0 0 28px rgb(var(--rgb-neon-cyan) / 0.28)); }
  .category-planet[data-planet='operate']      img { filter: drop-shadow(0 12px 22px rgba(0,0,0,0.55)) drop-shadow(0 0 28px rgb(var(--rgb-gb-green) / 0.28)); }
  .category-planet[data-planet='administration'] img { filter: drop-shadow(0 12px 22px rgba(0,0,0,0.55)) drop-shadow(0 0 28px rgb(var(--rgb-neon-magenta) / 0.28)); }

  /* ═══════════ Retro JRPG theme overrides ═══════════ */
  :global(html[data-theme='retro']) .playbook-cosmos {
    padding-top: 3rem;
    padding-bottom: 3rem;
  }

  :global(html[data-theme='retro']) .playbook-hero-title {
    font-family: 'Press Start 2P', 'DotGothic16', monospace;
    font-weight: 400;
    font-size: clamp(1.5rem, 3vw, 2.25rem);
    line-height: 1.35;
    letter-spacing: 0.04em;
    color: var(--c-neon-magenta);
  }

  :global(html[data-theme='retro']) .playbook-hero-sub {
    font-family: var(--font-prose);
    font-size: 1.125rem;
    font-weight: 400;
    letter-spacing: 0.02em;
